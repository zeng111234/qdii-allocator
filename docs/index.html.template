            <button onclick="sendAiMessage()" id="ai-send-btn" style="padding:10px 16px;background:var(--primary);color:white;border:none;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;white-space:nowrap;flex-shrink:0">发送</button>
