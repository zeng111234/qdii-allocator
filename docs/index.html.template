        '<div style="flex:1;text-align:center;padding:10px;background:var(--bg);border-radius:8px">' +
        '<div style="font-size:11px;color:var(--text3)">实际收益率</div>' +
        '<div style="font-size:18px;font-weight:700;color:var(--' + (realRate >= 0 ? 'danger' : 'success') + ')">' + (realRate >= 0 ? '+' : '') + realRate + '%</div>' +
