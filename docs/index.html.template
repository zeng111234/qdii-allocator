        html2 += '<div style="display:flex;align-items:flex-start;gap:6px;padding:5px 0;border-bottom:1px solid #f1f5f9;font-size:12px">';
        html2 += '<span style="flex-shrink:0">' + scoreEmoji + '</span>';
