          navArr = null;
        }

        if (!navArr || navArr.length < 10) {
          fundResults.push({
            code: fund.code, name: fund.name, type: fund.type,
            rawScores: {}, composite: null, insufficient: true,
            suspended: fund.status === 'suspended'
          });
          return;
        }

        var rawScores = FactorEngine.computeAll(navArr, fund);
        fundResults.push({
          code: fund.code, name: fund.name, type: fund.type,
          rawScores: rawScores, composite: null, insufficient: false,
          suspended: fund.status === 'suspended'
        });
      });

      // Phase 2: Cross-sectional normalization per factor
      var factorIds = FactorEngine.list();
      var normalizedScores = {}; // {factorId: [{idx, score}, ...]}
      // 稀缺度因子跳过归一化，直接使用原始分数（35-65范围已经是有意义的绝对值）
      var skipNormalize = {'scarce_limit': true};

      factorIds.forEach(function(fid) {
        var items = [];
        fundResults.forEach(function(r, idx) {
          if (!r.insufficient && r.rawScores[fid] !== null && r.rawScores[fid] !== undefined) {
            items.push({ idx: idx, score: r.rawScores[fid] });
          }
        });
        if (skipNormalize[fid]) {
          // 直接使用原始分数，不做归一化
          items.forEach(function(s) { s.normalized = s.score; });
        } else {
          FactorEngine.normalize(items);
        }
        normalizedScores[fid] = items;
      });

      // Phase 3: Assign normalized scores back
      factorIds.forEach(function(fid) {
        normalizedScores[fid].forEach(function(item) {
          if (!fundResults[item.idx].factorScores) fundResults[item.idx].factorScores = {};
          fundResults[item.idx].factorScores[fid] = item.normalized;
        });
      });

      // Phase 4: Compute composite scores
      var weights = FactorEngine.getDefaultWeights();
      fundResults.forEach(function(r) {
        if (r.insufficient || !r.factorScores) {
          r.composite = null;
        } else {
          r.composite = FactorEngine.weightedSum(r.factorScores, weights);
        }
      });

      // Phase 5: Sort by composite (descending), nulls at bottom
      fundResults.sort(function(a, b) {
        if (a.composite === null && b.composite === null) return 0;
        if (a.composite === null) return 1;
        if (b.composite === null) return -1;
        return b.composite - a.composite;
      });

      // Phase 6: IndexGroup dedup — mark duplicates, keep only highest per group for recommendations
      // 如果高分基金不可买（暂停/限购0），不应该挡住低分基金
      function getIG(fund) {
        if (fund.indexGroup) return fund.indexGroup;
        var t = fund.type || '';
        if (t.indexOf('纳指100') >= 0 || t.indexOf('纳斯达克100') >= 0) return 'NDX100';
        if (t.indexOf('标普500') >= 0) return 'SPX500';
        if (t.indexOf('全球科技') >= 0) return 'GLOBAL_TECH';
        if (t.indexOf('新能源车') >= 0) return 'EV';
        return fund.code; // unique per fund
      }
      function isBuyable(fund) {
        if (!fund) return false;
        if (fund.status === 'suspended') return false;
        if (fund.dailyLimit !== undefined && fund.dailyLimit <= 0) return false;
        return true;
      }
      var usedIG = {};
      fundResults.forEach(function(r) {
        if (r.composite === null) { r.deduped = false; return; }
        var fund = fundsData.funds.find(function(f) { return f.code === r.code; });
        var ig = fund ? getIG(fund) : r.code;
        var buyable = isBuyable(fund);
        
        if (usedIG[ig]) {
          // 同组已有基金
          if (!buyable) {
            // 当前基金不可买 → 不挡路，自己也不被挡
            r.deduped = false;
          } else {
            // 当前基金可买
            var blocker = usedIG[ig];
            if (!blocker.buyable) {
              // 挡路的是不可买的 → 替换它，当前基金不被挡
              usedIG[ig] = { name: r.name, fund: fund, buyable: true };
              r.deduped = false;
            } else {
              // 挡路的是可买的 → 被挡
              r.deduped = true;
              r.dedupedBy = blocker.name;
            }
          }
        } else {
          // 同组第一个基金
          r.deduped = false;
          usedIG[ig] = { name: r.name, fund: fund, buyable: buyable };
        }
      });

      return fundResults;
    }

    /**
     * Build the ranking HTML for display.
     * @param {Array} results - sorted fund results
     * @returns {string} HTML string
     */
    function buildRankingHTML(results) {
      var html = '';
      var validResults = results.filter(function(r) { return r.composite !== null; });
      var avgScore = 0, maxScore = 0, minScore = 100;
      validResults.forEach(function(r) {
        avgScore += r.composite;
        if (r.composite > maxScore) maxScore = r.composite;
        if (r.composite < minScore) minScore = r.composite;
      });
      avgScore = validResults.length > 0 ? Math.round(avgScore / validResults.length * 100) / 100 : 0;

      // Summary cards
      html += '<div class="ranking-summary">';
      html += '<div class="ranking-summary-item"><div class="label">评分基金数</div>';
      html += '<div class="value">' + validResults.length + '/' + results.length + '</div></div>';
      html += '<div class="ranking-summary-item"><div class="label">平均综合评分</div>';
      html += '<div class="value">' + avgScore.toFixed(1) + '</div></div>';
      html += '<div class="ranking-summary-item"><div class="label">最高/最低</div>';
      html += '<div class="value">' + (validResults.length > 0 ? maxScore.toFixed(1) + '/' + minScore.toFixed(1) : '--') + '</div></div>';
      html += '</div>';

      // Sorting controls
      html += '<div class="ranking-controls">';
      html += '<span style="font-size:12px;color:var(--text2);font-weight:500">排序：</span>';
      var sortOptions = [
        { id: 'composite', label: '综合评分' },
        { id: 'momentum', label: '动量' },
        { id: 'volatility', label: '波动率' },
        { id: 'trend', label: '趋势' },
        { id: 'drawdown', label: '回撤' },
        { id: 'quality', label: '质量' },
        { id: 'qdii_special', label: 'QDII特色' },
        { id: 'sentiment', label: '情绪' },
        { id: 'diversity', label: '分散' }
      ];
      sortOptions.forEach(function(opt) {
        var isActive = _rankingState.sortBy === opt.id;
        html += '<span class="sort-btn' + (isActive ? ' active' : '') + '" ';
        html += 'onclick="sortByTheme(\'' + opt.id + '\')">' + opt.label + '</span>';
      });
      html += '</div>';

      // Sort results by selected theme if not composite
      var displayResults = results.slice(); // copy
      if (_rankingState.sortBy !== 'composite') {
        var theme = _rankingState.sortBy;
        displayResults.sort(function(a, b) {
          var sa = getThemeScore(a, theme);
          var sb = getThemeScore(b, theme);
          if (sa === null && sb === null) return 0;
          if (sa === null) return 1;
          if (sb === null) return -1;
          return sb - sa;
        });
      }

      // Fund ranking rows
      displayResults.forEach(function(r, rankIdx) {
        var rankNum = rankIdx + 1;
        var rankClass = rankNum <= 3 ? 'top' + rankNum : 'normal';
        var score = r.composite;
        var badgeClass = score !== null ? scoreBadgeClass(score) : 'medium';

        var rowStyle = r.deduped ? ' style="opacity:0.5;filter:grayscale(60%)"' : '';
        var dedupNote = r.deduped ? ' <span style="font-size:10px;color:#999;background:#f0f0f0;padding:1px 4px;border-radius:3px">同指数已推荐</span>' : '';
        var suspendedNote = r.suspended ? ' <span style="font-size:10px;color:#fff;background:#ef4444;padding:1px 4px;border-radius:3px">暂停申购</span>' : '';
        if (r.suspended) rowStyle = ' style="opacity:0.5;filter:grayscale(60%)"';
        html += '<div class="ranking-row" onclick="toggleFactorBars(' + rankIdx + ')"' + rowStyle + '>';
        html += '<div class="ranking-header">';
        html += '<div class="ranking-left">';
        html += '<span class="ranking-rank ' + rankClass + '">' + rankNum + '</span>';
        html += '<span class="ranking-name" title="' + r.name + '">' + r.name + '</span>' + dedupNote + suspendedNote;
        html += '<span class="ranking-code">' + r.code + '</span>';
        if (r.type) html += '<span class="ranking-type">' + r.type + '</span>';
        html += '</div>';

        if (score !== null) {
          html += '<div class="score-badge ' + badgeClass + '">';
          html += '<span>' + score.toFixed(1) + '</span>';
          html += '<span class="score-label">综合</span>';
          html += '</div>';
        } else {
          html += '<div class="score-badge medium"><span>--</span><span class="score-label">暂无</span></div>';
        }
        html += '</div>';

        // Factor detail bars (hidden by default)
        html += '<div class="factor-bars" id="factor-bars-' + rankIdx + '">';
        if (r.reason) {
          // 从服务端 reason 解析因子得分，显示条形图
          var factors = parseFactorsFromReason(r.reason, r.composite);
          factors.forEach(function(f) {
            var barWidth = Math.max(2, Math.min(100, f.pct));
            var barColor = f.val >= 0 ? '#22c55e' : '#ef4444';
            html += '<div class="factor-bar-row">';
            html += '<span class="factor-bar-label">' + f.name + '</span>';
            html += '<div class="factor-bar-track"><div class="factor-bar-fill" style="width:' + barWidth + '%;background:' + barColor + '"></div></div>';
            html += '<span class="factor-bar-value" style="color:' + barColor + '">' + (f.val >= 0 ? '+' : '') + f.val.toFixed(1) + '</span>';
            html += '</div>';
          });
        } else if (r.factorScores && Object.keys(r.factorScores).length > 0) {
          var factorIds = FactorEngine.list();
          factorIds.forEach(function(fid) {
            var factor = FactorEngine.get(fid);
            var val = r.factorScores[fid];
            if (val === undefined || val === null) return;
            var barWidth = Math.max(2, Math.min(100, val));
            var barColor = factorBarColor(val);
            html += '<div class="factor-bar-row">';
            html += '<span class="factor-bar-label">' + factor.name + '</span>';
            html += '<div class="factor-bar-track"><div class="factor-bar-fill" style="width:' + barWidth + '%;background:' + barColor + '"></div></div>';
            html += '<span class="factor-bar-value" style="color:' + barColor + '">' + val.toFixed(0) + '</span>';
            html += '</div>';
          });
        } else {
          html += '<div style="color:var(--text3);font-size:12px;text-align:center;padding:8px">数据不足，无法计算因子</div>';
        }
        html += '</div>';

        html += '</div>'; // .ranking-row
      });

      // Factor weight legend
      html += '<div class="factor-weight-note">';
      html += '<strong>评分模型</strong>（移植自 <a href="https://github.com/HKUDS/Vibe-Trading" target="_blank" style="color:var(--primary)">Vibe-Trading</a> 因子框架）<br>';
      html += '11个因子 · 6大类：动量(MA偏离/20日/60日/RSI) · 波动率(历史/下行) · 趋势(均线排列/区间位置) · 回撤(深度/恢复) · 质量(夏普/加权收益) · QDII特色(限购/费率)<br>';
      html += '数据来源：基金净值序列 · 交叉截面归一化 · 权重加权合成 · 满分100';
      html += '</div>';

      return html;
    }

    /**
     * Get theme average score for a fund result.
     */
    function getThemeScore(result, theme) {
      if (!result.factorScores) return null;
      var factors = FactorEngine.list(theme);
      if (factors.length === 0) return null;
      var sum = 0, cnt = 0;
      factors.forEach(function(fid) {
        var s = result.factorScores[fid];
        if (s !== null && s !== undefined) { sum += s; cnt++; }
      });
      return cnt > 0 ? Math.round(sum / cnt * 100) / 100 : null;
    }

    /**
     * Toggle factor detail bars for a ranking row.
     * Called by onclick on ranking row.
     */
    function toggleFactorBars(idx) {
      var el = document.getElementById('factor-bars-' + idx);
      if (el) {
        el.style.display = el.style.display === 'none' ? 'block' : 'none';
      }
    }

    /**
     * Re-sort rankings by theme and re-render.
     */
    function sortByTheme(theme) {
      _rankingState.sortBy = theme;
      if (_rankingState.results) {
        var c = document.getElementById('ranking-content');
        c.innerHTML = buildRankingHTML(_rankingState.results);
      }
    }

    /**
     * Main render function for the ranking tab.
     * Uses two-phase loading: immediate with embedded data, then full history.
     */
    function renderRanking() {
      var c = document.getElementById('ranking-content');

      // 优先使用客户端 FactorEngine（多维度归一化评分，更直观）
      var activeFunds = fundsData.funds.filter(function(f) { return f.status === 'active'; });
      var hasEmbeddedHistory = false;
      activeFunds.forEach(function(f) {
        var cached = navCacheData[f.code];
        if (cached && Array.isArray(cached) && cached.length >= 10) hasEmbeddedHistory = true;
      });

      if (hasEmbeddedHistory) {
        _rankingState.results = computeRankings(navCacheData);
        c.innerHTML = buildRankingHTML(_rankingState.results);
        return;
      }

      // 回退：用服务端数据（简略版）
      if (todayPicks && todayPicks.allRanked && todayPicks.allRanked.length > 0) {
        _rankingState.results = todayPicks.allRanked.map(function(r) {
          return {
            code: r.code,
            name: r.name,
            composite: r.score,
            rawScores: {},
            factorScores: {},
            reason: r.reason,
            insufficient: false
          };
        });
        c.innerHTML = buildRankingHTML(_rankingState.results);
        return;
      }

      // 回退：用客户端 FactorEngine 计算
      var activeFunds = fundsData.funds.filter(function(f) { return f.status === 'active'; });

      // Check if we already have cached results
      if (_rankingState.results) {
        c.innerHTML = buildRankingHTML(_rankingState.results);
        return;
      }

      // Try with embedded navCacheData first
      var hasEmbeddedHistory = false;
      var fundCount = 0;
      activeFunds.forEach(function(f) {
        var cached = navCacheData[f.code];
        if (cached && Array.isArray(cached) && cached.length >= 10) {
          hasEmbeddedHistory = true;
          fundCount++;
        }
      });

      if (hasEmbeddedHistory) {
        _rankingState.results = computeRankings(navCacheData);
        c.innerHTML = buildRankingHTML(_rankingState.results);
      } else {
        c.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text3)">⏳ 正在加载完整净值数据以计算因子评分...</div>';
      }

      // Phase 2: Load full NAV history for accurate computation
      loadFullNavCache(function(fullNav) {
        if (!fullNav) {
          if (!_rankingState.results) {
            c.innerHTML = '<div class="empty">⚠️ 无法加载净值数据，因子评分不可用</div>';
          }
          return;
        }
        _rankingState.fullNav = fullNav;
        _rankingState.results = computeRankings(fullNav);
        c.innerHTML = buildRankingHTML(_rankingState.results);
      });
    }

    var STORAGE_KEY = 'qdii-portfolio';
    var cloudWriteReady = false;
    function saveLocal() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(portfolioData));
      } catch (error) {
        showToast('本机账本保存失败：' + error.message, true);
        return Promise.reject(error);
      }
      if (!cloudWriteReady || !window.QdiiCloudSync) {
        showToast('已保存在此浏览器；登录后可同步到其他设备');
        return Promise.resolve({ localOnly: true });
      }
      return window.QdiiCloudSync.saveLegacyPortfolio(portfolioData).catch(function(error) {
        cloudWriteReady = false;
        renderCloudState({ status: 'ERROR', source: '同步失败', error: error.message });
        showToast('云端保存失败：' + error.message, true);
        throw error;
      });
    }

