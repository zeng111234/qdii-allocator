        html += '<div style="font-size:11px;color:var(--text3)">' + f.amount + '元 → ' + Math.round(f.value * 100) / 100 + '元</div></div>';
        html += '</div></div>';
      });
      holdingsEl.innerHTML = html;

      // 实际 vs 模拟对比
      var realS = calcSummary();
      var realRate = realS.invested > 0 ? Math.round(((realS.value - realS.invested) / realS.invested) * 10000) / 100 : 0;
      var shadowRate = pnlRate;

