    // 自动结算回填：遍历待确认买入，用净值缓存回填
    function autoSettleInBrowser() {
      if (!portfolioData || !portfolioData.holdings) return;
      var changed = false;
      portfolioData.holdings.forEach(function(h) {
        (h.buys || []).forEach(function(buy) {
          if (buy.shares && buy.shares > 0) return; // 已结算
          if (!buy.date || !buy.amount) return;
          var cached = navCacheData[h.code];
          if (!cached || !Array.isArray(cached) || cached.length === 0) return;
          // T+2 是确认日；成交份额按有效申请日（T日）净值回填。
          var settleNav = null, settleDate = null;
          for (var i = 0; i < cached.length; i++) {
            if (cached[i].date >= buy.date) {
              settleNav = cached[i].nav;
              break;
            }
          }
          var confirmationDays = 0;
          for (var j = 0; j < cached.length; j++) {
            if (cached[j].date >= buy.date) {
              confirmationDays++;
              if (confirmationDays >= 3) { settleDate = cached[j].date; break; }
            }
          }
          if (settleNav && settleNav > 0) {
            buy.nav = settleNav;
            buy.shares = Math.round(buy.amount / settleNav * 10000) / 10000;
            buy.settleDate = settleDate;
            changed = true;
          }
        });
      });
    }

    // 云同步统一由 firebase-sync.js 负责。旧 Gist 方案已移除，避免把长期令牌存入 localStorage。

