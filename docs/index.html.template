        fundMap[b.code].amount += b.amount;
        fundMap[b.code].value += value;
        fundMap[b.code].buys.push(idx);
      });

      var pnl = Math.round((totalValue - totalAmount) * 100) / 100;
      var pnlRate = totalAmount > 0 ? Math.round((pnl / totalAmount) * 10000) / 100 : 0;
      var pnlCls = pnl >= 0 ? 'positive' : 'negative';
