            html += '<div style="display:inline-block;background:' + bgColor + ';border:1px solid ' + borderColor + ';border-radius:6px;padding:4px 10px;margin:2px 4px 2px 0;font-size:12px">';
            html += emoji + ' ' + _escH(e[0]) + ' ' + (e[1].score > 0 ? '+' : '') + e[1].score + '</div>';
          });
        }
        if (externalSignalsData.cachedAt) {
          var ageMs = Date.now() - new Date(externalSignalsData.cachedAt).getTime();
          var ageStr = ageMs < 0 ? '刚刚' : (ageMs < 3600000 ? Math.round(ageMs/60000) + '分钟前' : (ageMs < 86400000 ? Math.round(ageMs/3600000) + '小时前' : Math.round(ageMs/86400000) + '天前'));
          // 显示具体更新时间
          var d = new Date(externalSignalsData.cachedAt);
          var timeStr = (d.getMonth()+1) + '/' + d.getDate() + ' ' + d.getHours() + ':' + String(d.getMinutes()).padStart(2,'0');
