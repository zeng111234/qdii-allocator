    function refreshNews() {
      var el = document.getElementById('news-sentiment-content');
      el.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text3)">🔄 正在刷新新闻...</div>';

      var globalApi = 'https://np-listapi.eastmoney.com/comm/web/getNewsByColumns?client=web&biz=web_news_col&column=350&order=1&needInteractData=0&page_index=1&page_size=10&req_trace=' + Date.now();
      var usApi = 'https://np-listapi.eastmoney.com/comm/web/getNewsByColumns?client=web&biz=web_news_col&column=353&order=1&needInteractData=0&page_index=1&page_size=8&req_trace=' + Date.now();
      // 用CORS代理（东方财富API会检查Referer，直接请求会被拦截）
      var proxy = 'https://api.allorigins.win/raw?url=';

      var posWords = ['利好','上涨','突破','新高','增长','反弹','降息','宽松','牛市','大涨','看涨','bullish','rally','surge','gain','走高','拉升','飙升'];
      var negWords = ['利空','下跌','暴跌','新低','衰退','加息','紧缩','熊市','大跌','看跌','bearish','crash','plunge','sell-off','risk','走低','跳水'];
      var themeKeywords = { nasdaq: ['纳指','纳斯达克','科技股','英伟达','NVIDIA','微软','Apple','特斯拉','AI','芯片','半导体'], sp500: ['标普','S&P','美股','美联储','Fed','道琼斯','美国经济'], hongkong: ['港股','恒生','阿里','腾讯','港交所','亚太','中概'], oil: ['油价','原油','石油','能源','黄金','gold','OPEC','铜','大宗'] };

      function parseItems(raw) {
        try { var j = JSON.parse(raw); return (j.data && j.data.list) ? j.data.list.map(function(i) { return { title: i.title||'', digest: i.digest||'', time: i.showTime||'' }; }) : []; } catch(e) { return []; }
      }
      function sentimentScore(title) {
        var tl = title.toLowerCase(); var s = 0;
        posWords.forEach(function(w) { if (tl.indexOf(w.toLowerCase()) >= 0) s++; });
        negWords.forEach(function(w) { if (tl.toLowerCase().indexOf(w.toLowerCase()) >= 0) s--; });
        return s;
      }
      function themeMatch(title) {
        var r = {}; var tl = title.toLowerCase();
        Object.keys(themeKeywords).forEach(function(t) { r[t] = themeKeywords[t].some(function(w) { return tl.indexOf(w.toLowerCase()) >= 0; }); });
        return r;
      }

      Promise.all([
        fetch(proxy + encodeURIComponent(globalApi)).then(function(r) { return r.text(); }).catch(function() { return ''; }),
        fetch(proxy + encodeURIComponent(usApi)).then(function(r) { return r.text(); }).catch(function() { return ''; })
      ]).then(function(res) {
        var allItems = parseItems(res[0]).concat(parseItems(res[1]));
        if (allItems.length === 0) {
          // 降级：如果获取失败，显示已嵌入的新闻
          if (newsData && newsData.items && newsData.items.length > 0) {
            showToast('实时获取失败，显示已有新闻', true);
            loadNewsSentiment();
          } else {
            el.innerHTML = '<div style="color:var(--danger);font-size:12px;text-align:center;padding:10px">❌ 未获取到新闻</div>';
          }
          return;
        }
        var pos = 0, neg = 0, neu = 0, byTheme = {};
        Object.keys(themeKeywords).forEach(function(t) { byTheme[t] = { pos: 0, neg: 0 }; });

        allItems.forEach(function(item) {
          var score = sentimentScore(item.title);
          item._score = score;
          if (score > 0) pos++; else if (score < 0) neg++; else neu++;
          var tm = themeMatch(item.title);
          Object.keys(tm).forEach(function(t) { if (tm[t]) { if (score > 0) byTheme[t].pos++; else if (score < 0) byTheme[t].neg++; } });
        });

        newsData = { items: allItems, sentiment: { overall: pos - neg, positive: pos, negative: neg, neutral: neu, byTheme: byTheme }, fetchedAt: new Date().toISOString() };
        loadNewsSentiment();
        showToast('新闻已刷新，共 ' + allItems.length + ' 条');
      }).catch(function(e) {
        console.error('[news] refresh error:', e);
        if (newsData && newsData.items && newsData.items.length > 0) {
          showToast('实时获取失败，显示已有新闻', true);
          loadNewsSentiment();
        } else {
          el.innerHTML = '<div style="color:var(--danger);font-size:12px;text-align:center;padding:10px">❌ 刷新失败，请检查网络后重试</div>';
          showToast('新闻刷新失败', true);
        }
      });
    }

    function runBacktest() {
      loadFullNavCache(function(fullNav) {
        var el = document.getElementById('backtest-content');
        if (!fullNav) {
          el.innerHTML = '<div style="color:var(--text3);font-size:12px">无法加载净值历史数据</div>';
          return;
        }

        // Walk-forward backtest simulation
        // Use portfolio's fund codes, simulate equal-weight allocation
        var codes = portfolioData.holdings.map(function(h) { return h.code; });
        if (codes.length === 0) {
          el.innerHTML = '<div style="color:var(--text3);font-size:12px">暂无持仓，无法回测</div>';
          return;
        }

        // Get aligned date series
        var allDates = {};
        codes.forEach(function(code) {
          if (fullNav[code]) {
            fullNav[code].forEach(function(n) { allDates[n.date] = true; });
          }
        });
        var dates = Object.keys(allDates).sort();
        if (dates.length < 150) {
          el.innerHTML = '<div style="color:var(--text3);font-size:12px">净值数据不足150天，无法进行走步回测</div>';
          return;
        }

        // Build NAV matrix
        var navMatrix = {};
        codes.forEach(function(code) {
          navMatrix[code] = {};
          if (fullNav[code]) {
            fullNav[code].forEach(function(n) { navMatrix[code][n.date] = n.nav; });
          }
        });

        // Walk-forward: train 120 days, test 30 days, slide forward
        var trainDays = 120, testDays = 30;
        var windows = [];
        var startIdx = 0;
        while (startIdx + trainDays + testDays <= dates.length) {
          var trainDates = dates.slice(startIdx, startIdx + trainDays);
          var testDates = dates.slice(startIdx + trainDays, startIdx + trainDays + testDays);

          // Calculate train period returns for each fund
          var trainReturns = {};
          codes.forEach(function(code) {
            var startNav = navMatrix[code][trainDates[0]];
            var endNav = navMatrix[code][trainDates[trainDates.length - 1]];
            if (startNav && endNav) {
              trainReturns[code] = (endNav - startNav) / startNav;
            }
          });

          // Equal-weight test period return
          var testReturn = 0, validCount = 0;
          codes.forEach(function(code) {
            var startNav = navMatrix[code][testDates[0]];
            var endNav = navMatrix[code][testDates[testDates.length - 1]];
            if (startNav && endNav) {
              testReturn += (endNav - startNav) / startNav;
              validCount++;
            }
          });
          if (validCount > 0) testReturn = testReturn / validCount * 100;

          windows.push({
            trainStart: trainDates[0],
            trainEnd: trainDates[trainDates.length - 1],
            testStart: testDates[0],
            testEnd: testDates[testDates.length - 1],
            testReturn: Math.round(testReturn * 100) / 100
          });

          startIdx += testDays;
        }

        if (windows.length === 0) {
          el.innerHTML = '<div style="color:var(--text3);font-size:12px">数据不足，无法生成回测窗口</div>';
          return;
        }

        // Calculate stats
        var wins = windows.filter(function(w) { return w.testReturn > 0; });
        var winRate = Math.round(wins.length / windows.length * 100);
        var totalReturn = windows.reduce(function(s, w) { return s + w.testReturn; }, 0);
        var best = Math.max.apply(null, windows.map(function(w) { return w.testReturn; }));
        var worst = Math.min.apply(null, windows.map(function(w) { return w.testReturn; }));
        var avgReturn = Math.round(totalReturn / windows.length * 100) / 100;

        var html2 = '<div class="insight-grid">';
        html2 += '<div class="insight-stat ' + (winRate >= 50 ? 'green' : 'red') + '"><div class="label">胜率</div><div class="value">' + winRate + '%</div></div>';
        html2 += '<div class="insight-stat ' + (totalReturn >= 0 ? 'blue' : 'red') + '"><div class="label">累计收益</div><div class="value">' + (totalReturn >= 0 ? '+' : '') + Math.round(totalReturn * 100) / 100 + '%</div></div>';
        html2 += '<div class="insight-stat green"><div class="label">最佳窗口</div><div class="value">+' + Math.round(best * 100) / 100 + '%</div></div>';
        html2 += '<div class="insight-stat red"><div class="label">最差窗口</div><div class="value">' + Math.round(worst * 100) / 100 + '%</div></div>';
        html2 += '</div>';
        html2 += '<div style="font-size:11px;color:var(--text3);margin-top:4px">' + windows.length + '个窗口 · 平均收益 ' + avgReturn + '%</div>';

        // Overfitting detection: compare train vs test
        var avgTrainReturn = 0;
        windows.forEach(function(w) {
          var trainRet = 0, tc = 0;
          codes.forEach(function(code) {
            var s = navMatrix[code][w.trainStart];
            var e = navMatrix[code][w.trainEnd];
            if (s && e) { trainRet += (e - s) / s; tc++; }
          });
          if (tc > 0) avgTrainReturn += trainRet / tc * 100;
        });
        avgTrainReturn = avgTrainReturn / windows.length;
        var overfitGap = Math.round((avgTrainReturn - avgReturn) * 100) / 100;
        var overfitRisk = overfitGap > 10 ? '🔴 高过拟合风险' : (overfitGap > 5 ? '🟡 中度过拟合风险' : '🟢 低过拟合风险');
        html2 += '<div style="padding:8px;background:' + (overfitGap > 10 ? '#fef2f2' : '#f0fdf4') + ';border-radius:6px;font-size:12px;margin-top:8px">';
        html2 += '过拟合检测: 训练均值 ' + Math.round(avgTrainReturn * 100) / 100 + '% vs 测试均值 ' + avgReturn + '% · 差距 ' + overfitGap + '% · ' + overfitRisk;
        html2 += '</div>';

        el.innerHTML = html2;

        // Performance Attribution
        runAttribution(navMatrix, codes, dates);
      });
    }

    function runAttribution(navMatrix, codes, dates) {
      var el = document.getElementById('attribution-content');
      if (!el) return;

      // Calculate each fund's contribution to portfolio return
      var recent30 = dates.slice(-30);
      var attributions = [];
      codes.forEach(function(code) {
        var fund = fundsData.funds.find(function(f) { return f.code === code; });
        var holding = portfolioData.holdings.find(function(h) { return h.code === code; });
        var inv = holding ? holding.buys.reduce(function(s, b) { return s + b.amount; }, 0) : 0;

        var startNav = navMatrix[code][recent30[0]];
        var endNav = navMatrix[code][recent30[recent30.length - 1]];
        var fundReturn = (startNav && endNav) ? Math.round((endNav - startNav) / startNav * 10000) / 100 : 0;

        attributions.push({
          code: code,
          name: fund ? fund.name : code,
          type: fund ? fund.type : '其他',
          invested: inv,
          return30d: fundReturn,
          contribution: inv * fundReturn / 100
        });
      });

      attributions.sort(function(a, b) { return b.contribution - a.contribution; });

      var html2 = '<div style="font-size:12px">';
      html2 += '<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:2px solid var(--border);font-weight:600;font-size:11px">';
      html2 += '<span style="flex:2">基金</span><span style="width:60px;text-align:right">30日收益</span><span style="width:70px;text-align:right">贡献(元)</span></div>';

      var totalContribution = attributions.reduce(function(s, a) { return s + a.contribution; }, 0);
      attributions.slice(0, 10).forEach(function(a) {
        var cls = a.return30d >= 0 ? 'var(--danger)' : 'var(--success)';
        html2 += '<div style="display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid var(--border);align-items:center">';
        html2 += '<span style="flex:2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="' + a.name + '">' + a.name + '</span>';
        html2 += '<span style="width:60px;text-align:right;color:' + cls + ';font-weight:600">' + (a.return30d >= 0 ? '+' : '') + a.return30d + '%</span>';
        html2 += '<span style="width:70px;text-align:right;color:' + (a.contribution >= 0 ? 'var(--danger)' : 'var(--success)') + '">' + (a.contribution >= 0 ? '+' : '') + Math.round(a.contribution * 100) / 100 + '</span>';
        html2 += '</div>';
      });
      html2 += '<div style="display:flex;justify-content:space-between;padding:6px 0;font-weight:600">';
      html2 += '<span>合计贡献</span>';
      html2 += '<span style="color:' + (totalContribution >= 0 ? 'var(--danger)' : 'var(--success)') + '">' + (totalContribution >= 0 ? '+' : '') + Math.round(totalContribution * 100) / 100 + '元</span>';
      html2 += '</div>';
      html2 += '</div>';

      el.innerHTML = html2;
    }

    if (dailyBriefData && dailyBriefData.content) {
      document.getElementById('brief-card').style.display = 'block';
      document.getElementById('daily-brief').textContent = dailyBriefData.content;
    }
  </script>
</body>
</html>
