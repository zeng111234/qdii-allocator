    FactorEngine.register('scarce_limit', '限购稀缺度', 'qdii_special', function(navArr, fundMeta) {
      // 限购不代表基金好，统一返回50（中性）
      return 50;
    }, 0.0); // 权重设为0，完全忽略限购因素

    // [fix] 新增估值因子：基于市场温度+基金类型差异化评分
    // 不同基金类型对市场温度的敏感度不同
    FactorEngine.register('valuation_temp', '估值温度', 'qdii_special', function(navArr, fundMeta) {
      if (!marketTemperature) return 50;
      var temp = marketTemperature.temperature || 50;
      if (!fundMeta) return 50;
      var type = (fundMeta.type || '').toLowerCase();

      // 基础分：温度越低越值得买（逆向思维）
      var base = Math.max(20, Math.min(80, 100 - temp));

      // 不同类型对温度的敏感度不同
      var sensitivity = 1.0; // 默认敏感度
      if (type.indexOf('纳指') >= 0 || type.indexOf('纳斯达克') >= 0 || type.indexOf('科技') >= 0) {
        sensitivity = 1.5;  // 科技类对市场温度最敏感
      } else if (type.indexOf('标普') >= 0 || type.indexOf('全球') >= 0) {
        sensitivity = 1.2;  // 宽基类中等敏感
      } else if (type.indexOf('债') >= 0 || type.indexOf('reit') >= 0) {
        sensitivity = 0.3;  // 债券/REITs几乎不受市场温度影响
      } else if (type.indexOf('石油') >= 0 || type.indexOf('商品') >= 0 || type.indexOf('黄金') >= 0) {
        sensitivity = 0.5;  // 商品类低敏感
      } else if (type.indexOf('港股') >= 0 || type.indexOf('亚太') >= 0 || type.indexOf('新兴') >= 0) {
        sensitivity = 1.3;  // 新兴市场高敏感
      }

      // 用敏感度调整分数：偏离50越远，敏感度影响越大
      var deviation = base - 50;
      var adjusted = 50 + deviation * sensitivity;
      return Math.max(10, Math.min(90, Math.round(adjusted)));
