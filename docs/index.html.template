    function renderCloudState(state) {
      var status = state || {};
      var stateEl = document.getElementById('cloud-sync-state');
      var sourceEl = document.getElementById('sync-source');
      var revisionEl = document.getElementById('sync-revision');
      var detailEl = document.getElementById('cloud-sync-detail');
      var revisionDetailEl = document.getElementById('sync-revision-detail');
      var signInEl = document.getElementById('cloud-sign-in');
      var signedOut = status.status === 'SIGNED_OUT';
      var publicSnapshot = status.status === 'PUBLIC_SNAPSHOT';
      if (stateEl) stateEl.textContent = status.status === 'SYNCING' ? '⏳ 正在核对持仓' :
        (status.status === 'READY' ? '✅ 持仓已同步' : (status.status === 'OFFLINE' ? '💾 正在查看本机账本' : (publicSnapshot ? '🌐 正在查看公开账本' : (signedOut ? '👋 正在查看公开行情' : '⚠️ 同步暂不可用'))));
      if (sourceEl) sourceEl.textContent = (signedOut || publicSnapshot) ? (publicSnapshot ? '无需登录，只读快照' : '登录后可跨设备同步') : (status.source || '未知');
      if (revisionEl) revisionEl.textContent = status.revision === undefined ? '-' : status.revision;
      if (detailEl) detailEl.style.display = status.status === 'ERROR' ? 'inline' : '';
      if (revisionDetailEl) revisionDetailEl.style.display = (signedOut || publicSnapshot || status.status === 'OFFLINE' || status.status === 'ERROR') ? 'none' : 'inline';
      if (signInEl) {
        signInEl.textContent = status.status === 'OFFLINE' ? '登录并备份持仓' : '登录并同步持仓';
        signInEl.style.display = (status.status === 'SIGNED_OUT' ||
          (status.status === 'OFFLINE' && status.source === 'Chrome 本地只读')) ? 'inline' : 'none';
      }
      if (status.error) console.error('Cloud sync:', status.error);
    }

