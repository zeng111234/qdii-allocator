        el.style.display = 'none';
        arrow.style.transform = 'rotate(0deg)';
      }
    }

    function actionAllowsPurchase(plan) {
      var safePlan = plan || {};
      return (safePlan.action === 'BUY' || safePlan.action === 'TACTICAL_PAUSE') && Number(safePlan.budget) > 0;
    }

    function updateAnchorButton(detail) {
      var button = document.getElementById('decision-anchor-btn');
      if (!button) return;
      var hasLedger = !!(detail && detail.ledger && Number(detail.ledger.revision) > 0);
      var hasAnchor = !!(detail && detail.decisionState && Number(detail.decisionState.riskAnchorValue) > 0);
      var publicSnapshot = window.QDII_PUBLIC_PORTFOLIO_SNAPSHOT === true;
      button.style.display = hasLedger && !hasAnchor && (detail.readOnly !== true || publicSnapshot) ? 'inline-block' : 'none';
    }

    function renderAnchorSetupCard(detail, plan) {
      var card = document.getElementById('decision-anchor-card');
      if (!card) return;
      var needsAnchor = !!(plan && plan.decisionMode === 'ACTION_REQUIRED' && plan.blockedStage === 'RISK_ANCHOR_SETUP');
      var publicSnapshot = window.QDII_PUBLIC_PORTFOLIO_SNAPSHOT === true;
      var canInitialize = !!(detail && detail.ledger && Number(detail.ledger.revision) > 0 && (detail.readOnly !== true || publicSnapshot));
      if (!needsAnchor || !canInitialize) { card.style.display = 'none'; return; }
      var value = Number(plan.portfolioRisk && plan.portfolioRisk.currentValue) || 0;
      card.innerHTML = '<div style="font-weight:700;margin-bottom:4px">⚓ 需要完成一次风险锚点初始化</div>'
        + '<div>已校验账本 revision ' + Number(plan.syncRevision || 0) + '，将当前市值 ' + formatMetric(value) + ' 元作为后续回撤比较起点。</div>'
        + '<div style="margin-top:4px">此操作不会买卖基金；完成后系统会立即重新计算只读计划。' + (publicSnapshot ? '锚点仅保存在此浏览器。' : '') + '</div>'
        + '<button class="btn" style="margin-top:8px;width:auto;padding:6px 10px;background:var(--state-yellow-text);color:white;font-size:12px" onclick="firebaseSetRiskAnchor()">初始化并重新计算</button>';
      card.style.display = 'block';
    }

    function buildSignalConfirmation(news, externalSignals, nowMs) {
      var now = Number(nowMs) || Date.now();
      var maxAgeMs = 24 * 60 * 60 * 1000;
      var newsSource = news || {};
      var externalSource = externalSignals || {};
      var newsCount = Array.isArray(newsSource.items) ? newsSource.items.length : 0;
      var opinions = Array.isArray(externalSource.tickerOpinions) ? externalSource.tickerOpinions : [];
      var sentiment = newsSource.sentiment || {};
      var newsAt = Date.parse(newsSource.fetchedAt || '');
      var externalRawAt = externalSource.cachedAt;
      var externalAt = typeof externalRawAt === 'number' ? externalRawAt : Date.parse(externalRawAt || '');
      var newsFresh = Number.isFinite(newsAt) && now >= newsAt && now - newsAt <= maxAgeMs;
      var externalFresh = Number.isFinite(externalAt) && now >= externalAt && now - externalAt <= maxAgeMs;
      var newsBullish = newsFresh && newsCount >= 5 && Number(sentiment.overall) > 10 && Number(sentiment.positive) > Number(sentiment.negative);
      var bullish = opinions.filter(function(item) { return item && item.sentiment === 'bullish'; }).length;
      var bearish = opinions.filter(function(item) { return item && item.sentiment === 'bearish'; }).length;
      var externalBullish = externalFresh && externalSource.status === 'ok' && opinions.length >= 2 && bullish >= 2 && bullish > bearish;
      if (newsBullish && externalBullish) {
        return { status: 'CONFIRMED', fresh: true, reason: '新闻与外部信号均新鲜且偏多', newsCount: newsCount, externalCount: opinions.length };
      }
      return {
        status: 'INSUFFICIENT', fresh: newsFresh && externalFresh,
        reason: !newsFresh || !externalFresh ? '新闻或外部信号已过期' : '新闻与外部信号未形成偏多共识',
        newsCount: newsCount, externalCount: opinions.length
      };
    }

    function refreshPersonalizedPlan(detail) {
      currentCloudDetail = detail || currentCloudDetail;
      updateAnchorButton(currentCloudDetail);
      if (!currentCloudDetail || !window.QdiiPersonalizedDecision) return;
      var backendState = currentCloudDetail.strategyState;
      var backendPlan = backendState && backendState.latestPlan;
      var basePlan = backendPlan && backendPlan.dataFreshness && backendPlan.dataFreshness.status === 'FRESH'
        ? Object.assign({}, publicTodayPicks, backendPlan, {
          date: backendPlan.asOf,
          ranked: (backendPlan.candidates || []).map(function(candidate) {
            return Object.assign({}, candidate, { score: candidate.marketScore, proposedAmount: 0 });
          }),
          strategyState: backendState
        })
        : publicTodayPicks;
      todayPicks = window.QdiiPersonalizedDecision.personalizePlan({
        basePlan: basePlan,
        ledger: currentCloudDetail.ledger,
        decisionState: currentCloudDetail.decisionState,
        portfolio: portfolioData,
        funds: fundsData.funds || [],
        navCache: navCacheData,
        marketTemperature: marketTemperature,
        signalConfirmation: buildSignalConfirmation(newsData, externalSignalsData),
        asOf: basePlan.date || new Date().toISOString().slice(0, 10),
        readOnly: currentCloudDetail.readOnly === true
      });
      renderAnchorSetupCard(currentCloudDetail, todayPicks);
      renderTradeBanner();
      renderTemperature();
      renderBuySignal();
      renderPicks();
      if (typeof syncChatPlanScope === 'function') syncChatPlanScope(todayPicks);
    }

    // Trading calendar banner
    function renderTradeBanner() {
      var banner = document.getElementById('trade-banner');
      if (!banner) return;
      var today = new Date().toISOString().slice(0, 10);
      var day = new Date().getDay();
      var isHoliday = tradingHolidays.indexOf(today) >= 0;
      var isWeekend = day === 0 || day === 6;
      var isTradeDay = !isHoliday && !isWeekend;

      var planAllowsPurchase = actionAllowsPurchase(todayPicks);
      var executionReady = cloudWriteReady && planAllowsPurchase;
      if (isTradeDay && executionReady) {
        banner.style.display = 'block';
        banner.style.background = 'var(--state-green-bg)';
        banner.style.color = 'var(--state-green-text)';
        banner.style.border = '1px solid var(--state-green-border)';
        banner.innerHTML = '🟢 今天是交易日 · 个性化计划允许投入' + Number(todayPicks.budget || 0) + '元 · T日净值成交、T+2确认';
      } else if (isTradeDay && planAllowsPurchase) {
        banner.style.display = 'block';
        banner.style.background = 'var(--state-blue-bg)';
        banner.style.color = 'var(--primary)';
        banner.style.border = '1px solid var(--state-blue-border)';
        banner.innerHTML = '🔵 今天是交易日 · 公开只读计划建议 ' + Number(todayPicks.budget || 0) + '元 · 需在基金平台手动执行，页面不会写回账本';
      } else if (isTradeDay) {
        banner.style.display = 'block';
        banner.style.background = 'var(--state-yellow-bg)';
        banner.style.color = 'var(--state-yellow-text)';
        banner.style.border = '1px solid var(--state-yellow-border)';
        banner.innerHTML = window.QDII_PUBLIC_PORTFOLIO_SNAPSHOT
          ? '🟡 今天是交易日 · 正在使用公开只读账本快照，不能直接写回持仓 · T+2仅为确认，不代表按两天后净值成交'
          : (cloudWriteReady
          ? '🟡 今天是交易日 · 系统预算 0 元 · T+2仅为确认，不代表按两天后净值成交'
          : '🟡 今天是交易日 · 本机账本可查看；登录同步后才计算个人预算 · T+2仅为确认，不代表按两天后净值成交');
      } else {
        banner.style.display = 'block';
        banner.style.background = 'var(--state-yellow-bg)';
        banner.style.color = 'var(--state-yellow-text)';
        banner.style.border = '1px solid var(--state-yellow-border)';
        var reason = isHoliday ? '法定节假日' : (day === 0 ? '周日' : '周六');
        banner.innerHTML = '🟡 今天非交易日（' + reason + '）· 可以买入，下一个交易日确认份额';
      }
    }

    // [fix] Market temperature card
    function renderTemperature() {
      var mt = marketTemperature;
      if (!mt || !mt.temperature && mt.temperature !== 0) return;
      var card = document.getElementById('temp-card');
      var content = document.getElementById('temp-content');
      if (!card || !content) return;

      var temp = mt.temperature;
      var level = mt.level || '正常';
      var multiplier = mt.multiplier || 1.0;
      var vix = mt.vix;
      var peData = mt.peData || {};
      var reason = mt.reason || '';
      // 市场温度只解释或降低预算；未同步或 PAUSE 时绝不能显示可投入金额。
      var planAllowsPurchase = actionAllowsPurchase(todayPicks);
      var executionReady = cloudWriteReady && planAllowsPurchase;
      var adjustedBudget = planAllowsPurchase ? Math.max(0, Number(todayPicks.budget) || 0) : 0;
      var budgetStatus = executionReady ? (multiplier + 'x，仅作风险解释') : (planAllowsPurchase ? '只读建议，需手动执行' : (cloudWriteReady ? 'PAUSE' : '未同步'));

      // 颜色编码
      var tempColor, bgColor, emoji;
      if (temp <= 20) { tempColor = '#3b82f6'; bgColor = 'rgba(59,130,246,0.1)'; emoji = '🥶'; }
      else if (temp <= 35) { tempColor = '#06b6d4'; bgColor = 'rgba(6,182,212,0.1)'; emoji = '❄️'; }
      else if (temp <= 65) { tempColor = '#22c55e'; bgColor = 'rgba(34,197,94,0.1)'; emoji = '🌡️'; }
      else if (temp <= 80) { tempColor = '#f97316'; bgColor = 'rgba(249,115,22,0.1)'; emoji = '🔥'; }
      else { tempColor = '#ef4444'; bgColor = 'rgba(239,68,68,0.1)'; emoji = '🌋'; }

      // 温度条
      var barWidth = temp;
      var barHtml = '<div style="background:var(--card-bg);border-radius:6px;height:8px;overflow:hidden;margin:8px 0">'
        + '<div style="background:' + tempColor + ';height:100%;width:' + barWidth + '%;border-radius:6px;transition:width 0.5s"></div>'
        + '</div>';

      // PE 数据
      var peHtml = '';
      var peKeys = Object.keys(peData);
      if (peKeys.length > 0) {
        peHtml = '<div style="font-size:12px;color:var(--text2);margin-top:6px">';
        peKeys.forEach(function(k) {
          var idx = peData[k];
          var peColor = idx.pe > 30 ? '#ef4444' : (idx.pe < 18 ? '#22c55e' : 'var(--text2)');
          peHtml += '<span style="margin-right:12px">' + idx.name + ': <b style="color:' + peColor + '">PE ' + (idx.pe ? idx.pe.toFixed(1) : 'N/A') + '</b></span>';
        });
        peHtml += '</div>';
      }

      content.innerHTML = '<div style="padding:12px 16px;background:' + bgColor + ';border-radius:12px">'
        + '<div style="display:flex;justify-content:space-between;align-items:center">'
        + '<div>'
        + '<span style="font-size:20px">' + emoji + '</span> '
        + '<span style="font-size:16px;font-weight:700;color:' + tempColor + '">市场温度 ' + temp + '</span>'
        + '<span style="font-size:13px;color:var(--text2);margin-left:6px">(' + level + ')</span>'
        + '</div>'
        + '<div style="text-align:right">'
        + '<div style="font-size:13px;color:var(--text2)">建议投入</div>'
        + '<div style="font-size:18px;font-weight:700;color:' + tempColor + '">' + adjustedBudget + '元</div>'
        + '<div style="font-size:11px;color:var(--text3)">' + budgetStatus + '</div>'
        + '</div>'
        + '</div>'
        + barHtml
        + '<div style="display:flex;gap:16px;font-size:12px;color:var(--text2)">'
        + (vix ? '<span>VIX: <b>' + vix.toFixed(1) + '</b></span>' : '')
        + (reason && reason !== '市场正常' ? '<span>' + reason + '</span>' : '')
        + '</div>'
        + peHtml
        + '</div>';

      card.style.display = 'block';
    }

    function getHypothesisOutcomeStats(hypotheses) {
      var source = Array.isArray(hypotheses) ? hypotheses : [];
      var validated = source.filter(function(h) { return h && h.status === 'validated'; }).length;
      var invalidated = source.filter(function(h) { return h && h.status === 'invalidated'; }).length;
      var sampleCount = validated + invalidated;
      return {
        validated: validated,
        invalidated: invalidated,
        sampleCount: sampleCount,
        winRate: sampleCount > 0 ? Math.round(validated / sampleCount * 100) : null
      };
    }

    function formatMetric(value, digits) {
      var number = Number(value);
      if (!Number.isFinite(number)) return '暂无';
      var precision = digits === undefined ? 2 : digits;
      return Number(number.toFixed(precision)).toString();
    }

    function getTodayPicksAverage(plan) {
      var ranked = plan && Array.isArray(plan.ranked) ? plan.ranked : [];
      var scores = ranked.map(function(row) {
        var raw = row && (row.score !== undefined ? row.score : row.marketScore);
        return raw === null || raw === undefined ? NaN : Number(raw);
      }).filter(Number.isFinite);
      if (scores.length === 0) return null;
      return Number((scores.reduce(function(sum, score) { return sum + score; }, 0) / scores.length).toFixed(2));
    }

    function formatPauseReason(reason) {
      var raw = reason && typeof reason === 'object' ? (reason.message || reason.code || JSON.stringify(reason)) : String(reason || '');
      var labels = {
        SIGNAL_CIRCUIT_BREAKER: '近期5日推荐表现触发信号熔断',
        RECENT_WIN_RATE_LOW: '近期5日正收益率低于门槛',
        RECENT_AVERAGE_RETURN_LOW: '近期5日平均收益低于门槛',
        LIVE_DISABLED: '真实买入总闸未开启',
        DATA_STALE: '净值数据时效不合格',
        SYNC_REQUIRED: '云端账本尚未同步',
        EMPTY_PORTFOLIO: '云端账本没有可计算的持仓',
        OFFLINE_READ_ONLY: '离线快照仅供查看，禁止生成投入金额',
        RISK_ANCHOR_MISSING: '尚未设置迁移市值风险锚点',
        RISK_ANCHOR_LEDGER_MISMATCH: '风险锚点来自更新的账本，需重新核对迁移',
        RISK_ANCHOR_DRAWDOWN_10: '相对风险锚点回撤达到-10%',
        TACTICAL_CORE_ONLY: '择时信号暂停，仅允许低配核心桶小额定投',
        NO_ELIGIBLE_CORE_ROUTE: '没有可执行的低配核心桶通道',
        NO_UNDERWEIGHT_CORE_BUCKET: '现有核心桶均不低配',
        NO_ELIGIBLE_EXISTING_CHANNEL: '低配桶没有可用的现有基金通道',
        CONCENTRATION_OR_MIN_PURCHASE_BLOCK: '通道受到集中度上限或最小申购额限制',
        PARTIAL_ROUTE_CAPACITY: '部分预算受限购或集中度上限未分配',
        WEEKLY_BUDGET_EXHAUSTED: '本周战术定投额度已用完',
        UNKNOWN_HOLDINGS: '存在无法识别的持仓',
        NO_ELIGIBLE_CANDIDATES: '没有通过硬风控的候选'
      };
      return labels[raw] ? labels[raw] + '（' + raw + '）' : raw;
    }

    function buildPauseDetails(plan) {
      var safePlan = plan || {};
      var health = safePlan.signalHealth || {};
      var matured = health.matured || {};
      var shadow = health.shadow || {};
      var details = ['确定性风控状态：' + (safePlan.action || 'PAUSE'), '信号健康度：' + (health.status || '未知')];
      var reasons = Array.isArray(safePlan.pauseReasons) ? safePlan.pauseReasons.map(formatPauseReason).filter(Boolean) : [];
      if (reasons.length > 0) details.push('暂停原因：' + reasons.join('、'));
      else if (health.breakerTriggered) details.push('暂停原因：近期5日推荐表现触发信号熔断');
      if (Number(matured.count) > 0) {
        details.push('最近' + matured.count + '个成熟5日结果：胜率' + formatMetric(matured.winRate) + '%，平均收益' + formatMetric(matured.averageReturn) + '%');
      }
      details.push('熔断阈值：成熟样本至少15个，胜率40%以下或平均收益-1%及以下');
      details.push('恢复条件：至少20个影子5日结果，胜率达到50%，平均收益大于0%');
      if (Number(shadow.count) > 0) {
        details.push('当前影子结果：' + shadow.count + '个，胜率' + formatMetric(shadow.winRate) + '%，平均收益' + formatMetric(shadow.averageReturn) + '%');
      }
      if (safePlan.dataFreshness) {
        details.push('数据时效：' + (safePlan.dataFreshness.status || '未知') + (safePlan.dataFreshness.latestNavDate ? '，最新净值' + safePlan.dataFreshness.latestNavDate : ''));
      }
      if (safePlan.personalized) {
        details.push('云端账本 revision：' + Number(safePlan.syncRevision || 0));
        if (safePlan.budgetPolicy) details.push('本周已买' + formatMetric(safePlan.budgetPolicy.weeklySpent) + '元，剩余额度' + formatMetric(safePlan.budgetPolicy.weeklyRemaining) + '元');
        if (safePlan.budgetPolicy && safePlan.budgetPolicy.overheatReduced) details.push('市场温度偏热，战术单日上限降为' + formatMetric(safePlan.budgetPolicy.dailyLimit) + '元');
        if (safePlan.budgetPolicy && safePlan.budgetPolicy.signalConfirmation) details.push('新闻/外部确认：' + safePlan.budgetPolicy.signalConfirmation.reason);
        if (safePlan.riskAnchorValue) {
          var adjustedAnchor = Number(safePlan.adjustedRiskAnchorValue || safePlan.riskAnchorValue);
          var netCashFlow = Number(safePlan.riskAnchorNetCashFlow || 0);
          details.push('风险锚点：' + formatMetric(adjustedAnchor) + '元（后续净现金流' + formatMetric(netCashFlow) + '元），当前回撤' + formatMetric(Number(safePlan.riskAnchorDrawdown || 0) * 100) + '%');
        }
        var routeDiagnostics = safePlan.routeDiagnostics || {};
        if (Number(routeDiagnostics.requestedBudget) > 0 && Number(routeDiagnostics.allocatedBudget) === 0) {
          var routeReasons = Array.isArray(routeDiagnostics.blockReasons) ? routeDiagnostics.blockReasons.map(formatPauseReason).filter(Boolean) : [];
          if (routeReasons.length > 0) details.push('执行通道：' + routeReasons.join('、'));
        }
      }
      return details.join('；');
    }

    // [fix] Buy Signal Banner
    function renderBuySignal() {
      var card = document.getElementById('buy-signal-card');
      var content = document.getElementById('buy-signal-content');
      if (!card || !content) return;

      var bi = todayPicks && todayPicks.budgetInfo ? todayPicks.budgetInfo : null;
      var signal, reason, avgScore = getTodayPicksAverage(todayPicks);

      if (todayPicks && (todayPicks.action === 'HARD_PAUSE' || todayPicks.action === 'PAUSE' || todayPicks.action === 'HOLD')) {
        signal = 'STOP';
        reason = buildPauseDetails(todayPicks);
      } else if (todayPicks && todayPicks.action === 'TACTICAL_PAUSE') {
        signal = 'CAUTION';
        reason = buildPauseDetails(todayPicks);
      } else if (bi && bi.buySignal) {
        signal = bi.buySignal;
        reason = bi.buySignalReason || '';
        avgScore = Number.isFinite(Number(bi.avgScore)) ? Number(bi.avgScore) : avgScore;
      } else {
        // [fix] 无budgetInfo时，基于市场温度+评分自行计算
        var temp = marketTemperature ? marketTemperature.temperature : 50;
        var ranked = todayPicks && todayPicks.ranked ? todayPicks.ranked : [];
        avgScore = getTodayPicksAverage({ ranked: ranked });
        var reasons = [];
        if (temp >= 80 || (avgScore !== null && avgScore < 8)) {
          signal = 'STOP';
          if (temp >= 80) reasons.push('市场极热(温度' + temp + ')');
          if (avgScore !== null && avgScore < 8) reasons.push('评分极低(均分' + avgScore.toFixed(1) + ')');
        } else if (temp >= 65 || (avgScore !== null && avgScore < 12)) {
          signal = 'CAUTION';
          if (temp >= 65) reasons.push('市场偏热(温度' + temp + ')');
          if (avgScore !== null && avgScore < 12) reasons.push('评分偏低(均分' + avgScore.toFixed(1) + ')');
        } else {
          signal = 'GO';
        }
        reason = reasons.length > 0 ? reasons.join('，') : '市场正常';
      }

      var color, bgColor, emoji, title, subtitle;
      if (signal === 'STOP') {
        color = '#ef4444'; bgColor = 'rgba(239,68,68,0.12)';
        emoji = '🔴'; title = '今日建议观望';
        subtitle = todayPicks && (todayPicks.action === 'HARD_PAUSE' || todayPicks.action === 'PAUSE' || todayPicks.action === 'HOLD')
          ? '确定性风控要求今天不买；候选只作影子观察'
          : '当前条件未通过买入门槛';
      } else if (signal === 'CAUTION') {
        color = '#f97316'; bgColor = 'rgba(249,115,22,0.12)';
        emoji = '🟡'; title = todayPicks.action === 'TACTICAL_PAUSE' ? '仅核心小额定投' : '谨慎操作';
        subtitle = todayPicks.action === 'TACTICAL_PAUSE'
          ? 'TOP择时继续暂停，只向真实持仓中的低配核心桶投入' + Number(todayPicks.budget || 0) + '元'
          : '建议减半投入，控制风险';
      } else {
        card.style.display = 'none';
        return;
      }

      content.innerHTML = '<div style="padding:14px 16px;background:' + bgColor + ';border-radius:12px;border:1px solid ' + color + '30">'
        + '<div style="display:flex;align-items:center;gap:10px">'
        + '<span style="font-size:28px">' + emoji + '</span>'
        + '<div style="flex:1">'
        + '<div style="font-size:16px;font-weight:700;color:' + color + '">' + title + '</div>'
        + '<div style="font-size:12px;color:var(--text2);margin-top:2px">' + subtitle + '</div>'
        + (reason ? '<div style="font-size:11px;color:var(--text3);margin-top:4px">' + reason + '</div>' : '')
        + '</div>'
        + '<div style="text-align:right">'
        + '<div style="font-size:11px;color:var(--text3)">Top均分</div>'
        + '<div style="font-size:18px;font-weight:700;color:' + color + '">' + (avgScore !== null ? avgScore.toFixed(1) : '-') + '</div>'
        + '</div>'
        + '</div>'
        + '</div>';

      card.style.display = 'block';
    }

    // Today's picks
    function renderPicks() {
      var card = document.getElementById('picks-card');
      var content = document.getElementById('picks-content');
      if (!card || !content) return;
      if (!todayPicks || !todayPicks.ranked || todayPicks.ranked.length === 0) {
        card.style.display = 'none';
        return;
      }

      card.style.display = 'block';
      var html = '';

      // 市场温度只能解释风险，不能改变个性化计划金额。
      if (actionAllowsPurchase(todayPicks) && marketTemperature) {
        var mt = marketTemperature;
        var adjustedBudget = Number(todayPicks.budget || 0);
        var tempColor = mt.temperature <= 35 ? '#3b82f6' : (mt.temperature >= 65 ? '#ef4444' : '#22c55e');
