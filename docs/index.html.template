    function syncToServer() {
      // 合并 localStorage 和嵌入数据
      var embedded = { holdings: PORTFOLIO_HOLDINGS || [] };
      var local = portfolioData;
      var merged = { holdings: [], startDate: null };

      // 用 code 做 key 合并
      var allCodes = {};
      embedded.holdings.forEach(function(h) { allCodes[h.code] = JSON.parse(JSON.stringify(h)); });
      local.holdings.forEach(function(h) {
        if (!allCodes[h.code]) {
          allCodes[h.code] = JSON.parse(JSON.stringify(h));
        } else {
          // 合并 buys（去重：code+date+amount）
          var existingKeys = {};
          allCodes[h.code].buys.forEach(function(b) {
            existingKeys[b.date + '_' + b.amount] = true;
          });
          h.buys.forEach(function(b) {
            var key = b.date + '_' + b.amount;
            if (!existingKeys[key]) {
              allCodes[h.code].buys.push(b);
              existingKeys[key] = true;
            }
          });
        }
      });

      Object.keys(allCodes).forEach(function(code) {
        var h = allCodes[code];
        if (h.buys && h.buys.length > 0) {
          merged.holdings.push(h);
          h.buys.forEach(function(b) {
            if (!merged.startDate || b.date < merged.startDate) merged.startDate = b.date;
          });
        }
      });

      // 排序 buys
      merged.holdings.forEach(function(h) {
        h.buys.sort(function(a, b) { return a.date < b.date ? -1 : (a.date > b.date ? 1 : 0); });
      });

      portfolioData = merged;
      saveLocal();
      updateSummary();
      updateHoldings();
      showToast('数据已合并！共 ' + merged.holdings.length + ' 只基金');
    }

