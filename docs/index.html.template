        case '分散配置':
          conditions = { target: 5, stopLoss: -12, timeHorizon: 30 };
          break;
        default:
          conditions = { target: 8, stopLoss: -8, timeHorizon: 30 };
      }
      
      var h = {
        id: 'H' + Date.now(),
        fundCode: fundCode,
        fundName: fundName,
        type: type,
        thesis: thesis,
        conditions: conditions,
        status: 'active',
        createdAt: new Date().toISOString(),
