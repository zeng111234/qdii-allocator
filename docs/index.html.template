  <div class="footer">QDII Fund Allocator · 数据仅供参考，投资需谨慎</div>
  <div id="toast" class="toast"></div>

  <script>
    var portfolioData = PORTFOLIO_DATA;
    var PORTFOLIO_HOLDINGS = portfolioData.holdings || [];
    var fundsData = FUNDS_DATA;
    var navCacheData = NAV_CACHE_DATA;
    var dailyBriefData = DAILY_BRIEF_DATA;

    // 获取基金最新净值（兼容旧格式{nav}和新格式[{nav},{nav}]）
    function getLatestNav(code) {
      var cached = navCacheData[code];
      if (!cached) return null;
      if (Array.isArray(cached)) return cached[cached.length - 1];
      return cached;
    }
    // 获取基金前一日净值（仅新格式有）
    function getPrevNav(code) {
      var cached = navCacheData[code];
      if (!cached || !Array.isArray(cached) || cached.length < 2) return null;
      return cached[cached.length - 2]; // 倒数第2条
    }
    function getNavArray(code) {
      var cached = navCacheData[code];
      if (!cached || !Array.isArray(cached)) return null;
      return cached;
    }
    var externalSignalsData = EXTERNAL_SIGNALS_DATA;
    var newsData = NEWS_DATA;
    var todayPicks = TODAY_PICKS_DATA;
    var purchaseLimits = PURCHASE_LIMITS_DATA;
    var tradingHolidays = TRADING_HOLIDAYS_DATA;
    var hypothesesData = HYPOTHESES_DATA;

    // 隐私模式
    function togglePrivacy() {
      var isOn = document.body.classList.toggle('privacy-mode');
      localStorage.setItem('qdii-privacy', isOn ? '1' : '0');
      var btn = document.getElementById('privacy-toggle');
      btn.textContent = isOn ? '🙈 隐藏' : '👁️ 显示';
    }
    // 初始化隐私模式
    if (localStorage.getItem('qdii-privacy') === '1') {
      document.body.classList.add('privacy-mode');
      setTimeout(function() {
        var btn = document.getElementById('privacy-toggle');
        if (btn) btn.textContent = '🙈 隐藏';
      }, 100);
    }

    function showToast(text, isError) {
      var el = document.getElementById("toast");
      el.textContent = text;
      el.className = "toast show " + (isError ? "error" : "success");
      setTimeout(function() { el.className = "toast"; }, 2500);
    }

    function switchTab(tab) {
      document.querySelectorAll('.tab').forEach(function(t) { t.classList.remove('active'); });
      document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.remove('active'); });
      var tabs = ['portfolio', 'buy', 'batch', 'insights', 'risk', 'ranking', 'debate', 'shadow', 'ai'];
      var idx = tabs.indexOf(tab);
      document.querySelectorAll('.tab')[idx].classList.add('active');
      document.getElementById('tab-' + tab).classList.add('active');
      if (tab === 'insights') renderInsights();
      if (tab === 'risk') renderRiskDashboard();
      if (tab === 'ranking') renderRanking();
      if (tab === 'debate') renderDebate();
      if (tab === 'shadow') renderShadow();
      if (tab === 'batch' && !document.getElementById('batchDate').value) {
        document.getElementById('batchDate').value = new Date().toISOString().slice(0, 10);
        if (!document.getElementById('batchList').children.length) addBatchRow();
      }
    }

    function calcSummary() {
      var totalInv = 0, totalVal = 0, pendingInv = 0;
      var totalValPrev = 0;
      var latestDate = '', prevDate = '';
      // 找大多数基金共有的最新净值日期（而不是所有基金中最晚的）
      var dateCount = {};
      var dateLatest = {};
      portfolioData.holdings.forEach(function(h) {
        var latest = getLatestNav(h.code);
        if (latest) {
          dateCount[latest.date] = (dateCount[latest.date] || 0) + 1;
          if (!dateLatest[latest.date] || latest.date > dateLatest[latest.date]) {
            dateLatest[latest.date] = latest.date;
          }
        }
      });
      // 选出现次数最多的日期作为基准（出现次数相同则选较晚的）
      var baseDate = '', maxCount = 0;
      Object.keys(dateCount).sort().forEach(function(d) {
        if (dateCount[d] > maxCount || (dateCount[d] === maxCount && d > baseDate)) {
          maxCount = dateCount[d]; baseDate = d;
        }
      });
      latestDate = baseDate;
      // 找基准日期的前一天
      portfolioData.holdings.forEach(function(h) {
        if (prevDate) return;
        var arr = getNavArray(h.code);
        if (arr) {
          for (var i = 0; i < arr.length; i++) {
            if (arr[i].date === baseDate && i > 0) { prevDate = arr[i-1].date; return; }
          }
        }
      });
      // 计算市值和日盈亏
      portfolioData.holdings.forEach(function(h) {
        var latest = getLatestNav(h.code);
        var navNow = latest ? latest.nav : 0;
        var navPrev = 0;
        // 只有净值日期 == 基准日期的基金才算日盈亏
        if (latest && latest.date === baseDate && prevDate) {
          var arr = getNavArray(h.code);
          if (arr) {
            for (var i = 0; i < arr.length; i++) {
              if (arr[i].date === prevDate) { navPrev = arr[i].nav; break; }
            }
          }
        }
        h.buys.forEach(function(b) {
          totalInv += b.amount;
          if (b.shares && b.shares > 0 && navNow > 0) {
            totalVal += b.shares * navNow;
            totalValPrev += navPrev > 0 ? b.shares * navPrev : b.shares * navNow;
          } else if (b.nav && b.nav > 0 && navNow > 0) {
            totalVal += b.amount * (navNow / b.nav);
            totalValPrev += navPrev > 0 ? b.amount * (navPrev / b.nav) : b.amount * (navNow / b.nav);
          } else {
            totalVal += b.amount;
            totalValPrev += b.amount;
            pendingInv += b.amount;
          }
        });
      });
      var pnl = Math.round((totalVal - totalInv) * 100) / 100;
      var todayPnl = Math.round((totalVal - totalValPrev) * 100) / 100;
      var hasPrevData = false;
      portfolioData.holdings.forEach(function(h) { if (getPrevNav(h.code)) hasPrevData = true; });
      // 生成日期标签：最新净值日期 vs 前一交易日
      var pnlLabel = '日盈亏';
      if (latestDate && prevDate) {
        var today = new Date().toISOString().slice(0,10);
        var parts = latestDate.split('-');
        var shortDate = parseInt(parts[1]) + '/' + parseInt(parts[2]);
        if (latestDate === today) {
          pnlLabel = '今日盈亏';
        } else {
          pnlLabel = shortDate + '盈亏';
        }
      }
      return {
        invested: Math.round(totalInv * 100) / 100,
        pending: Math.round(pendingInv * 100) / 100,
        value: Math.round(totalVal * 100) / 100,
        pnl: pnl,
        todayPnl: todayPnl,
        hasPrevData: hasPrevData,
        pnlLabel: pnlLabel,
        latestDate: latestDate,
        count: portfolioData.holdings.length
      };
    }

    function updateSummary() {
      var s = calcSummary();
      var cls = s.pnl >= 0 ? 'positive' : 'negative';
      var sign = s.pnl >= 0 ? '+' : '';
      var todayCls = s.todayPnl >= 0 ? 'positive' : 'negative';
      var todaySign = s.todayPnl >= 0 ? '+' : '';
      var todayStr = s.hasPrevData ? (todaySign + s.todayPnl) : '--';
      document.getElementById('summary').innerHTML =
        '<div class="summary-item"><div class="label">总投入</div><div class="value">' + s.invested + '</div></div>' +
        '<div class="summary-item"><div class="label">当前市值</div><div class="value">' + s.value + '</div></div>' +
        '<div class="summary-item"><div class="label">总盈亏</div><div class="value ' + cls + '">' + sign + s.pnl + '</div></div>' +
        '<div class="summary-item"><div class="label">' + s.pnlLabel + '</div><div class="value ' + todayCls + '">' + todayStr + '</div></div>' +
        '<div class="summary-item"><div class="label">持仓</div><div class="value">' + s.count + '只</div></div>' +
        '<div class="summary-item"><div class="label">净值日期</div><div class="value" style="font-size:12px">' + (s.latestDate || '--') + '</div></div>';

      // 渲染收益曲线图
      renderPortfolioChart();
    }

    function renderPortfolioChart() {
      if (typeof LightweightCharts === 'undefined') return;
      var holdings = portfolioData.holdings || [];
      if (holdings.length === 0) return;

      // 收集所有有净值数据的日期
      var allDates = {};
      holdings.forEach(function(h) {
        var arr = navCacheData[h.code];
        if (!arr || !Array.isArray(arr)) return;
        arr.forEach(function(n) { allDates[n.date] = true; });
      });
      var dates = Object.keys(allDates).sort();
      if (dates.length < 3) return;

      // 计算每天的组合总市值和累计投入
      var rawData = [];
      dates.forEach(function(date) {
        var totalVal = 0, totalInv = 0, hasData = false;
        holdings.forEach(function(h) {
          var arr = navCacheData[h.code];
          if (!arr || !Array.isArray(arr)) return;
          var navOnDate = null;
          for (var i = 0; i < arr.length; i++) {
            if (arr[i].date <= date) navOnDate = arr[i].nav;
            if (arr[i].date > date) break;
          }
          if (!navOnDate) return;
          hasData = true;
          h.buys.forEach(function(b) {
            if (b.date <= date) totalInv += b.amount;
            if (b.date > date) return;
            if (b.shares && b.shares > 0) {
              totalVal += b.shares * navOnDate;
            } else if (b.nav && b.nav > 0) {
              totalVal += b.amount * (navOnDate / b.nav);
            } else {
              totalVal += b.amount;
            }
          });
        });
        if (hasData && totalVal > 0) {
          rawData.push({ date: date, val: totalVal, inv: totalInv });
        }
      });

      if (rawData.length < 3) return;

      // 转换为收益率百分比：(市值 - 投入) / 投入 * 100
      var pctData = [];
      rawData.forEach(function(d) {
        if (d.inv > 0) {
          var ts = Math.floor(new Date(d.date + 'T00:00:00').getTime() / 1000);
          var pct = Math.round((d.val - d.inv) / d.inv * 10000) / 100;
          pctData.push({ time: ts, value: pct });
        }
      });

      if (pctData.length < 3) return;

      var wrapper = document.getElementById('chart-wrapper');
      wrapper.style.display = 'block';
      var container = document.getElementById('portfolioChart');
      container.innerHTML = '';

      if (window._portfolioChart) { window._portfolioChart.remove(); window._portfolioChart = null; }

      var lastPct = pctData[pctData.length - 1].value;
      var isPositive = lastPct >= 0;
      var lineColor = isPositive ? '#22c55e' : '#ef4444';

      var chart = LightweightCharts.createChart(container, {
        width: container.clientWidth,
        height: 180,
        layout: {
          background: { type: 'solid', color: 'transparent' },
          textColor: '#94a3b8',
          fontSize: 11,
          attributionLogo: false
        },
        grid: {
          vertLines: { visible: false },
          horzLines: { color: 'rgba(0,0,0,0.04)' }
        },
        crosshair: {
          mode: LightweightCharts.CrosshairMode.Normal,
          vertLine: { color: 'rgba(0,0,0,0.15)', width: 1, style: 0, labelBackgroundColor: '#6366f1' },
          horzLine: { color: 'rgba(0,0,0,0.15)', width: 1, style: 0, labelBackgroundColor: '#6366f1' }
        },
        rightPriceScale: {
          borderColor: 'rgba(0,0,0,0.06)',
          scaleMargins: { top: 0.1, bottom: 0.1 }
        },
        timeScale: {
          borderColor: 'rgba(0,0,0,0.06)',
          timeVisible: false,
          secondsVisible: false
        },
        handleScroll: false,
        handleScale: false
      });

      // 面积图：盈利区域填充
      var areaSeries = chart.addAreaSeries({
        topColor: isPositive ? 'rgba(34,197,94,0.3)' : 'rgba(239,68,68,0.3)',
        bottomColor: isPositive ? 'rgba(34,197,94,0.02)' : 'rgba(239,68,68,0.02)',
        lineColor: lineColor,
        lineWidth: 2,
        crosshairMarkerBackgroundColor: lineColor,
        crosshairMarkerRadius: 4
      });
      areaSeries.setData(pctData);

      // 0% 基准线（盈亏分界）
      var zeroSeries = chart.addLineSeries({
        color: 'rgba(148,163,184,0.4)',
        lineWidth: 1,
        lineStyle: 0,
        crosshairMarkerVisible: false,
        priceLineVisible: false
      });
      zeroSeries.setData(pctData.map(function(d) { return { time: d.time, value: 0 }; }));

      chart.timeScale().fitContent();
      window.addEventListener('resize', function() {
        chart.applyOptions({ width: container.clientWidth });
      });

      window._portfolioChart = chart;

      // 图例
      var legend = document.getElementById('chart-legend');
      if (!legend) {
        legend = document.createElement('div');
        legend.id = 'chart-legend';
        legend.style.cssText = 'display:flex;gap:16px;justify-content:center;margin-top:6px;font-size:11px;color:var(--text3)';
        container.parentNode.insertBefore(legend, container.nextSibling);
      }
      legend.innerHTML = '<span><span style="display:inline-block;width:16px;height:2px;background:' + lineColor + ';vertical-align:middle;margin-right:4px"></span>收益率 ' + (lastPct >= 0 ? '+' : '') + lastPct + '%</span>' +
        '<span><span style="display:inline-block;width:16px;height:0;border-top:1px solid rgba(148,163,184,0.4);vertical-align:middle;margin-right:4px"></span>盈亏线 0%</span>';
    }

    function updateHoldings() {
      var c = document.getElementById('holdings');
      if (!portfolioData.holdings.length) {
        c.innerHTML = '<div class="empty">📭 暂无持仓</div>';
        return;
      }
      var html = '';
      var grandInv = 0, grandVal = 0;
      portfolioData.holdings.forEach(function(h, i) {
        var inv = h.buys.reduce(function(s, b) { return s + b.amount; }, 0);
        var navNow = 0;
        if (navCacheData[h.code]) {
          var latest = getLatestNav(h.code);
          navNow = latest ? latest.nav : 0;
        }
        // 计算市值：和 calcSummary 一致
        var val = 0;
        h.buys.forEach(function(b) {
          if (b.shares && b.shares > 0 && navNow > 0) {
            val += b.shares * navNow;
          } else if (b.nav && b.nav > 0 && navNow > 0) {
            val += b.amount * (navNow / b.nav);
          } else {
            val += b.amount;
          }
        });
        var pnl = val - inv;
        var pnlPct = inv > 0 ? (pnl / inv * 100) : 0;
        var cls = pnl >= 0 ? 'positive' : 'negative';
        var sign = pnl >= 0 ? '+' : '';
        var fund = fundsData.funds.find(function(f) { return f.code === h.code; });
        var limit = fund && fund.dailyLimit && fund.dailyLimit < 10000 ? '限' + fund.dailyLimit + '元' : '';
        grandInv += inv;
        grandVal += val;

        html += '<div class="holding-row" onclick="toggleDetail(' + i + ')">';
        html += '<div class="holding-top">';
        html += '<div><span class="holding-name">' + h.name + '</span><span class="holding-code">' + h.code + '</span></div>';
        html += '<div class="holding-pnl"><div class="amount ' + cls + '">' + sign + pnl.toFixed(2) + '</div>';
        html += '<div class="rate ' + cls + '">' + sign + pnlPct.toFixed(2) + '%</div></div>';
        html += '</div>';
        html += '<div class="holding-meta"><span>投入 ' + inv + '元</span><span>' + h.buys.length + '笔</span>';
        if (limit) html += '<span>' + limit + '</span>';
        html += '</div>';
        html += '<div class="detail" id="detail-' + i + '">';
        h.buys.forEach(function(b) {
          html += '<div class="detail-row"><span>' + b.date + ' 买入' + b.amount + '元</span>';
          html += '<span>' + (b.nav ? '净值' + b.nav : '待确认') + '</span></div>';
        });
        html += '</div></div>';
      });
      // 底部汇总：和顶部 summary 交叉验证
      var grandPnl = grandVal - grandInv;
      var gpCls = grandPnl >= 0 ? 'positive' : 'negative';
      var gpSign = grandPnl >= 0 ? '+' : '';
      html += '<div style="padding:12px 0 4px;border-top:2px solid var(--border);display:flex;justify-content:space-between;font-size:13px;font-weight:600">';
      html += '<span>合计 ' + portfolioData.holdings.length + '只</span>';
      html += '<span>投入 ' + grandInv.toFixed(2) + ' · 市值 ' + grandVal.toFixed(2) + ' · <span class="' + gpCls + '">盈亏 ' + gpSign + grandPnl.toFixed(2) + '</span></span>';
      html += '</div>';
      c.innerHTML = html;
    }

    function toggleDetail(idx) {
      var el = document.getElementById('detail-' + idx);
      el.style.display = el.style.display === 'none' ? 'block' : 'none';
    }

    function extractCorp(name) {
      var m = name.match(/^(广发|易方达|华泰柏瑞|华夏|南方|华安|嘉实|大成|博时|工银|天弘|富国|银华|万家|摩根|国泰|汇添富|鹏华|建信|诺安|融通|景顺长城|浦银安盛)/);
      return m ? m[1] : name.substring(0, 2);
    }

    function buildFundOptions() {
      var active = fundsData.funds.filter(function(f) { return f.status === 'active'; });
      var grouped = {};
      active.forEach(function(f) {
        var corp = extractCorp(f.name);
        if (!grouped[corp]) grouped[corp] = [];
        grouped[corp].push(f);
      });
      var html = '<option value="">-- 选择基金 --</option>';
      Object.keys(grouped).sort().forEach(function(corp) {
        html += '<optgroup label="' + corp + '">';
        grouped[corp].forEach(function(f) {
          var lim = f.dailyLimit && f.dailyLimit < 10000 ? ' (限' + f.dailyLimit + ')' : '';
          html += '<option value="' + f.code + '">' + f.code + ' ' + f.name + lim + '</option>';
        });
        html += '</optgroup>';
      });
      return html;
    }

    function loadFundOptions() {
      document.getElementById('fundSelect').innerHTML = buildFundOptions();
    }

    function addBuy() {
      var code = document.getElementById('fundSelect').value;
      var amount = parseFloat(document.getElementById('amount').value);
      var nav = document.getElementById('nav').value ? parseFloat(document.getElementById('nav').value) : null;
      var date = document.getElementById('buyDate').value || new Date().toISOString().slice(0, 10);
      if (!code) { showToast('请选择基金', true); return; }
      if (!amount || amount <= 0) { showToast('请输入金额', true); return; }
      var fund = fundsData.funds.find(function(f) { return f.code === code; });
      var holding = portfolioData.holdings.find(function(h) { return h.code === code; });
      if (!holding) { holding = { code: code, name: fund ? fund.name : code, buys: [] }; portfolioData.holdings.push(holding); }
      holding.buys.push({ date: date, amount: amount, nav: nav, shares: nav ? Math.round(amount / nav * 10000) / 10000 : null, settleDate: null });
      if (!portfolioData.startDate || date < portfolioData.startDate) portfolioData.startDate = date;
      updateSummary(); updateHoldings(); saveLocal();
      showToast('买入 ' + holding.name + ' ' + amount + '元');
      // Auto-sync to Firebase
      syncSave();
      // Auto-create hypothesis
      var hType = amount >= 50 ? '趋势跟踪' : '均值回归';
      var hThesis = '买入 ' + holding.name + ' ' + amount + '元，预期' + (hType === '趋势跟踪' ? '趋势延续' : '超跌反弹');
      createHypothesisLocal(code, holding.name, hType, hThesis);
      document.getElementById('buyResult').innerHTML = '<div style="background:#f0fdf4;border:1px solid #86efac;border-radius:8px;padding:10px;font-size:12px">✅ 已保存 · 已创建投资假设</div>';
    }

    // Batch
    function addBatchRow() {
      var list = document.getElementById('batchList');
      var row = document.createElement('div');
      row.className = 'batch-row';
      row.innerHTML = '<select class="batch-fund">' + buildFundOptions() + '</select>' +
        '<input type="number" class="batch-amount" min="1" step="0.01" value="10" placeholder="金额">' +
        '<button class="del" onclick="if(this.closest(\'.batch-row\').parentNode.children.length>1)this.closest(\'.batch-row\').remove()">×</button>';
      list.appendChild(row);
    }
    function submitBatch() {
      var date = document.getElementById('batchDate').value;
      var rows = document.querySelectorAll('.batch-row');
      var items = [];
      rows.forEach(function(row) {
        var code = row.querySelector('.batch-fund').value;
        var amount = parseFloat(row.querySelector('.batch-amount').value);
        if (code && amount > 0) items.push({ code: code, amount: amount });
      });
      if (!items.length) { showToast('请添加记录', true); return; }
      items.forEach(function(item) {
        var fund = fundsData.funds.find(function(f) { return f.code === item.code; });
        var holding = portfolioData.holdings.find(function(h) { return h.code === item.code; });
        if (!holding) { holding = { code: item.code, name: fund ? fund.name : item.code, buys: [] }; portfolioData.holdings.push(holding); }
        holding.buys.push({ date: date, amount: item.amount, nav: null, shares: null, settleDate: null });
        if (!portfolioData.startDate || date < portfolioData.startDate) portfolioData.startDate = date;
      });
      updateSummary(); updateHoldings(); saveLocal();
      syncSave();
      showToast('批量添加 ' + items.length + ' 笔');
      document.getElementById('batchList').innerHTML = '';
      addBatchRow();
    }

    // Insights
    function renderInsights() {
      var c = document.getElementById('insights-content');
      var html = '';

      // Health
      html += '<div class="card-title" style="margin-top:4px">组合健康度</div>';
      var typeW = {}, totalInv = 0;
      portfolioData.holdings.forEach(function(h) {
        var fund = fundsData.funds.find(function(f) { return f.code === h.code; });
        var type = fund ? fund.type : '其他';
        var inv = h.buys.reduce(function(s, b) { return s + b.amount; }, 0);
        typeW[type] = (typeW[type] || 0) + inv;
        totalInv += inv;
      });
      Object.keys(typeW).sort(function(a, b) { return typeW[b] - typeW[a]; }).forEach(function(t) {
        var pct = totalInv > 0 ? Math.round(typeW[t] / totalInv * 100) : 0;
        var color = pct > 50 ? 'var(--danger)' : (pct > 30 ? 'var(--warn)' : 'var(--success)');
        html += '<div class="type-bar"><div class="label-row"><span>' + t + '</span><span style="font-weight:600">' + pct + '%</span></div>';
        html += '<div class="bar-bg"><div class="bar-fill" style="width:' + pct + '%;background:' + color + '"></div></div></div>';
      });
      var maxPct = totalInv > 0 ? Math.round(Math.max.apply(null, Object.values(typeW)) / totalInv * 100) : 0;
      var health = maxPct > 70 ? 50 : (maxPct > 50 ? 70 : 85);
      var hColor = health >= 80 ? '#f0fdf4' : '#fefce8';
      var hText = health >= 80 ? '🟢 分散良好' : '🟡 建议增加非美股配置';
      html += '<div style="padding:10px;background:' + hColor + ';border-radius:8px;font-size:13px;margin-top:4px">健康度 <strong>' + health + '/100</strong> · ' + hText + '</div>';

      // Backtest (dynamic from nav-cache data)
      html += '<div class="card-title" style="margin-top:18px">📈 走步回测验证</div>';
      html += '<div id="backtest-content"><div style="text-align:center;padding:10px;color:var(--text3)">正在加载回测数据...</div></div>';
      html += '<div style="font-size:11px;color:var(--text3)">训练120天→测试30天 · 受 <a href="https://github.com/HKUDS/Vibe-Trading" target="_blank" style="color:var(--primary)">Vibe-Trading</a> 启发</div>';

      // Performance Attribution
      html += '<div class="card-title" style="margin-top:18px">📊 业绩归因</div>';
      html += '<div id="attribution-content"><div style="text-align:center;padding:10px;color:var(--text3)">正在计算...</div></div>';

      // Hypotheses (from embedded data)
      html += '<div class="card-title" style="margin-top:18px">📝 假设追踪</div>';
      var hypData = typeof hypothesesData !== 'undefined' && hypothesesData ? hypothesesData : loadHypothesesLocal();
      if (!hypData || !hypData.hypotheses || hypData.hypotheses.length === 0) {
        html += '<div style="font-size:13px;color:var(--text3);line-height:1.7">暂无投资假设。在买入基金时，系统会自动创建投资假设并追踪收益。</div>';
      } else {
        var activeHyps = hypData.hypotheses.filter(function(h) { return h.status === 'active'; });
        var closedHyps = hypData.hypotheses.filter(function(h) { return h.status !== 'active'; });
        var validated = closedHyps.filter(function(h) { return h.status === 'validated'; });
        var winRate = closedHyps.length > 0 ? Math.round(validated.length / closedHyps.length * 100) : null;
        var winRateDisplay = winRate !== null ? winRate + '% (' + closedHyps.length + '个)' : '样本不足';
        html += '<div class="insight-grid">';
        html += '<div class="insight-stat blue"><div class="label">活跃假设</div><div class="value">' + activeHyps.length + '</div></div>';
        html += '<div class="insight-stat green"><div class="label">已验证</div><div class="value">' + validated.length + '</div></div>';
        html += '<div class="insight-stat ' + (winRate !== null && winRate >= 50 ? 'green' : 'red') + '"><div class="label">胜率</div><div class="value">' + winRateDisplay + '</div></div>';
        html += '</div>';
        activeHyps.slice(0, 5).forEach(function(h) {
          var ret3d = h.followUpReturns && h.followUpReturns['3d'] !== null ? h.followUpReturns['3d'] + '%' : 'N/A';
          var ret7d = h.followUpReturns && h.followUpReturns['7d'] !== null ? h.followUpReturns['7d'] + '%' : 'N/A';
          var emoji = h.type === '趋势跟踪' ? '📈' : (h.type === '均值回归' ? '📉' : (h.type === '稀缺溢价' ? '💎' : '📊'));
          html += '<div style="padding:8px 0;border-bottom:1px solid var(--border);font-size:12px">';
          html += '<div>' + emoji + ' <strong>' + h.fundName + '</strong> <span style="color:var(--text3)">(' + h.type + ')</span></div>';
          html += '<div style="color:var(--text2);margin-top:2px">' + h.thesis + '</div>';
          html += '<div style="color:var(--text3);margin-top:2px">3日: ' + ret3d + ' · 7日: ' + ret7d + '</div>';
          html += '</div>';
        });
      }

      // Goal Tracker (from localStorage)
      html += '<div class="card-title" style="margin-top:18px">🎯 投资目标</div>';
      var goalsData = loadGoalsLocal();
      if (goalsData.goals.length === 0) {
        html += '<div style="font-size:13px;color:var(--text3);line-height:1.7">暂未设定投资目标。</div>';
        html += '<div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">';
        html += '<button class="btn" style="background:#f0f4ff;color:#6366f1;border:1px solid #c7d2fe;font-size:11px;padding:6px 10px" onclick="addGoal(\'return\')">+ 年化收益目标</button>';
        html += '<button class="btn" style="background:#f0f4ff;color:#6366f1;border:1px solid #c7d2fe;font-size:11px;padding:6px 10px" onclick="addGoal(\'risk\')">+ 最大回撤控制</button>';
        html += '<button class="btn" style="background:#f0f4ff;color:#6366f1;border:1px solid #c7d2fe;font-size:11px;padding:6px 10px" onclick="addGoal(\'streak\')">+ 连续定投天数</button>';
        html += '</div>';
      } else {
        html += '<div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap">';
        html += '<button class="btn" style="background:#f0f4ff;color:#6366f1;border:1px solid #c7d2fe;font-size:11px;padding:4px 8px" onclick="addGoal(\'return\')">+ 收益目标</button>';
        html += '<button class="btn" style="background:#f0f4ff;color:#6366f1;border:1px solid #c7d2fe;font-size:11px;padding:4px 8px" onclick="addGoal(\'risk\')">+ 回撤控制</button>';
        html += '</div>';
        goalsData.goals.forEach(function(g, idx) {
          var progress = g.target > 0 ? Math.min(Math.round(Math.abs(g.current || 0) / Math.abs(g.target) * 100), 100) : 0;
          var pColor = progress >= 100 ? 'var(--success)' : (progress >= 50 ? 'var(--primary)' : 'var(--warn)');
          var statusEmoji = g.status === 'completed' ? '✅' : (g.status === 'abandoned' ? '❌' : '🔄');
          html += '<div style="padding:10px;background:var(--bg);border-radius:8px;margin-bottom:8px">';
          html += '<div style="display:flex;justify-content:space-between;align-items:center">';
          html += '<div>' + statusEmoji + ' <strong>' + g.title + '</strong></div>';
          html += '<span style="font-size:11px;color:#ef4444;cursor:pointer" onclick="deleteGoal(' + idx + ')">×</span>';
          html += '</div>';
          html += '<div style="font-size:12px;color:var(--text2);margin-top:4px">目标: ' + g.target + g.unit + ' · 当前: ' + (g.current || 0) + g.unit + '</div>';
          html += '<div style="background:var(--border);border-radius:4px;height:6px;margin-top:6px">';
          html += '<div style="background:' + pColor + ';border-radius:4px;height:6px;width:' + progress + '%"></div>';
          html += '</div>';
          html += '<div style="font-size:11px;color:var(--text3);margin-top:2px;text-align:right">' + progress + '%</div>';
          html += '</div>';
        });
      }

      // News & Sentiment
      html += '<div class="card-title" style="margin-top:18px">📰 新闻与情绪 <button onclick="refreshNews()" style="float:right;padding:3px 10px;font-size:11px;border:1px solid var(--border);border-radius:6px;background:white;cursor:pointer;color:var(--text2)">🔄 刷新新闻</button></div>';
      html += '<div id="news-sentiment-content"><div style="text-align:center;padding:10px;color:var(--text3)">正在加载最新新闻...</div></div>';

      // New Funds (collapsed)
      var newFunds = fundsData.funds.filter(function(f) { return ['007280','008763','539003','000369'].indexOf(f.code) >= 0; });
      if (newFunds.length > 0) {
        html += '<details style="margin-top:18px"><summary style="font-size:13px;font-weight:600;color:var(--text2);cursor:pointer;padding:6px 0">📋 最新加入基金池 <span style="font-size:11px;color:var(--text3)">(' + newFunds.length + '只)</span></summary>';
        newFunds.forEach(function(f) {
          var lim = f.dailyLimit < 10000 ? '限' + f.dailyLimit + '元' : '不限';
          html += '<div class="fund-chip"><div><strong>' + f.name + '</strong><div style="font-size:11px;color:var(--text3)">' + f.type + ' · ' + lim + '</div></div><span class="chip-code">' + f.code + '</span></div>';
