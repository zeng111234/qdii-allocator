    function runBacktest() {
      loadFullNavCache(function(fullNav) {
        var el = document.getElementById('backtest-content');
        var attrEl = document.getElementById('attribution-content');
        if (!fullNav) {
          el.innerHTML = '<div style="color:var(--text3);font-size:12px">无法加载净值历史数据</div>';
          if (attrEl) attrEl.innerHTML = '<div style="color:var(--text3);font-size:12px">无法加载净值历史数据</div>';
          return;
        }

        // Walk-forward backtest simulation
        // Use portfolio's fund codes, simulate equal-weight allocation
        var codes = portfolioData.holdings.map(function(h) { return h.code; });
        if (codes.length === 0) {
          el.innerHTML = '<div style="color:var(--text3);font-size:12px">暂无持仓，无法回测</div>';
          return;
        }

        // Get aligned date series
        var allDates = {};
        codes.forEach(function(code) {
          if (fullNav[code]) {
            fullNav[code].forEach(function(n) { allDates[n.date] = true; });
          }
        });
        var dates = Object.keys(allDates).sort();
        if (dates.length < 60) {
          el.innerHTML = '<div style="color:var(--text3);font-size:12px">净值数据不足60天（当前' + dates.length + '天），暂无法回测</div>';
          return;
        }

        // Build NAV matrix
        var navMatrix = {};
        codes.forEach(function(code) {
          navMatrix[code] = {};
          if (fullNav[code]) {
            fullNav[code].forEach(function(n) { navMatrix[code][n.date] = n.nav; });
          }
        });

        // Walk-forward: train 120 days, test 30 days, slide forward
        // 数据不足时降级：最少需要60天（训练45天+测试15天）
        var trainDays = 120, testDays = 30;
        if (dates.length < 150) {
          trainDays = 45;
          testDays = 15;
        }
        var windows = [];
        var startIdx = 0;
        while (startIdx + trainDays + testDays <= dates.length) {
          var trainDates = dates.slice(startIdx, startIdx + trainDays);
          var testDates = dates.slice(startIdx + trainDays, startIdx + trainDays + testDays);

          // 训练期：计算每只基金的收益，选出 Top N
          var trainReturns = {};
          codes.forEach(function(code) {
            var startNav = navMatrix[code][trainDates[0]];
            var endNav = navMatrix[code][trainDates[trainDates.length - 1]];
            if (startNav && endNav) {
              trainReturns[code] = (endNav - startNav) / startNav;
            }
          });
          // 按训练期收益排序，选前 5 只（策略选择）
          var sortedCodes = codes.filter(function(c) { return trainReturns[c] !== undefined; })
            .sort(function(a, b) { return trainReturns[b] - trainReturns[a]; });
          var topN = sortedCodes.slice(0, Math.min(5, sortedCodes.length));
          // 随机选 5 只作为对照组（用确定性种子：取中间的基金）
          var midN = sortedCodes.slice(Math.floor(sortedCodes.length / 2), Math.floor(sortedCodes.length / 2) + Math.min(5, sortedCodes.length));
          // 等权全仓
          var allCodes = sortedCodes.length > 0 ? sortedCodes : codes;

          // 测试期：分别计算 Top5、中间5、全仓的表现
          function calcTestReturn(selectedCodes) {
            var ret = 0, cnt = 0;
            selectedCodes.forEach(function(code) {
              var s = navMatrix[code][testDates[0]];
              var e = navMatrix[code][testDates[testDates.length - 1]];
              if (s && e) { ret += (e - s) / s; cnt++; }
            });
            return cnt > 0 ? ret / cnt * 100 : 0;
          }
          var testReturn = calcTestReturn(topN);
          var midReturn = calcTestReturn(midN);
          var allReturn = calcTestReturn(allCodes);

          windows.push({
            trainStart: trainDates[0],
            trainEnd: trainDates[trainDates.length - 1],
            testStart: testDates[0],
            testEnd: testDates[testDates.length - 1],
            testReturn: Math.round(testReturn * 100) / 100,
            midReturn: Math.round(midReturn * 100) / 100,
            allReturn: Math.round(allReturn * 100) / 100,
            excessReturn: Math.round((testReturn - allReturn) * 100) / 100
          });

          startIdx += testDays;
        }

        if (windows.length === 0) {
          el.innerHTML = '<div style="color:var(--text3);font-size:12px">数据不足，无法生成回测窗口</div>';
          return;
        }

        // 至少需要3个窗口才能计算有意义的胜率
        if (windows.length < 3) {
          el.innerHTML = '<div style="color:var(--text3);font-size:12px">净值数据不足，仅生成 ' + windows.length + ' 个回测窗口（至少需要3个）。请等待更多数据积累后查看。</div>';
          return;
        }

        // Calculate stats
        var wins = windows.filter(function(w) { return w.testReturn > 0; });
        var winRate = Math.round(wins.length / windows.length * 100);
        var totalReturn = windows.reduce(function(s, w) { return s + w.testReturn; }, 0);
        var best = Math.max.apply(null, windows.map(function(w) { return w.testReturn; }));
        var worst = Math.min.apply(null, windows.map(function(w) { return w.testReturn; }));
        var avgReturn = Math.round(totalReturn / windows.length * 100) / 100;

        // 中间组和全仓组的统计
        var midTotal = windows.reduce(function(s, w) { return s + w.midReturn; }, 0);
        var midAvg = Math.round(midTotal / windows.length * 100) / 100;
        var allTotal = windows.reduce(function(s, w) { return s + w.allReturn; }, 0);
        var allAvg = Math.round(allTotal / windows.length * 100) / 100;
        var excessTotal = windows.reduce(function(s, w) { return s + w.excessReturn; }, 0);
        var excessAvg = Math.round(excessTotal / windows.length * 100) / 100;

        var html2 = '<div class="insight-grid">';
        html2 += '<div class="insight-stat ' + (winRate >= 50 ? 'green' : 'red') + '"><div class="label">Top5 胜率</div><div class="value">' + winRate + '%</div></div>';
        html2 += '<div class="insight-stat ' + (excessAvg >= 0 ? 'green' : 'red') + '"><div class="label">超额收益</div><div class="value">' + (excessAvg >= 0 ? '+' : '') + excessAvg + '%</div></div>';
        html2 += '<div class="insight-stat ' + (totalReturn >= 0 ? 'blue' : 'red') + '"><div class="label">Top5 累计</div><div class="value">' + (totalReturn >= 0 ? '+' : '') + Math.round(totalReturn * 100) / 100 + '%</div></div>';
        html2 += '<div class="insight-stat ' + (allTotal >= 0 ? 'blue' : 'red') + '"><div class="label">全仓累计</div><div class="value">' + (allTotal >= 0 ? '+' : '') + Math.round(allTotal * 100) / 100 + '%</div></div>';
        html2 += '</div>';
        html2 += '<div style="font-size:11px;color:var(--text3);margin-top:4px">' + windows.length + '个窗口 · Top5均值 ' + avgReturn + '% · 全仓均值 ' + allAvg + '% · 超额 ' + (excessAvg >= 0 ? '+' : '') + excessAvg + '%</div>';

        // Overfitting detection: compare train vs test
        var avgTrainReturn = 0;
        windows.forEach(function(w) {
          var trainRet = 0, tc = 0;
          codes.forEach(function(code) {
            var s = navMatrix[code][w.trainStart];
            var e = navMatrix[code][w.trainEnd];
            if (s && e) { trainRet += (e - s) / s; tc++; }
          });
          if (tc > 0) avgTrainReturn += trainRet / tc * 100;
        });
        avgTrainReturn = avgTrainReturn / windows.length;
        var overfitGap = Math.round((avgTrainReturn - avgReturn) * 100) / 100;
        var overfitRisk = overfitGap > 10 ? '🔴 高过拟合风险' : (overfitGap > 5 ? '🟡 中度过拟合风险' : '🟢 低过拟合风险');
        html2 += '<div style="padding:8px;background:' + (overfitGap > 10 ? 'var(--state-red-bg)' : 'var(--state-green-bg)') + ';border-radius:6px;font-size:12px;margin-top:8px">';
        html2 += '过拟合检测: 训练均值 ' + Math.round(avgTrainReturn * 100) / 100 + '% vs 测试均值 ' + avgReturn + '% · 差距 ' + overfitGap + '% · ' + overfitRisk;
        html2 += '</div>';

        el.innerHTML = html2;

        // Performance Attribution
        runAttribution(navMatrix, codes, dates);
      });
    }

    function runAttribution(navMatrix, codes, dates) {
      var el = document.getElementById('attribution-content');
      if (!el) return;

      var attributions = [];
      codes.forEach(function(code) {
        var fund = fundsData.funds.find(function(f) { return f.code === code; });
        var holding = portfolioData.holdings.find(function(h) { return h.code === code; });
        var inv = holding ? holding.buys.reduce(function(s, b) { return s + b.amount; }, 0) : 0;

        // 30日收益：用基金自己有数据的最近30天
        var fundDates = dates.filter(function(d) { return navMatrix[code][d]; });
        var recent30 = fundDates.slice(-30);
        var startNav = recent30.length > 0 ? navMatrix[code][recent30[0]] : null;
        var endNav = recent30.length > 0 ? navMatrix[code][recent30[recent30.length - 1]] : null;
        var fundReturn = (startNav && endNav && startNav > 0) ? Math.round((endNav - startNav) / startNav * 10000) / 100 : 0;

        // 总盈亏：买入至今
        var latestNav = endNav || (fundDates.length > 0 ? navMatrix[code][fundDates[fundDates.length-1]] : 0);
        var totalVal = 0;
        if (holding) {
          holding.buys.forEach(function(b) {
            if (b.shares && b.shares > 0 && latestNav > 0) {
              totalVal += b.shares * latestNav;
            } else if (b.nav && b.nav > 0 && latestNav > 0) {
              totalVal += b.amount * (latestNav / b.nav);
            } else {
              totalVal += b.amount;
            }
          });
        }
        var totalPnl = totalVal - inv;

        attributions.push({
          code: code,
          name: fund ? fund.name : code,
          type: fund ? fund.type : '其他',
          invested: inv,
          return30d: fundReturn,
          contribution: inv * fundReturn / 100,
          totalPnl: Math.round(totalPnl * 100) / 100
        });
      });

      attributions.sort(function(a, b) { return a.totalPnl - b.totalPnl; });

      var html2 = '<div style="font-size:12px">';
      html2 += '<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:2px solid var(--border);font-weight:600;font-size:11px">';
      html2 += '<span style="flex:2">基金</span><span style="width:60px;text-align:right">投入</span><span style="width:60px;text-align:right">现值</span><span style="width:60px;text-align:right">盈亏</span></div>';

      var totalPnlSum = attributions.reduce(function(s, a) { return s + a.totalPnl; }, 0);
      var totalInvSum = attributions.reduce(function(s, a) { return s + a.invested; }, 0);
      var totalValSum = attributions.reduce(function(s, a) { return s + (a.invested + a.totalPnl); }, 0);
      attributions.forEach(function(a) {
        var curVal = a.invested + a.totalPnl;
        var clsPnl = a.totalPnl >= 0 ? 'var(--danger)' : 'var(--success)';
        html2 += '<div style="display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid var(--border);align-items:center">';
        html2 += '<span style="flex:2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="' + a.name + '">' + a.name + '</span>';
        html2 += '<span style="width:60px;text-align:right;color:var(--text3);font-size:11px">' + a.invested + '</span>';
        html2 += '<span style="width:60px;text-align:right;font-size:11px">' + Math.round(curVal * 100) / 100 + '</span>';
        html2 += '<span style="width:60px;text-align:right;color:' + clsPnl + ';font-weight:600;font-size:11px">' + (a.totalPnl >= 0 ? '+' : '') + a.totalPnl + '</span>';
        html2 += '</div>';
      });
      html2 += '<div style="display:flex;justify-content:space-between;padding:6px 0;font-weight:600;border-top:2px solid var(--border)">';
      html2 += '<span>合计</span>';
      html2 += '<span style="width:60px;text-align:right">' + totalInvSum + '</span>';
      html2 += '<span style="width:60px;text-align:right">' + Math.round(totalValSum * 100) / 100 + '</span>';
      html2 += '<span style="width:60px;text-align:right;color:' + (totalPnlSum >= 0 ? 'var(--danger)' : 'var(--success)') + '">' + (totalPnlSum >= 0 ? '+' : '') + Math.round(totalPnlSum * 100) / 100 + '</span>';
      html2 += '</div>';
      html2 += '</div>';

      el.innerHTML = html2;
    }

    if (dailyBriefData && dailyBriefData.content) {
      document.getElementById('brief-card').style.display = 'block';
      // 简单格式化：换行变<br>，emoji保持，清理XML标签
      var briefText = dailyBriefData.content
        .replace(/<\/?(?:thinking|MORNING_SUMMARY|ANALYSIS_BLOCK|ORDERS_JSON|CONFIDENCE_ASSESSMENT)[^>]*>/gi, '')
        .replace(/\n/g, '<br>');
      document.getElementById('daily-brief').innerHTML = briefText;
    }

    // ========== AI 助手模块 ==========
    var AI_CONFIG_KEY = 'qdii-ai-config';
    var AI_CHAT_KEY = 'qdii-ai-chat';
    var AI_CHAT_PLAN_KEY = 'qdii-ai-chat-plan';
    var aiChatHistory = [];

    function getPlanFingerprint(plan) {
      if (!plan || (!plan.date && !plan.asOf) || !plan.action) return '';
      return String(plan.date || plan.asOf) + '|' + String(plan.action);
    }

    function syncChatPlanScope(plan) {
      var chatKey = typeof AI_CHAT_KEY !== 'undefined' ? AI_CHAT_KEY : 'qdii-ai-chat';
      var planKey = typeof AI_CHAT_PLAN_KEY !== 'undefined' ? AI_CHAT_PLAN_KEY : 'qdii-ai-chat-plan';
      var current = getPlanFingerprint(plan);
      if (!current) return false;
      var previous = localStorage.getItem(planKey);
      var changed = Boolean(previous && previous !== current);
      if (changed) localStorage.removeItem(chatKey);
      localStorage.setItem(planKey, current);
      return changed;
    }

    function isTodayBuyQuestion(text) {
      return /今天.*(买什么|买哪|该买|能买)|现在.*(买什么|买哪|该买)|今日.*(买什么|买哪|该买)/.test(String(text || '').replace(/\s+/g, ''));
    }

    function isMarketSentimentQuestion(text) {
      return /(市场情绪|新闻.*情绪|外部信号.*情绪|情绪如何)/.test(String(text || '').replace(/\s+/g, ''));
    }

    function buildMarketSentimentDisclosure(plan, news, externalSignals) {
      var newsSource = news || {};
      var externalSource = externalSignals || {};
      var newsCount = Array.isArray(newsSource.items) ? newsSource.items.length : 0;
      var externalCount = Array.isArray(externalSource.tickerOpinions) ? externalSource.tickerOpinions.length : 0;
      var parts = [
        '📌 数据说明：新闻数据时效 ' + (newsSource.fetchedAt || '未知') + '，覆盖' + newsCount + '条',
        '外部信号状态 ' + (externalSource.status || '未知') + '，数据时效 ' + (externalSource.cachedAt || '未知') + '，覆盖' + externalCount + '条'
      ];
      if (newsCount < 5 || externalCount === 0 || externalSource.status === 'stale') {
        parts.push('覆盖不足，只能作为背景解释');
      }
      parts.push('市场情绪不得改变确定性计划 ' + ((plan && plan.action) || 'PAUSE'));
      return parts.join('；') + '。';
    }

    function buildNoBuyAnswer(plan) {
      var safePlan = plan || {};
      return '今天不买。' + (safePlan.date || safePlan.asOf ? '计划日期：' + (safePlan.date || safePlan.asOf) + '；' : '') +
        '确定性计划状态为 ' + (safePlan.action || 'PAUSE') + '，今日预算 0元。\n' +
        buildPauseDetails(safePlan) + '。\n影子候选金额为0，只记录后续表现，不执行真实买入。';
    }

    function buildDeterministicBuyAnswer(plan) {
      var safePlan = plan || {};
      var routes = Array.isArray(safePlan.executionRoutes) ? safePlan.executionRoutes : [];
      var lines = [
        '确定性计划状态：' + (safePlan.action || 'HARD_PAUSE') + '；今日总预算' + Number(safePlan.budget || 0) + '元；云端账本 revision ' + Number(safePlan.syncRevision || 0) + '。'
      ];
      routes.forEach(function(route, index) {
        lines.push((index + 1) + '. ' + (route.name || route.code) + '(' + route.code + ')：' + Number(route.amount || 0) + '元，目标桶 ' + route.bucket + '。');
      });
      if (safePlan.action === 'TACTICAL_PAUSE') {
        lines.push('TOP择时与成长科技新增仍暂停；这里只执行低配核心桶的小额定投，新闻和市场温度不能增加金额。');
      }
      lines.push('QDII通常按有效申请日净值成交，T+2主要是确认时间；以上仅为计划记录，不会自动下单。');
      return lines.join('\n');
    }

    function getAiConfig() {
      try { return JSON.parse(localStorage.getItem(AI_CONFIG_KEY)) || {}; } catch(e) { return {}; }
    }

    function getAiChatCompletionsUrl(baseUrl) {
      var normalized = String(baseUrl || '').trim().replace(/\/+$/, '');
      return normalized.endsWith('/chat/completions') ? normalized : normalized + '/chat/completions';
    }

    function saveAiConfig() {
      var config = {
        apiKey: document.getElementById('aiApiKey').value.trim(),
        baseUrl: document.getElementById('aiBaseUrl').value.trim(),
        model: document.getElementById('aiModel').value.trim()
      };
      if (!config.apiKey) { showToast('请输入 API Key', true); return; }
      if (!config.baseUrl) config.baseUrl = 'https://api.siliconflow.cn/v1/chat/completions';
      if (!config.model) config.model = 'Qwen/Qwen3-8B';
      localStorage.setItem(AI_CONFIG_KEY, JSON.stringify(config));
      document.getElementById('ai-config-panel').style.display = 'none';
      showToast('✅ 配置已保存');
    }

    async function testAiConnection() {
      var config = getAiConfig();
      if (!config.apiKey) { showToast('请先填写 API Key', true); return; }
      var resultEl = document.getElementById('ai-test-result');
      resultEl.style.display = 'block';
      resultEl.style.color = 'var(--text3)';
      resultEl.textContent = '⏳ 测试中...';
      try {
        var response = await fetch(getAiChatCompletionsUrl(config.baseUrl), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + config.apiKey },
          body: JSON.stringify({ model: config.model || 'Qwen/Qwen3-8B', messages: [{ role: 'user', content: 'hi' }], max_tokens: 5 })
        });
        if (response.ok) {
          resultEl.style.color = '#22c55e';
          resultEl.textContent = '✅ 连接成功！模型: ' + (config.model || 'Qwen/Qwen3-8B');
        } else {
          var err = await response.text();
          resultEl.style.color = '#ef4444';
          resultEl.textContent = '❌ 连接失败: ' + response.status + ' ' + err.slice(0, 100);
        }
      } catch(e) {
        resultEl.style.color = '#ef4444';
        resultEl.textContent = '❌ 网络错误: ' + e.message;
      }
    }

    function autoResizeInput(el) {
      el.style.height = 'auto';
      el.style.height = Math.min(el.scrollHeight, 100) + 'px';
    }

    function presetConfig(provider) {
      var presets = {
        siliconflow: { baseUrl: 'https://api.siliconflow.cn/v1/chat/completions', model: 'Qwen/Qwen3-8B' },
        deepseek: { baseUrl: 'https://api.deepseek.com/v1/chat/completions', model: 'deepseek-chat' },
        mimo: { baseUrl: 'https://token-plan-cn.xiaomimimo.com/v1/chat/completions', model: 'mimo-v2.5-pro' },
        openai: { baseUrl: 'https://api.openai.com/v1/chat/completions', model: 'gpt-4o-mini' }
      };
      var p = presets[provider];
      if (p) {
        document.getElementById('aiBaseUrl').value = p.baseUrl;
        document.getElementById('aiModel').value = p.model;
      }
    }

    function updateApiStatus() {
      var config = getAiConfig();
      var el = document.getElementById('ai-api-status');
      if (!el) return;
      if (config.apiKey) {
        el.innerHTML = '🟢 已配置: ' + (config.model || '未设置') + ' · <a href="#" onclick="toggleAiConfig();return false" style="color:var(--primary)">修改</a>';
      } else {
        el.innerHTML = '🔴 未配置 · <a href="#" onclick="toggleAiConfig();return false" style="color:var(--primary)">点击配置</a>';
      }
    }

    function toggleAiConfig() {
      var panel = document.getElementById('ai-config-panel');
      if (panel.style.display === 'none') {
        panel.style.display = 'block';
        var config = getAiConfig();
        document.getElementById('aiApiKey').value = config.apiKey || '';
        document.getElementById('aiBaseUrl').value = config.baseUrl || '';
        document.getElementById('aiModel').value = config.model || '';
      } else {
        panel.style.display = 'none';
      }
    }

    function loadChatHistory() {
      syncChatPlanScope(typeof todayPicks !== 'undefined' ? todayPicks : null);
      try { aiChatHistory = JSON.parse(localStorage.getItem(AI_CHAT_KEY)) || []; } catch(e) { aiChatHistory = []; }
      if (aiChatHistory.length > 0) renderChatHistory();
    }

    function saveChatHistory() {
      // 只保留最近 50 条消息
      if (aiChatHistory.length > 50) aiChatHistory = aiChatHistory.slice(-50);
      localStorage.setItem(AI_CHAT_KEY, JSON.stringify(aiChatHistory));
    }

    function clearChat() {
      aiChatHistory = [];
      localStorage.removeItem(AI_CHAT_KEY);
      document.getElementById('ai-messages').innerHTML = '<div style="text-align:center;padding:40px 20px;color:var(--text3);font-size:13px">👋 你好！我是你的 QDII 基金投资助手。<br>基于你的持仓和实时市场数据，为你提供投资建议。<br>点击上方快捷按钮或输入你的问题开始对话。</div>';
    }

    function renderChatHistory() {
      var el = document.getElementById('ai-messages');
      if (!el || aiChatHistory.length === 0) return;
      el.innerHTML = '';
      aiChatHistory.forEach(function(msg) {
        appendMessage(msg.role, msg.content, false);
      });
      el.scrollTop = el.scrollHeight;
    }

    function appendMessage(role, content, scroll) {
      var el = document.getElementById('ai-messages');
      var div = document.createElement('div');
      div.style.cssText = 'margin-bottom:10px;display:flex;justify-content:' + (role === 'user' ? 'flex-end' : 'flex-start') + ';';
      var bubble = document.createElement('div');
      bubble.style.cssText = 'max-width:85%;padding:10px 14px;border-radius:12px;font-size:13px;line-height:1.7;white-space:pre-wrap;word-break:break-word;';
      if (role === 'user') {
        bubble.style.background = 'var(--primary)';
        bubble.style.color = 'white';
        bubble.style.borderBottomRightRadius = '4px';
        bubble.textContent = content;
      } else {
        bubble.style.background = 'var(--card)';
        bubble.style.color = 'var(--text)';
        bubble.style.border = '1px solid var(--border)';
        bubble.style.borderBottomLeftRadius = '4px';
        bubble.innerHTML = renderMarkdown(content);
      }
      bubble.id = role === 'assistant' ? 'ai-last-bubble' : '';
      div.appendChild(bubble);
      // 移除欢迎信息
      var welcome = el.querySelector('[style*="text-align:center;padding:40px"]');
      if (welcome) welcome.remove();
      el.appendChild(div);
      if (scroll !== false) el.scrollTop = el.scrollHeight;
      return bubble;
    }

    function renderMarkdown(text) {
      if (!text) return '';
      var html = text
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/`(.+?)`/g, '<code style="background:var(--bg2);padding:1px 4px;border-radius:3px;font-size:12px">$1</code>');

      // 表格渲染
      var lines = html.split('\n');
      var result = [];
      var inTable = false;
      var tableRows = [];
      for (var i = 0; i < lines.length; i++) {
        var line = lines[i].trim();
        if (line.match(/^\|(.+\|)+$/)) {
          if (!inTable) { inTable = true; tableRows = []; }
          var cells = line.split('|').filter(function(c){return c.trim()!=='';}).map(function(c){return c.trim();});
          // 跳过分隔行
          if (cells.every(function(c){return c.match(/^[-:]+$/);})) continue;
          tableRows.push(cells);
        } else {
          if (inTable && tableRows.length > 0) {
            result.push(renderTable(tableRows));
            inTable = false;
            tableRows = [];
          }
          result.push(line);
        }
      }
      if (inTable && tableRows.length > 0) result.push(renderTable(tableRows));

      return result.join('\n').replace(/\n/g, '<br>');
    }

    function renderTable(rows) {
      if (rows.length === 0) return '';
      var html = '<table style="width:100%;border-collapse:collapse;font-size:12px;margin:8px 0">';
      rows.forEach(function(row, idx) {
        html += '<tr style="' + (idx===0?'background:var(--table-row-even);font-weight:600':'') + '">';
        row.forEach(function(cell) {
          html += '<td style="padding:4px 8px;border:1px solid var(--border)">' + cell + '</td>';
        });
        html += '</tr>';
      });
      html += '</table>';
      return html;
    }

    function buildSystemPrompt(question) {
      var lines = [];
      lines.push('你是QDII基金投资助手。风格轻松口语化，像朋友聊天。回答控制在500字以内，用emoji。');
      lines.push('直接回答问题，不要输出思考过程。');
      lines.push('');
      lines.push('=== 不可更改的 RecommendationPlan ===');
      var plan = typeof todayPicks !== 'undefined' && todayPicks ? todayPicks : {};
      lines.push('计划日期: ' + (plan.date || plan.asOf || '未知'));
      lines.push('action: ' + (plan.action || 'PAUSE'));
      lines.push('预算: ' + (Number(plan.budget) || 0) + '元');
      var freshness = plan.dataFreshness || {};
      lines.push('数据时效: ' + (freshness.status || '未知') + (freshness.latestNavDate ? '，最新净值' + freshness.latestNavDate : ''));
      if (plan.action === 'PAUSE' || plan.action === 'HOLD') lines.push(buildPauseDetails(plan));
      var planCandidates = Array.isArray(plan.ranked) ? plan.ranked : [];
      if (planCandidates.length === 0) {
        lines.push('候选: 无');
      } else {
        planCandidates.forEach(function(candidate, index) {
          lines.push((index + 1) + '. ' + candidate.name + '(' + candidate.code + ') 评分' +
            formatMetric(candidate.score !== undefined ? candidate.score : candidate.marketScore) +
            '，建议金额' + (Number(candidate.proposedAmount) || 0) + '元' +
            (candidate.reason ? '，理由：' + candidate.reason : '') +
            (candidate.blockedBy && candidate.blockedBy.length ? '，阻止原因：' + candidate.blockedBy.join('、') : ''));
        });
      }
      lines.push('硬规则：只能解释以上 RecommendationPlan，不得新增基金、重算排名、改变 action、预算或建议金额。');
      lines.push('PAUSE/HOLD 必须明确回答今天不买、预算0元；市场情绪不得覆盖或弱化 PAUSE。');
      lines.push('');

      // “今天买什么”只能解释确定性计划，不注入任何浏览器自算数据。
      if (isTodayBuyQuestion(question)) return lines.join('\n');

      // 市场情绪
      if (typeof newsData !== 'undefined' && newsData && newsData.sentiment) {
        var sentiment = newsData.sentiment;
        var moodText = sentiment.overall > 10 ? '偏乐观' : (sentiment.overall < -10 ? '偏悲观' : '中性');
        lines.push('=== 市场情绪 ===');
        lines.push('情绪: ' + moodText + ' (分数:' + sentiment.overall + ')');
        lines.push('利好: ' + sentiment.positive + '条, 利空: ' + sentiment.negative + '条');
        lines.push('新闻数据时效: ' + (newsData.fetchedAt || '未知') + '；覆盖: ' + ((newsData.items && newsData.items.length) || 0) + '条');
        if (!newsData.items || newsData.items.length < 5) lines.push('覆盖不足：新闻样本少于5条，只能作解释，不能用于改变买卖状态。');
        lines.push('约束：市场情绪只解释背景，不得覆盖 RecommendationPlan 的 ' + (plan.action || 'PAUSE') + ' 状态。');
        lines.push('');
      } else {
        lines.push('=== 市场情绪 ===');
        lines.push('数据时效未知且覆盖不足：没有可用情绪样本，不得据此改变 RecommendationPlan。');
        lines.push('');
      }

      // 基金类型→底层持仓映射（精简版）
      lines.push('基金底层参考：');
      lines.push('- 纳指类：英伟达、苹果、微软、谷歌、亚马逊等美股科技');
      lines.push('- 标普类：美股大盘蓝筹（科技+金融+医疗+消费）');
      lines.push('- 生物科技：安进、吉利德、再生元等美股生科');
      lines.push('- 港股：腾讯、阿里、美团等中概互联网');
      lines.push('- 日本：丰田、索尼、软银等日企龙头');
      lines.push('- 德国：西门子、SAP、巴斯夫等欧洲工业');
      lines.push('- 全球成长/制造：全球精选成长股/半导体/新能源');
      lines.push('- 新能源车：特斯拉、比亚迪、宁德时代');
      lines.push('- 美国REITs：美国房地产信托');
      lines.push('- 新兴市场：印度、巴西、东南亚');
      lines.push('');

      // 持仓数据（带盈亏）
      lines.push('=== 用户当前持仓（含盈亏） ===');
      var holdings = portfolioData.holdings || [];
      var totalInv = 0, totalVal = 0;
      holdings.forEach(function(h) {
        var inv = (h.buys || []).reduce(function(s, b) { return s + (b.amount || 0); }, 0);
        totalInv += inv;
        // 获取最新净值
        var cached = navCacheData[h.code];
        var latestNav = cached && cached.length > 0 ? cached[cached.length - 1].nav : null;
        var val = 0;
        (h.buys || []).forEach(function(b) {
          if (b.shares > 0 && latestNav) val += b.shares * latestNav;
          else val += b.amount; // 未结算按投入算
        });
        totalVal += val;
        var pnl = val - inv;
        var pnlStr = pnl >= 0 ? '+' + pnl.toFixed(2) : pnl.toFixed(2);
        var settled = (h.buys || []).filter(function(b){return b.shares>0;}).length;
        lines.push('- ' + h.name + ' (' + h.code + '): 投入' + inv + '元, 市值' + val.toFixed(0) + '元, 盈亏' + pnlStr + '元, ' + settled + '笔已结算');
      });
      lines.push('总投入: ' + totalInv + '元, 总市值: ' + totalVal.toFixed(0) + '元, 总盈亏: ' + (totalVal - totalInv).toFixed(2) + '元, ' + holdings.length + '只基金');
      lines.push('');

      // 新闻（带情绪评分）
      if (newsData && newsData.items && newsData.items.length > 0) {
        lines.push('=== 最新新闻（带情绪评分） ===');
        newsData.items.slice(0, 12).forEach(function(n) {
          var emoji = (n._score > 0) ? '🟢' : ((n._score < 0) ? '🔴' : '⚪');
          lines.push(emoji + ' ' + n.title + (n.source ? ' ['+n.source+']' : '') + ' (情绪:' + (n._score || 0) + ')');
        });
        lines.push('');
      }

      // 外部信号
      if (externalSignalsData && externalSignalsData.tickerOpinions && externalSignalsData.tickerOpinions.length > 0) {
        lines.push('=== 外部信号 (Twitter/Reddit) ===');
        externalSignalsData.tickerOpinions.slice(0, 15).forEach(function(t) {
          lines.push('$' + t.ticker + ': ' + t.sentiment + ' (' + t.mentions + '次提及)');
        });
        lines.push('');
      }

      // 早报
      if (dailyBriefData && dailyBriefData.content) {
        lines.push('=== 今日AI早报 ===');
        lines.push(dailyBriefData.content);
        lines.push('');
      }

      // 限购信息（稀缺度）
      if (purchaseLimits) {
        var scarce = [], normal = [];
        Object.keys(purchaseLimits).forEach(function(code) {
          var p = purchaseLimits[code];
          if (p.limit <= 10) scarce.push(code + '限' + p.limit + '元');
          else if (p.limit <= 100) normal.push(code + '限' + p.limit + '元');
        });
        if (scarce.length > 0) {
          lines.push('=== 限购≤10元的基金（注意：限购低不代表基金好，仅反映额度紧张） ===');
          lines.push(scarce.join(', '));
          lines.push('');
        }
        if (normal.length > 0) {
          lines.push('=== 限购基金（11-100元） ===');
          lines.push(normal.join(', '));
          lines.push('');
        }
      }

      return lines.join('\n');
    }

    async function sendAiMessage(retryText) {
      var input = document.getElementById('ai-input');
      var text = retryText || input.value.trim();
      if (!text) return;
      if (!retryText) { input.value = ''; input.style.height = 'auto'; }

      // 显示用户消息
      if (!retryText) {
        appendMessage('user', text);
        aiChatHistory.push({ role: 'user', content: text });
        saveChatHistory();
      }

      // “今天买什么”始终直接消费确定性计划，不调用 LLM。
      if (isTodayBuyQuestion(text) && todayPicks) {
        var localAnswer = actionAllowsPurchase(todayPicks)
          ? buildDeterministicBuyAnswer(todayPicks)
          : buildNoBuyAnswer(todayPicks);
        appendMessage('assistant', localAnswer);
        aiChatHistory.push({ role: 'assistant', content: localAnswer });
        saveChatHistory();
        return;
      }

      var config = getAiConfig();
      if (!config.apiKey) {
        toggleAiConfig();
        showToast('请先配置 API Key', true);
        return;
      }

      // 显示加载状态
      var sendBtn = document.getElementById('ai-send-btn');
      sendBtn.disabled = true;
      sendBtn.textContent = '...';
      var startTime = Date.now();
      var bubble = appendMessage('assistant', '思考中...');
      bubble.innerHTML = '<div style="display:flex;align-items:center;gap:8px"><div class="loading"></div> <span style="color:var(--text3)">AI 正在分析...</span></div>';

      try {
        var systemPrompt = buildSystemPrompt(text);
        var messages = [{ role: 'system', content: systemPrompt }];
        // 加入最近的聊天历史（最多10条）
        var recentHistory = aiChatHistory.slice(-10);
        recentHistory.forEach(function(m) { messages.push({ role: m.role, content: m.content }); });

        // [security] 优先通过服务器代理，避免前端暴露 API Key
        var useProxy = typeof location !== 'undefined' && location.hostname.indexOf('.github.io') === -1;
        var response;
        if (useProxy) {
          // 通过 Web Server 代理
          response = await fetch('/api/llm-proxy', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ messages: messages, model: config.model, baseUrl: config.baseUrl })
          });
        } else {
          // GitHub Pages 直接调用（API Key 在 localStorage 中）
          var apiUrl = getAiChatCompletionsUrl(config.baseUrl);
          response = await fetch(apiUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': 'Bearer ' + config.apiKey
            },
            body: JSON.stringify({
              model: config.model || 'Qwen/Qwen3-8B',
              messages: messages,
              temperature: 0.3,
              max_tokens: 2000,
              stream: true
            })
          });
        }

        if (!response.ok) {
          var errText = await response.text();
          throw new Error('API 错误 ' + response.status + ': ' + errText.slice(0, 100));
        }

        // 流式读取
        var fullText = '';
        var reader = response.body.getReader();
        var decoder = new TextDecoder();
        var buffer = '';

        while (true) {
          var result = await reader.read();
          if (result.done) break;
          buffer += decoder.decode(result.value, { stream: true });
          var lines = buffer.split('\n');
          buffer = lines.pop();
          for (var i = 0; i < lines.length; i++) {
            var line = lines[i].trim();
            if (!line || !line.startsWith('data: ')) continue;
            var data = line.slice(6);
            if (data === '[DONE]') continue;
            try {
              var json = JSON.parse(data);
              var delta = json.choices && json.choices[0] && json.choices[0].delta;
              if (delta && delta.content) {
                fullText += delta.content;
                // 流式输出时也清理思维链
                var cleanText = fullText.replace(/<think>[\s\S]*?<\/think>/gi, '').replace(/<thinking>[\s\S]*?<\/thinking>/gi, '').trim();
                bubble.innerHTML = renderMarkdown(cleanText || fullText);
                var el = document.getElementById('ai-messages');
                el.scrollTop = el.scrollHeight;
              }
            } catch(e) { /* skip malformed chunks */ }
          }
        }

        // 流式结束后如果没有内容，检查非流式响应
        if (!fullText) {
          try {
            var json = JSON.parse(buffer || '{}');
            var msg = json.choices && json.choices[0] && json.choices[0].message;
            if (msg) fullText = msg.content || '';
          } catch(e) {}
        }

        if (fullText) {
          // 清理思维链
          fullText = fullText.replace(/<think>[\s\S]*?<\/think>/gi, '').replace(/<thinking>[\s\S]*?<\/thinking>/gi, '').trim();
          if (isMarketSentimentQuestion(text)) {
            fullText += '\n\n' + buildMarketSentimentDisclosure(
              typeof todayPicks !== 'undefined' ? todayPicks : null,
              typeof newsData !== 'undefined' ? newsData : null,
              typeof externalSignalsData !== 'undefined' ? externalSignalsData : null
            );
          }
          var elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
          bubble.innerHTML = renderMarkdown(fullText) + '<div style="font-size:10px;color:var(--text3);margin-top:4px;text-align:right">⏱️ ' + elapsed + 's</div>';
          aiChatHistory.push({ role: 'assistant', content: fullText });
          saveChatHistory();
        } else {
          bubble.innerHTML = '<span style="color:var(--text3)">AI 未返回内容</span><br><button onclick="sendAiMessage(\'' + text.replace(/'/g, "\\'") + '\')" style="margin-top:6px;padding:4px 10px;font-size:11px;border:1px solid var(--border);border-radius:6px;background:white;cursor:pointer">🔄 重试</button>';
        }

      } catch(err) {
        bubble.innerHTML = '<span style="color:var(--danger)">❌ ' + err.message + '</span><br><button onclick="sendAiMessage(\'' + text.replace(/'/g, "\\'") + '\')" style="margin-top:6px;padding:4px 10px;font-size:11px;border:1px solid var(--border);border-radius:6px;background:white;cursor:pointer">🔄 重试</button>';
      } finally {
        sendBtn.disabled = false;
        sendBtn.textContent = '发送';
      }
    }

    function askQuick(question) {
      document.getElementById('ai-input').value = question;
      sendAiMessage();
    }

    // 初始化：加载聊天历史和API状态
    loadChatHistory();
    updateApiStatus();

  </script>
