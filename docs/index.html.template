      // 显示 Bull 评分
      if (debateState.bull观点 && debateState.bull观点.fundAnalysis) {
        var avgBull = debateState.bull观点.fundAnalysis.reduce(function(s, f) { return s + (f.bullScore || 5); }, 0) / debateState.bull观点.fundAnalysis.length;
        bullScoreEl.textContent = Math.round(avgBull * 10) / 10 + '/10';
      }
      
      // 显示 Bear 评分
      if (debateState.bear观点 && debateState.bear观点.fundAnalysis) {
        var avgBear = debateState.bear观点.fundAnalysis.reduce(function(s, f) { return s + (f.riskScore || 5); }, 0) / debateState.bear观点.fundAnalysis.length;
        bearScoreEl.textContent = Math.round(avgBear * 10) / 10 + '/10';
      }
      
      // 显示风险等级
      if (debateState.riskAssessment) {
        riskLevelEl.textContent = debateState.riskAssessment.overallRiskLevel || '中';
        if (debateState.riskAssessment.mainRisks && debateState.riskAssessment.mainRisks.length > 0) {
          riskFactorsEl.innerHTML = debateState.riskAssessment.mainRisks.slice(0, 3).map(function(r) {
            return '<div style="margin-top:4px">• ' + r + '</div>';
          }).join('');
        }
      }
      
      // 显示辩论结果
      if (debateState.finalDecision && debateState.finalDecision.finalDecision) {
        var decision = debateState.finalDecision.finalDecision;
        // [security] 先转义 HTML，防止 LLM 输出中的恶意代码执行
        decision = decision.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        // 结构化格式化
        var formatted = decision
          .replace(/━━━ (.+?) ━━━/g, '<div style="font-weight:700;font-size:13px;margin:12px 0 6px;color:var(--primary)">$1</div>')
          . replace(/• (.+)/g, '<div style="margin:3px 0 3px 12px">• $1</div>')
          .replace(/✓ (.+)/g, '<div style="margin:3px 0 3px 12px;color:var(--success)">✓ $1</div>')
          .replace(/⚡ (.+)/g, '<div style="margin:3px 0 3px 12px;color:var(--warn)">⚡ $1</div>')
          .replace(/🔴 (.+)/g, '<div style="margin:3px 0 3px 12px"><span style="color:#ef4444">🔴</span> $1</div>')
          .replace(/🔵 (.+)/g, '<div style="margin:3px 0 3px 12px"><span style="color:#3b82f6">🔵</span> $1</div>')
          .replace(/⚪ (.+)/g, '<div style="margin:3px 0 3px 12px"><span style="color:var(--text3)">⚪</span> $1</div>')
          .replace(/\n/g, '<br>');
        resultEl.innerHTML = '<div style="padding:12px;background:var(--bg);border-radius:8px;line-height:1.8">' + formatted + '</div>';
      }
    }
    
    async function runDebate() {
      if (debateState.isRunning) return;
      
      debateState.isRunning = true;
      debateState.error = null;
      renderDebate();
      
      try {
        // 准备基金数据
        var fundData = [];
        var holdings = portfolioData.holdings || [];
        
        // 从持仓中获取基金信息
        holdings.forEach(function(h) {
          var fund = fundsData.funds.find(function(f) { return f.code === h.code; });
          if (fund) {
            fundData.push({
              code: fund.code,
              name: fund.name,
              type: fund.type || '未知',
              score: 0,
              indicators: {
                annualizedReturn: null,
                sharpeRatio: null,
                maxDrawdown: null,
                volatility: null,
                longTermTrend: null
              }
            });
          }
        });
        
        // 如果持仓不足，从基金池中补充
        if (fundData.length < 10) {
          fundsData.funds.slice(0, 10 - fundData.length).forEach(function(f) {
            if (!fundData.find(function(fd) { return fd.code === f.code; })) {
              fundData.push({
                code: f.code,
                name: f.name,
                type: f.type || '未知',
                score: 0,
                indicators: {
                  annualizedReturn: null,
                  sharpeRatio: null,
                  maxDrawdown: null,
                  volatility: null,
                  longTermTrend: null
                }
              });
            }
          });
        }
        
        // 准备市场数据
        var marketContext = {
          marketSnapshot: [],
          marketNews: []
        };
        
        // 尝试从 dailyBriefData 获取市场数据
        if (dailyBriefData) {
          if (dailyBriefData.marketSnapshot) {
