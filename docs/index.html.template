    };
    
    function renderDebate() {
      var resultEl = document.getElementById('debate-result');
      var bullScoreEl = document.getElementById('bull-score');
      var bearScoreEl = document.getElementById('bear-score');
      var riskLevelEl = document.getElementById('risk-level');
      var riskFactorsEl = document.getElementById('risk-factors');
      
      if (debateState.isRunning) {
        resultEl.innerHTML = '<div style="text-align:center;padding:20px;color:var(--primary)"><div class="loading"></div> 辩论进行中，请稍候...</div>';
        return;
      }
      
      if (debateState.error) {
        resultEl.innerHTML = '<div style="padding:16px;background:var(--state-red-bg);border-radius:8px;color:var(--state-red-text)">❌ ' + debateState.error + '</div>';
        return;
      }
      
      if (!debateState.finalDecision) {
        resultEl.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text3)">点击下方按钮开始多智能体辩论分析</div>';
        return;
