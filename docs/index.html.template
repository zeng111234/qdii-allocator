      var html = '';
      var grandInv = 0, grandVal = 0;
      var pendingHoldings = Array.isArray(portfolioData.pendingHoldings) ? portfolioData.pendingHoldings : [];
      if (pendingHoldings.length) {
        var pendingText = pendingHoldings.map(function(holding) {
          return getHoldingDisplayName(holding, fundsData.funds.find(function(f) { return f.code === holding.code; })) + '(' + holding.code + ') ' + Number(holding.totalAmount || 0) + '元';
        }).join('；');
        html += '<div style="padding:10px 12px;margin-bottom:8px;background:var(--state-yellow-bg);border:1px solid var(--state-yellow-border);border-radius:10px;font-size:12px;color:var(--state-yellow-text)">⚠️ 待核验交易：' + pendingText + '。这不是已确认持仓，不纳入市值、盈亏或风险权重。</div>';
      }
      // [fix] 按品类统计持仓集中度
      var categoryMap = {
        '纳指100':'美股科技','纳指生物科技':'美股科技','纳指科技':'美股科技',
        '标普500':'美股宽基','标普科技':'美股宽基','标普消费':'美股宽基','标普医疗':'美股宽基',
        '全球精选':'全球','全球股票':'全球','全球科技':'全球','全球成长':'全球','全球制造':'全球','全球产业升级':'全球',
        '亚太精选':'亚太','新兴市场':'亚太','越南':'亚太',
        '港股精选':'港股','恒生指数':'港股',
        '德国':'欧洲','日本':'日本',
        '石油能源':'商品','大宗商品':'商品','黄金':'商品',
        '美国REITs':'REITs','全球不动产':'REITs',
        '新能源车':'主题'
      };
      var corrMap = {'美股科技':'美股','美股宽基':'美股','全球':'美股','主题':'美股'};
      var catValues = {};
      portfolioData.holdings.forEach(function(h, i) {
        var inv = h.buys.reduce(function(s, b) { return s + b.amount; }, 0);
        var navNow = 0;
        if (navCacheData[h.code]) {
          var latest = getLatestNav(h.code);
          navNow = latest ? latest.nav : 0;
        }
        // 计算市值：和 calcSummary 一致
        var val = 0;
        h.buys.forEach(function(b) {
          if (b.shares && b.shares > 0 && navNow > 0) {
            val += b.shares * navNow;
          } else if (b.nav && b.nav > 0 && navNow > 0) {
            val += b.amount * (navNow / b.nav);
          } else {
            val += b.amount;
          }
        });
        var pnl = val - inv;
        var pnlPct = inv > 0 ? (pnl / inv * 100) : 0;
        var cls = pnl >= 0 ? 'positive' : 'negative';
        var sign = pnl >= 0 ? '+' : '';
        var fund = fundsData.funds.find(function(f) { return f.code === h.code; });
        var limit = fund && fund.dailyLimit && fund.dailyLimit < 10000 ? '限' + fund.dailyLimit + '元' : '';
        grandInv += inv;
        grandVal += val;
        // [fix] 按品类累加持仓市值
        var fundType = fund ? fund.type : '';
        var cat = categoryMap[fundType] || corrMap[fundType] || fundType || '其他';
        catValues[cat] = (catValues[cat] || 0) + val;

        html += '<div class="holding-row" onclick="toggleDetail(' + i + ')">';
        html += '<div class="holding-top">';
        html += '<div><span class="holding-name">' + getHoldingDisplayName(h, fund) + '</span><span class="holding-code">' + h.code + '</span></div>';
        html += '<div class="holding-pnl"><div class="amount ' + cls + '">' + sign + pnl.toFixed(2) + '</div>';
        html += '<div class="rate ' + cls + '">' + sign + pnlPct.toFixed(2) + '%</div></div>';
        html += '</div>';
        html += '<div class="holding-meta"><span>投入 ' + inv + '元</span><span>' + h.buys.length + '笔</span>';
        if (limit) html += '<span>' + limit + '</span>';
        html += '</div>';
        html += '<div class="detail" id="detail-' + i + '">';
        h.buys.forEach(function(b, bi) {
          html += '<div class="detail-row"><span>' + b.date + ' 买入' + b.amount + '元</span>';
          html += '<span style="display:flex;align-items:center;gap:8px">' + (b.nav ? '净值' + b.nav : '待确认');
          html += '<button onclick="deleteBuy(' + i + ',' + bi + ')" style="background:var(--danger);color:#fff;border:none;border-radius:4px;padding:2px 6px;font-size:11px;cursor:pointer">删除</button>';
          html += '</span></div>';
        });
        html += '</div></div>';
      });
      // [fix] 持仓集中度仪表盘
      if (grandVal > 0) {
        var catEntries = Object.keys(catValues).map(function(k) { return { cat: k, val: catValues[k], pct: catValues[k] / grandVal * 100 }; });
        catEntries.sort(function(a, b) { return b.pct - a.pct; });
        var maxPct = catEntries.length > 0 ? catEntries[0].pct : 0;
        var warnColor = maxPct > 60 ? '#ef4444' : (maxPct > 40 ? '#f97316' : '#22c55e');
        var warnText = maxPct > 60 ? '⚠️ 集中度过高，建议分散配置' : (maxPct > 40 ? '⚡ 偏重配置，可适当分散' : '✅ 配置均衡');
        html += '<div style="padding:10px 12px;margin-bottom:8px;background:var(--card-bg);border-radius:10px;border:1px solid var(--border)">';
        html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">';
        html += '<span style="font-size:13px;font-weight:600;color:var(--text1)">📊 持仓集中度</span>';
        html += '<span style="font-size:11px;color:' + warnColor + '">' + warnText + '</span>';
        html += '</div>';
        catEntries.forEach(function(e) {
          var barColor = e.pct > 50 ? '#ef4444' : (e.pct > 30 ? '#f97316' : '#3b82f6');
          html += '<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:12px">';
          html += '<span style="width:60px;color:var(--text2);text-align:right">' + e.cat + '</span>';
          html += '<div style="flex:1;height:6px;background:var(--border);border-radius:3px;overflow:hidden">';
          html += '<div style="height:100%;width:' + Math.min(e.pct, 100) + '%;background:' + barColor + ';border-radius:3px"></div>';
          html += '</div>';
          html += '<span style="width:45px;color:var(--text1);font-weight:600">' + e.pct.toFixed(1) + '%</span>';
          html += '</div>';
        });
        html += '</div>';
      }
      // 底部汇总：和顶部 summary 交叉验证
      var grandPnl = grandVal - grandInv;
      var gpCls = grandPnl >= 0 ? 'positive' : 'negative';
      var gpSign = grandPnl >= 0 ? '+' : '';
      html += '<div style="padding:12px 0 4px;border-top:2px solid var(--border);display:flex;justify-content:space-between;font-size:13px;font-weight:600">';
      html += '<span>合计 ' + portfolioData.holdings.length + '只</span>';
      html += '<span>投入 ' + grandInv.toFixed(2) + ' · 市值 ' + grandVal.toFixed(2) + ' · <span class="' + gpCls + '">盈亏 ' + gpSign + grandPnl.toFixed(2) + '</span></span>';
      html += '</div>';
      c.innerHTML = html;
    }

    function toggleDetail(idx) {
      var el = document.getElementById('detail-' + idx);
      el.style.display = el.style.display === 'none' ? 'block' : 'none';
    }

    function extractCorp(name) {
      var m = name.match(/^(广发|易方达|华泰柏瑞|华夏|南方|华安|嘉实|大成|博时|工银|天弘|富国|银华|万家|摩根|国泰|汇添富|鹏华|建信|诺安|融通|景顺长城|浦银安盛)/);
      return m ? m[1] : name.substring(0, 2);
    }

    function buildFundOptions() {
      var active = fundsData.funds.filter(function(f) { return f.status === 'active'; });
      var grouped = {};
      active.forEach(function(f) {
        var corp = extractCorp(f.name);
        if (!grouped[corp]) grouped[corp] = [];
        grouped[corp].push(f);
      });
      var html = '<option value="">-- 选择基金 --</option>';
      Object.keys(grouped).sort().forEach(function(corp) {
        html += '<optgroup label="' + corp + '">';
        grouped[corp].forEach(function(f) {
          var lim = f.dailyLimit && f.dailyLimit < 10000 ? ' (限' + f.dailyLimit + ')' : '';
          html += '<option value="' + f.code + '">' + f.code + ' ' + f.name + lim + '</option>';
        });
        html += '</optgroup>';
      });
      return html;
    }

    function loadFundOptions() {
      document.getElementById('fundSelect').innerHTML = buildFundOptions();
    }

    async function addBuy() {
      if (!cloudWriteReady) { showToast('请先完成 Google 登录和云端账本校验', true); return; }
      var beforeWrite = JSON.parse(JSON.stringify(portfolioData));
      var code = document.getElementById('fundSelect').value;
      var amount = parseFloat(document.getElementById('amount').value);
      var nav = document.getElementById('nav').value ? parseFloat(document.getElementById('nav').value) : null;
      var date = document.getElementById('buyDate').value || new Date().toISOString().slice(0, 10);
      if (!code) { showToast('请选择基金', true); return; }
      if (!amount || amount <= 0) { showToast('请输入金额', true); return; }
      var fund = fundsData.funds.find(function(f) { return f.code === code; });
      var holding = portfolioData.holdings.find(function(h) { return h.code === code; });
      if (!holding) { holding = { code: code, name: fund ? fund.name : code, buys: [] }; portfolioData.holdings.push(holding); }
      holding.buys.push({ date: date, amount: amount, nav: nav, shares: nav ? Math.round(amount / nav * 10000) / 10000 : null, settleDate: null });
      if (!portfolioData.startDate || date < portfolioData.startDate) portfolioData.startDate = date;
      updateSummary(); updateHoldings();
      try { await saveLocal(); }
      catch (error) {
        portfolioData = beforeWrite; updateSummary(); updateHoldings();
        return;
      }
      showToast('已记录买入 ' + holding.name + ' ' + amount + '元');
      createHypothesisLocal(code, holding.name, '人工记录', '用户手动记录 ' + amount + '元；不代表策略推荐，不因限购、下跌或外部情绪提高预算');
      document.getElementById('buyResult').innerHTML = '<div style="background:var(--state-green-bg);border:1px solid var(--state-green-border);border-radius:8px;padding:10px;font-size:12px;color:var(--state-green-text)">✅ 已写入不可变云端账本</div>';
    }

    // Batch
    function addBatchRow() {
      var list = document.getElementById('batchList');
      var row = document.createElement('div');
      row.className = 'batch-row';
      row.innerHTML = '<select class="batch-fund">' + buildFundOptions() + '</select>' +
        '<input type="number" class="batch-amount" min="1" step="1" value="10" placeholder="金额">' +
        '<button class="del" onclick="if(this.closest(\'.batch-row\').parentNode.children.length>1)this.closest(\'.batch-row\').remove()">×</button>';
      list.appendChild(row);
    }
    async function submitBatch() {
      if (!cloudWriteReady) { showToast('请先完成 Google 登录和云端账本校验', true); return; }
      var beforeWrite = JSON.parse(JSON.stringify(portfolioData));
      var date = document.getElementById('batchDate').value;
      var rows = document.querySelectorAll('.batch-row');
      var items = [];
      rows.forEach(function(row) {
        var code = row.querySelector('.batch-fund').value;
        var amount = parseFloat(row.querySelector('.batch-amount').value);
        if (code && amount > 0) items.push({ code: code, amount: amount });
      });
      if (!items.length) { showToast('请添加记录', true); return; }
      items.forEach(function(item) {
        var fund = fundsData.funds.find(function(f) { return f.code === item.code; });
        var holding = portfolioData.holdings.find(function(h) { return h.code === item.code; });
        if (!holding) { holding = { code: item.code, name: fund ? fund.name : item.code, buys: [] }; portfolioData.holdings.push(holding); }
        holding.buys.push({ date: date, amount: item.amount, nav: null, shares: null, settleDate: null });
        if (!portfolioData.startDate || date < portfolioData.startDate) portfolioData.startDate = date;
      });
      updateSummary(); updateHoldings();
      try { await saveLocal(); }
      catch (error) {
        portfolioData = beforeWrite; updateSummary(); updateHoldings();
        return;
      }
      showToast('批量添加 ' + items.length + ' 笔');
      document.getElementById('batchList').innerHTML = '';
      addBatchRow();
    }

    // Insights
    function renderInsights() {
      var c = document.getElementById('insights-content');
      var html = '';

      // Health
      html += '<div class="card-title" style="margin-top:4px">组合健康度</div>';
      var typeW = {}, totalInv = 0;
      portfolioData.holdings.forEach(function(h) {
        var fund = fundsData.funds.find(function(f) { return f.code === h.code; });
        var type = fund ? fund.type : '其他';
        var inv = h.buys.reduce(function(s, b) { return s + b.amount; }, 0);
        typeW[type] = (typeW[type] || 0) + inv;
        totalInv += inv;
      });
      Object.keys(typeW).sort(function(a, b) { return typeW[b] - typeW[a]; }).forEach(function(t) {
        var pct = totalInv > 0 ? Math.round(typeW[t] / totalInv * 100) : 0;
        var color = pct > 50 ? 'var(--danger)' : (pct > 30 ? 'var(--warn)' : 'var(--success)');
        html += '<div class="type-bar"><div class="label-row"><span>' + t + '</span><span style="font-weight:600">' + pct + '%</span></div>';
        html += '<div class="bar-bg"><div class="bar-fill" style="width:' + pct + '%;background:' + color + '"></div></div></div>';
      });
      var maxPct = totalInv > 0 ? Math.round(Math.max.apply(null, Object.values(typeW)) / totalInv * 100) : 0;
      var health = maxPct > 70 ? 50 : (maxPct > 50 ? 70 : 85);
      var hColor = health >= 80 ? 'var(--state-green-bg)' : 'var(--state-yellow-bg)';
      var hText = health >= 80 ? '🟢 分散良好' : '🟡 建议增加非美股配置';
      html += '<div style="padding:10px;background:' + hColor + ';border-radius:8px;font-size:13px;margin-top:4px">健康度 <strong>' + health + '/100</strong> · ' + hText + '</div>';

      // Backtest (dynamic from nav-cache data)
      html += '<div class="card-title" style="margin-top:18px">📈 走步回测验证</div>';
      html += '<div id="backtest-content"><div style="text-align:center;padding:10px;color:var(--text3)">正在加载回测数据...</div></div>';
      html += '<div style="font-size:11px;color:var(--text3)">训练120天→测试30天 · 受 <a href="https://github.com/HKUDS/Vibe-Trading" target="_blank" style="color:var(--primary)">Vibe-Trading</a> 启发</div>';

      // Performance Attribution
      html += '<div class="card-title" style="margin-top:18px">📊 业绩归因</div>';
      html += '<div id="attribution-content"><div style="text-align:center;padding:10px;color:var(--text3)">正在计算...</div></div>';

      // Hypotheses (from embedded data)
      html += '<div class="card-title" style="margin-top:18px">📝 假设追踪</div>';
      var hypData = typeof hypothesesData !== 'undefined' && hypothesesData ? hypothesesData : loadHypothesesLocal();
      if (!hypData || !hypData.hypotheses || hypData.hypotheses.length === 0) {
        html += '<div style="font-size:13px;color:var(--text3);line-height:1.7">暂无投资假设。在买入基金时，系统会自动创建投资假设并追踪收益。</div>';
      } else {
        var activeHyps = hypData.hypotheses.filter(function(h) { return h.status === 'active'; });
        var outcomeStats = getHypothesisOutcomeStats(hypData.hypotheses);
        var winRate = outcomeStats.winRate;
        var winRateDisplay = winRate !== null ? winRate + '% (' + outcomeStats.sampleCount + '个)' : '样本不足';
        html += '<div class="insight-grid">';
        html += '<div class="insight-stat blue"><div class="label">活跃假设</div><div class="value">' + activeHyps.length + '</div></div>';
        html += '<div class="insight-stat green"><div class="label">达到止盈</div><div class="value">' + outcomeStats.validated + '</div></div>';
        html += '<div class="insight-stat ' + (winRate !== null && winRate >= 50 ? 'green' : 'red') + '"><div class="label">止盈/止损命中率</div><div class="value">' + winRateDisplay + '</div><div style="font-size:10px;color:var(--text3);margin-top:4px">' + outcomeStats.validated + '胜 / ' + outcomeStats.invalidated + '负；活跃与过期不计入</div></div>';
        html += '</div>';
        activeHyps.slice(0, 5).forEach(function(h) {
          var ret3d = h.followUpReturns && h.followUpReturns['3d'] !== null ? h.followUpReturns['3d'] + '%' : 'N/A';
          var ret7d = h.followUpReturns && h.followUpReturns['7d'] !== null ? h.followUpReturns['7d'] + '%' : 'N/A';
          var emoji = h.type === '趋势跟踪' ? '📈' : (h.type === '均值回归' ? '📉' : (h.type === '稀缺溢价' ? '💎' : '📊'));
          html += '<div style="padding:8px 0;border-bottom:1px solid var(--border);font-size:12px">';
          html += '<div>' + emoji + ' <strong>' + h.fundName + '</strong> <span style="color:var(--text3)">(' + h.type + ')</span></div>';
          html += '<div style="color:var(--text2);margin-top:2px">' + h.thesis + '</div>';
          html += '<div style="color:var(--text3);margin-top:2px">3日: ' + ret3d + ' · 7日: ' + ret7d + '</div>';
          html += '</div>';
        });
      }

      // Goal Tracker (from localStorage)
      html += '<div class="card-title" style="margin-top:18px">🎯 投资目标</div>';
      var goalsData = loadGoalsLocal();
      if (goalsData.goals.length === 0) {
        html += '<div style="font-size:13px;color:var(--text3);line-height:1.7">暂未设定投资目标。</div>';
        html += '<div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">';
        html += '<button class="btn" style="background:var(--state-blue-bg);color:var(--primary);border:1px solid var(--state-blue-border);font-size:11px;padding:6px 10px" onclick="addGoal(\'return\')">+ 年化收益目标</button>';
        html += '<button class="btn" style="background:var(--state-blue-bg);color:var(--primary);border:1px solid var(--state-blue-border);font-size:11px;padding:6px 10px" onclick="addGoal(\'risk\')">+ 最大回撤控制</button>';
        html += '<button class="btn" style="background:var(--state-blue-bg);color:var(--primary);border:1px solid var(--state-blue-border);font-size:11px;padding:6px 10px" onclick="addGoal(\'streak\')">+ 连续定投天数</button>';
        html += '</div>';
      } else {
        html += '<div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap">';
        html += '<button class="btn" style="background:var(--state-blue-bg);color:var(--primary);border:1px solid var(--state-blue-border);font-size:11px;padding:4px 8px" onclick="addGoal(\'return\')">+ 收益目标</button>';
        html += '<button class="btn" style="background:var(--state-blue-bg);color:var(--primary);border:1px solid var(--state-blue-border);font-size:11px;padding:4px 8px" onclick="addGoal(\'risk\')">+ 回撤控制</button>';
        html += '</div>';
        goalsData.goals.forEach(function(g, idx) {
          var progress = g.target > 0 ? Math.min(Math.round(Math.abs(g.current || 0) / Math.abs(g.target) * 100), 100) : 0;
          var pColor = progress >= 100 ? 'var(--success)' : (progress >= 50 ? 'var(--primary)' : 'var(--warn)');
          var statusEmoji = g.status === 'completed' ? '✅' : (g.status === 'abandoned' ? '❌' : '🔄');
          html += '<div style="padding:10px;background:var(--bg);border-radius:8px;margin-bottom:8px">';
          html += '<div style="display:flex;justify-content:space-between;align-items:center">';
          html += '<div>' + statusEmoji + ' <strong>' + g.title + '</strong></div>';
          html += '<span style="font-size:11px;color:#ef4444;cursor:pointer" onclick="deleteGoal(' + idx + ')">×</span>';
          html += '</div>';
          html += '<div style="font-size:12px;color:var(--text2);margin-top:4px">目标: ' + g.target + g.unit + ' · 当前: ' + (g.current || 0) + g.unit + '</div>';
          html += '<div style="background:var(--border);border-radius:4px;height:6px;margin-top:6px">';
          html += '<div style="background:' + pColor + ';border-radius:4px;height:6px;width:' + progress + '%"></div>';
          html += '</div>';
          html += '<div style="font-size:11px;color:var(--text3);margin-top:2px;text-align:right">' + progress + '%</div>';
          html += '</div>';
        });
      }

      // News & Sentiment
      html += '<div class="card-title" style="margin-top:18px">📰 新闻与情绪 <button onclick="refreshNews()" style="float:right;padding:3px 10px;font-size:11px;border:1px solid var(--border);border-radius:6px;background:white;cursor:pointer;color:var(--text2)">🔄 刷新新闻</button></div>';
      html += '<div id="news-sentiment-content"><div style="text-align:center;padding:10px;color:var(--text3)">正在加载最新新闻...</div></div>';

      // New Funds (collapsed)
      var newFunds = fundsData.funds.filter(function(f) { return ['007280','008763','539003','000369'].indexOf(f.code) >= 0; });
      if (newFunds.length > 0) {
        html += '<details style="margin-top:18px"><summary style="font-size:13px;font-weight:600;color:var(--text2);cursor:pointer;padding:6px 0">📋 最新加入基金池 <span style="font-size:11px;color:var(--text3)">(' + newFunds.length + '只)</span></summary>';
        newFunds.forEach(function(f) {
          var lim = f.dailyLimit < 10000 ? '限' + f.dailyLimit + '元' : '不限';
          html += '<div class="fund-chip"><div><strong>' + f.name + '</strong><div style="font-size:11px;color:var(--text3)">' + f.type + ' · ' + lim + '</div></div><span class="chip-code">' + f.code + '</span></div>';
        });
        html += '</details>';
      }

      // Architecture
      html += '<div class="card-title" style="margin-top:18px">系统能力</div>';
      html += '<div style="font-size:12px;color:var(--text2);line-height:2">';
      html += '📊 智能评分 · 🧪 假设引擎 · 📈 走步回测 · 🛡️ 反幻觉检查<br>';
      html += '🎯 目标规划 · 📚 技能系统 · 💾 SQLite存储 · 🤖 AI分析';
      html += '</div>';

      // External Signals (X/Twitter)
      if (externalSignalsData && externalSignalsData.tickerOpinions && externalSignalsData.tickerOpinions.length > 0) {
        // [security] HTML 转义函数，防止外部数据中的恶意代码
        function _escH(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
        html += '<div class="card-title" style="margin-top:18px">📡 外部信号（@aleabitoreddit）</div>';
