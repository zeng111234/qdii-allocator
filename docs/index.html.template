    function calcSummary() {
      var totalInv = 0, totalVal = 0, pendingInv = 0;
      var totalValPrev = 0;
      var latestDate = '', prevDate = '';
      // 找大多数基金共有的最新净值日期（而不是所有基金中最晚的）
      var dateCount = {};
      var dateLatest = {};
      portfolioData.holdings.forEach(function(h) {
        var latest = getLatestNav(h.code);
        if (latest) {
          dateCount[latest.date] = (dateCount[latest.date] || 0) + 1;
          if (!dateLatest[latest.date] || latest.date > dateLatest[latest.date]) {
            dateLatest[latest.date] = latest.date;
          }
        }
      });
      // 选出现次数最多的日期作为基准（出现次数相同则选较晚的）
      var baseDate = '', maxCount = 0;
      Object.keys(dateCount).sort().forEach(function(d) {
        if (dateCount[d] > maxCount || (dateCount[d] === maxCount && d > baseDate)) {
          maxCount = dateCount[d]; baseDate = d;
        }
      });
      latestDate = baseDate;
      // 找基准日期的前一天
      portfolioData.holdings.forEach(function(h) {
        if (prevDate) return;
        var arr = getNavArray(h.code);
        if (arr) {
          for (var i = 0; i < arr.length; i++) {
            if (arr[i].date === baseDate && i > 0) { prevDate = arr[i-1].date; return; }
          }
        }
      });
      // 计算市值和日盈亏
      portfolioData.holdings.forEach(function(h) {
        var latest = getLatestNav(h.code);
        var navNow = latest ? latest.nav : 0;
        var navPrev = 0;
        // 只有净值日期 == 基准日期的基金才算日盈亏
        if (latest && latest.date === baseDate && prevDate) {
          var arr = getNavArray(h.code);
          if (arr) {
            for (var i = 0; i < arr.length; i++) {
              if (arr[i].date === prevDate) { navPrev = arr[i].nav; break; }
            }
          }
        }
        h.buys.forEach(function(b) {
          totalInv += b.amount;
          if (b.shares && b.shares > 0 && navNow > 0) {
            totalVal += b.shares * navNow;
            totalValPrev += navPrev > 0 ? b.shares * navPrev : b.shares * navNow;
          } else if (b.nav && b.nav > 0 && navNow > 0) {
            totalVal += b.amount * (navNow / b.nav);
            totalValPrev += navPrev > 0 ? b.amount * (navPrev / b.nav) : b.amount * (navNow / b.nav);
          } else {
            totalVal += b.amount;
            totalValPrev += b.amount;
            pendingInv += b.amount;
          }
        });
      });
      var pnl = Math.round((totalVal - totalInv) * 100) / 100;
      var todayPnl = Math.round((totalVal - totalValPrev) * 100) / 100;
      var pendingHoldings = Array.isArray(portfolioData.pendingHoldings) ? portfolioData.pendingHoldings : [];
      var reconciliationPending = pendingHoldings.reduce(function(sum, holding) {
        return sum + (Number(holding.totalAmount) || 0);
      }, 0);
      var hasPrevData = false;
      portfolioData.holdings.forEach(function(h) { if (getPrevNav(h.code)) hasPrevData = true; });
      // 生成日期标签：最新净值日期 vs 前一交易日
      var pnlLabel = '日盈亏';
      if (latestDate && prevDate) {
        var today = new Date().toISOString().slice(0,10);
        var parts = latestDate.split('-');
        var shortDate = parseInt(parts[1]) + '/' + parseInt(parts[2]);
        if (latestDate === today) {
          pnlLabel = '今日盈亏';
        } else {
          pnlLabel = shortDate + '盈亏';
        }
      }
      return {
        invested: Math.round(totalInv * 100) / 100,
        pending: Math.round(Math.max(pendingInv, reconciliationPending) * 100) / 100,
        pendingCount: pendingHoldings.length,
        value: Math.round(totalVal * 100) / 100,
        pnl: pnl,
        todayPnl: todayPnl,
        hasPrevData: hasPrevData,
        pnlLabel: pnlLabel,
        latestDate: latestDate,
        count: portfolioData.holdings.length,
        recordCount: portfolioData.holdings.length + pendingHoldings.length
      };
    }

    function updateSummary() {
      var s = calcSummary();
      var cls = s.pnl >= 0 ? 'positive' : 'negative';
      var sign = s.pnl >= 0 ? '+' : '';
      var todayCls = s.todayPnl >= 0 ? 'positive' : 'negative';
      var todaySign = s.todayPnl >= 0 ? '+' : '';
      var todayStr = s.hasPrevData ? (todaySign + s.todayPnl) : '--';
      var pendingNotice = s.pending > 0
        ? '<div style="grid-column:1/-1;margin-top:8px;padding:8px 10px;background:var(--state-yellow-bg);border:1px solid var(--state-yellow-border);border-radius:8px;font-size:12px;color:var(--state-yellow-text)">⚠️ 另有 ' + s.pendingCount + ' 只/笔待核验交易，共 ' + s.pending + ' 元，未计入当前市值与盈亏；请用基金平台确认净值和份额。</div>'
        : '';
      document.getElementById('summary').innerHTML =
        '<div class="summary-item"><div class="label">已确认投入</div><div class="value">' + s.invested + '</div></div>' +
        '<div class="summary-item"><div class="label">当前市值</div><div class="value">' + s.value + '</div></div>' +
        '<div class="summary-item"><div class="label">总盈亏</div><div class="value ' + cls + '">' + sign + s.pnl + '</div></div>' +
        '<div class="summary-item"><div class="label">' + s.pnlLabel + '</div><div class="value ' + todayCls + '">' + todayStr + '</div></div>' +
        '<div class="summary-item"><div class="label">持仓记录</div><div class="value">' + s.recordCount + '条</div><div style="font-size:11px;color:var(--text3);margin-top:4px">' + s.count + '已确认 · ' + s.pendingCount + '待核验</div></div>' +
        '<div class="summary-item"><div class="label">净值日期</div><div class="value" style="font-size:12px">' + (s.latestDate || '--') + '</div></div>' + pendingNotice;

      // 渲染收益曲线图
      renderPortfolioChart();
    }

    function renderPortfolioChart() {
      if (typeof LightweightCharts === 'undefined') return;
      var holdings = portfolioData.holdings || [];
      if (holdings.length === 0) return;

      // 收集所有有净值数据的日期
      var allDates = {};
      holdings.forEach(function(h) {
        var arr = navCacheData[h.code];
        if (!arr || !Array.isArray(arr)) return;
        arr.forEach(function(n) { allDates[n.date] = true; });
      });
      var dates = Object.keys(allDates).sort();
      if (dates.length < 3) return;

      // 计算每天的组合总市值和累计投入
      var rawData = [];
      dates.forEach(function(date) {
        var totalVal = 0, totalInv = 0, hasData = false;
        holdings.forEach(function(h) {
          var arr = navCacheData[h.code];
          if (!arr || !Array.isArray(arr)) return;
          var navOnDate = null;
          for (var i = 0; i < arr.length; i++) {
            if (arr[i].date <= date) navOnDate = arr[i].nav;
            if (arr[i].date > date) break;
          }
          if (!navOnDate) return;
          hasData = true;
          h.buys.forEach(function(b) {
            if (b.date <= date) totalInv += b.amount;
            if (b.date > date) return;
            if (b.shares && b.shares > 0) {
              totalVal += b.shares * navOnDate;
            } else if (b.nav && b.nav > 0) {
              totalVal += b.amount * (navOnDate / b.nav);
            } else {
              totalVal += b.amount;
            }
          });
        });
        if (hasData && totalVal > 0) {
          rawData.push({ date: date, val: totalVal, inv: totalInv });
        }
      });

      if (rawData.length < 3) return;

      // 转换为收益率百分比：(市值 - 投入) / 投入 * 100
      var pctData = [];
      rawData.forEach(function(d) {
        if (d.inv > 0) {
          var pct = Math.round((d.val - d.inv) / d.inv * 10000) / 100;
          pctData.push({ time: d.date, value: pct });
        }
      });

      if (pctData.length < 3) return;

      var wrapper = document.getElementById('chart-wrapper');
      wrapper.style.display = 'block';
      var container = document.getElementById('portfolioChart');
      container.innerHTML = '';

      if (window._portfolioChart) { window._portfolioChart.remove(); window._portfolioChart = null; }

      var lastPct = pctData[pctData.length - 1].value;
      var isPositive = lastPct >= 0;
      var lineColor = isPositive ? '#22c55e' : '#ef4444';

      var chart = LightweightCharts.createChart(container, {
        width: container.clientWidth,
        height: 180,
        layout: {
          background: { type: 'solid', color: 'transparent' },
          textColor: '#94a3b8',
          fontSize: 11,
          attributionLogo: false
        },
        grid: {
          vertLines: { visible: false },
          horzLines: { color: 'rgba(0,0,0,0.04)' }
        },
        crosshair: {
          mode: LightweightCharts.CrosshairMode.Normal,
          vertLine: { color: 'rgba(0,0,0,0.15)', width: 1, style: 0, labelBackgroundColor: '#6366f1' },
          horzLine: { color: 'rgba(0,0,0,0.15)', width: 1, style: 0, labelBackgroundColor: '#6366f1' }
        },
        rightPriceScale: {
          borderColor: 'rgba(0,0,0,0.06)',
          scaleMargins: { top: 0.1, bottom: 0.1 }
        },
        timeScale: {
          borderColor: 'rgba(0,0,0,0.06)',
          timeVisible: false,
          secondsVisible: false,
          tickMarkFormatter: function(time) {
            // LightweightCharts time 可能是字符串 "YYYY-MM-DD" 或 Unix 秒数
            if (typeof time === 'number') {
              var d = new Date(time * 1000);
              return (d.getMonth()+1) + '/' + d.getDate();
            }
            if (typeof time === 'string' && time.length >= 10) {
              var parts = time.split('-');
              return parseInt(parts[1]) + '/' + parseInt(parts[2]);
            }
            return '';
          },
          minBarSpacing: 15
        },
        handleScroll: true,
        handleScale: true
      });

      // 面积图：盈利区域填充
      var areaSeries = chart.addAreaSeries({
        topColor: isPositive ? 'rgba(34,197,94,0.3)' : 'rgba(239,68,68,0.3)',
        bottomColor: isPositive ? 'rgba(34,197,94,0.02)' : 'rgba(239,68,68,0.02)',
        lineColor: lineColor,
        lineWidth: 2,
        crosshairMarkerBackgroundColor: lineColor,
        crosshairMarkerRadius: 4
      });
      areaSeries.setData(pctData);

      // 0% 基准线（盈亏分界）
      var zeroSeries = chart.addLineSeries({
        color: 'rgba(148,163,184,0.4)',
        lineWidth: 1,
        lineStyle: 0,
        crosshairMarkerVisible: false,
        priceLineVisible: false
      });
      zeroSeries.setData(pctData.map(function(d) { return { time: d.time, value: 0 }; }));

      chart.timeScale().fitContent();
      window.addEventListener('resize', function() {
        chart.applyOptions({ width: container.clientWidth });
      });

      window._portfolioChart = chart;

      // 图例
      var legend = document.getElementById('chart-legend');
      if (!legend) {
        legend = document.createElement('div');
        legend.id = 'chart-legend';
        legend.style.cssText = 'display:flex;gap:16px;justify-content:center;margin-top:6px;font-size:11px;color:var(--text3)';
        container.parentNode.insertBefore(legend, container.nextSibling);
      }
      legend.innerHTML = '<span><span style="display:inline-block;width:16px;height:2px;background:' + lineColor + ';vertical-align:middle;margin-right:4px"></span>收益率 ' + (lastPct >= 0 ? '+' : '') + lastPct + '%</span>' +
        '<span><span style="display:inline-block;width:16px;height:0;border-top:1px solid rgba(148,163,184,0.4);vertical-align:middle;margin-right:4px"></span>盈亏线 0%</span>';
    }

    function getHoldingDisplayName(holding, fund) {
      var savedName = holding && holding.name ? String(holding.name).trim() : '';
      if (savedName) return savedName;
      if (fund && fund.name) return fund.name;
      return holding && holding.code ? holding.code : '未知基金';
