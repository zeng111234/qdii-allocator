          html += '<div style="font-size:12px;color:var(--text2);margin-top:8px;margin-bottom:4px">其他提及:</div>';
          others.slice(0, 8).forEach(function(t) {
            html += '<div style="display:inline-block;background:#f8fafc;border:1px solid var(--border);border-radius:6px;padding:4px 10px;margin:2px 4px 2px 0;font-size:12px">';
            html += '$' + t.ticker + ' <span style="color:var(--text3)">(' + t.mentions + ')</span></div>';
          });
        }
        // Theme scores
        if (externalSignalsData.themeScores) {
          html += '<div style="font-size:12px;color:var(--text2);margin-top:10px">主题情绪:</div>';
          var themes = Object.entries(externalSignalsData.themeScores).filter(function(e) { return e[1].score > 0; });
          themes.sort(function(a, b) { return b[1].score - a[1].score; });
          themes.forEach(function(e) {
            var emoji = e[1].score > 2 ? '🟢' : '⚪';
            html += '<div style="display:inline-block;background:#f0f4ff;border:1px solid #c7d2fe;border-radius:6px;padding:4px 10px;margin:2px 4px 2px 0;font-size:12px">';
            html += emoji + ' ' + e[0] + ' +' + e[1].score + '</div>';
          });
        }
        if (externalSignalsData.cachedAt) {
          var ageH = Math.round((Date.now() - new Date(externalSignalsData.cachedAt).getTime()) / 3600000);
          html += '<div style="font-size:11px;color:var(--text3);margin-top:6px">数据更新于 ' + ageH + '小时前</div>';
        }
      }

      c.innerHTML = html;
      // Trigger async backtest, attribution, and news
      runBacktest();
      loadNewsSentiment();
    }

    // LocalStorage
    // ── Risk Metrics Engine (ported from Vibe-Trading backtest/metrics.py + correlation.py) ──

    /**
     * Async load full NAV history from GitHub Pages data file.
     * Risk calculations need historical data; build-pages.js only embeds latest NAV.
     * @param {function} callback - called with fullNavCache object
     */
    function loadFullNavCache(callback) {
      if (window._fullNavCache) {
        callback(window._fullNavCache);
        return;
      }
      // Try relative path first (works if data/nav-cache.json is published with GitHub Pages)
      // Then fallback to raw.githubusercontent.com
      var urls = [
        'data/nav-cache.json',
        'https://raw.githubusercontent.com/zeng111234/trade/main/data/nav-cache.json'
      ];
      function tryLoad(idx) {
        if (idx >= urls.length) { callback(null); return; }
        try {
          var xhr = new XMLHttpRequest();
          xhr.open('GET', urls[idx], true);
          xhr.timeout = 8000;
          xhr.onload = function() {
            if (xhr.status === 200) {
              try {
                window._fullNavCache = JSON.parse(xhr.responseText);
                callback(window._fullNavCache);
              } catch(e) { tryLoad(idx + 1); }
            } else { tryLoad(idx + 1); }
          };
          xhr.onerror = function() { tryLoad(idx + 1); };
          xhr.ontimeout = function() { tryLoad(idx + 1); };
          xhr.send();
        } catch(e) { tryLoad(idx + 1); }
      }
      tryLoad(0);
    }

    /**
     * Extract NAV time series for a holding.
     * Uses full history if available, falls back to buy records.
     * @param {Object} holding - {code, name, buys}
     * @param {Object} [fullNav] - full nav cache (optional, for historical data)
     * @returns {number[]} sorted NAV array
     */
    function getNavSeries(holding, fullNav) {
      // Try full history first (82+ entries from nav-cache.json)
      var cache = fullNav || navCacheData;
      var cached = cache[holding.code];
      if (cached && Array.isArray(cached) && cached.length >= 5) {
        var sorted = cached.slice().sort(function(a, b) {
          return a.date < b.date ? -1 : (a.date > b.date ? 1 : 0);
        });
        return sorted.map(function(x) { return x.nav; });
      }
      // Single entry (latest from build-pages.js) — fall through to buys
      // Reconstruct from buy records
      if (!holding.buys || holding.buys.length === 0) return [];
      var sortedBuys = holding.buys.filter(function(b) { return b.nav && b.nav > 0; })
        .sort(function(a, b) { return a.date < b.date ? -1 : (a.date > b.date ? 1 : 0); });
      if (sortedBuys.length === 0) return [];
      if (sortedBuys.length === 1) return [sortedBuys[0].nav];
      // Build NAV series from cumulative shares and amounts
      var series = [];
      var cumShares = 0;
      sortedBuys.forEach(function(b) {
        cumShares += (b.shares || b.amount / b.nav);
        series.push(cumShares > 0 ? b.amount / (b.shares || b.amount / b.nav) : b.nav);
      });
      // Fix: use cumulative approach properly
      series = [];
      var totalAmount = 0;
      var totalShares = 0;
      sortedBuys.forEach(function(b) {
        totalAmount += b.amount;
        totalShares += (b.shares || Math.round(b.amount / b.nav * 10000) / 10000);
        series.push(totalShares > 0 ? totalAmount / totalShares : b.nav);
      });
      return series;
    }

    /**
     * Compute daily returns from a NAV series.
     * @param {number[]} navSeries
     * @returns {number[]} returns (length = navSeries.length - 1)
     */
    function computeReturns(navSeries) {
      var returns = [];
      for (var i = 1; i < navSeries.length; i++) {
        if (navSeries[i - 1] > 0) {
          returns.push((navSeries[i] - navSeries[i - 1]) / navSeries[i - 1]);
        } else {
          returns.push(0);
        }
      }
      return returns;
    }

    /**
     * Calculate all risk metrics for a single fund (ported from Vibe-Trading metrics.py calc_metrics).
     * @param {number[]} navSeries
     * @returns {Object|null} {totalReturn, annReturn, maxDrawdown, volatility, sharpe, sortino, calmar}
     */
    function calcFundRisk(navSeries) {
      if (!navSeries || navSeries.length < 2) return null;
      var returns = computeReturns(navSeries);
      if (returns.length < 2) return null;
      var TRADING_DAYS = 252;

      // Total return
      var totalReturn = (navSeries[navSeries.length - 1] / navSeries[0]) - 1;

      // Annualized return: (1 + totalReturn)^(252/n) - 1
      var n = navSeries.length;
      var annReturn = Math.pow(1 + totalReturn, TRADING_DAYS / Math.max(n, 1)) - 1;

      // Volatility (annualized): std(returns) * sqrt(252)
      var sum = 0;
      for (var i = 0; i < returns.length; i++) sum += returns[i];
      var mean = sum / returns.length;
      var sumSq = 0;
      for (var i = 0; i < returns.length; i++) sumSq += Math.pow(returns[i] - mean, 2);
      var vol = Math.sqrt(sumSq / Math.max(returns.length - 1, 1));
      var annVol = vol * Math.sqrt(TRADING_DAYS);

      // Max drawdown
      var peak = navSeries[0];
      var maxDD = 0;
      for (var i = 0; i < navSeries.length; i++) {
        if (navSeries[i] > peak) peak = navSeries[i];
        var dd = (navSeries[i] - peak) / peak;
        if (dd < maxDD) maxDD = dd;
      }

      // Risk-free rate (annual 2% → daily)
      var dailyRf = 0.02 / TRADING_DAYS;

      // Sharpe ratio: mean(r-rf)/std(r) * sqrt(252)  (Vibe-Trading: port_ret.mean() / (vol + 1e-10) * np.sqrt(bpy))
      var excessReturns = returns.map(function(r) { return r - dailyRf; });
      var sumExcess = 0;
      for (var i = 0; i < excessReturns.length; i++) sumExcess += excessReturns[i];
      var meanExcess = sumExcess / excessReturns.length;
      var sharpe = vol > 1e-10 ? (meanExcess / vol) * Math.sqrt(TRADING_DAYS) : 0;

      // Sortino ratio: mean(r-rf)/downside_std * sqrt(252)  (Vibe-Trading: downside = port_ret[port_ret < 0])
      var downsideReturns = returns.filter(function(r) { return r < 0; });
      if (downsideReturns.length > 1) {
        var dSum = 0;
        for (var i = 0; i < downsideReturns.length; i++) dSum += downsideReturns[i];
        var dMean = dSum / downsideReturns.length;
        var dSumSq = 0;
        for (var i = 0; i < downsideReturns.length; i++) dSumSq += Math.pow(downsideReturns[i] - dMean, 2);
        var downsideStd = Math.sqrt(dSumSq / Math.max(downsideReturns.length - 1, 1));
        var sortino = downsideStd > 1e-10 ? (meanExcess / downsideStd) * Math.sqrt(TRADING_DAYS) : 0;
      } else {
        var sortino = 0;
      }

      // Calmar ratio: ann_return / abs(max_drawdown)  (Vibe-Trading: ann_ret / abs(max_dd))
      var calmar = Math.abs(maxDD) > 1e-10 ? annReturn / Math.abs(maxDD) : 0;

      return {
        totalReturn: Math.round(totalReturn * 10000) / 10000,
        annReturn: Math.round(annReturn * 10000) / 10000,
        maxDrawdown: Math.round(maxDD * 10000) / 10000,
        volatility: Math.round(annVol * 10000) / 10000,
        sharpe: Math.round(sharpe * 100) / 100,
        sortino: Math.round(sortino * 100) / 100,
        calmar: Math.round(calmar * 100) / 100
      };
    }

    /**
     * Calculate Pearson correlation matrix (ported from Vibe-Trading correlation.py).
     * @param {Object} navCache - full nav-cache.json data (82+ entries per fund)
     * @param {string[]} codes - fund codes to correlate
     * @returns {{labels: string[], matrix: number[][]}}
     */
    function calcCorrelationMatrix(navCache, codes) {
      var returnsMap = {};
      codes.forEach(function(code) {
        var cached = navCache[code];
        var navArr = [];
        if (cached && Array.isArray(cached) && cached.length >= 30) {
          var sorted = cached.slice().sort(function(a, b) {
            return a.date < b.date ? -1 : (a.date > b.date ? 1 : 0);
          });
          navArr = sorted.map(function(x) { return x.nav; });
        }
        if (navArr.length >= 30) {
          returnsMap[code] = computeReturns(navArr);
        }
      });

      // Filter to codes with enough data
      var validCodes = codes.filter(function(c) { return returnsMap[c]; });
      if (validCodes.length < 2) return { labels: validCodes, matrix: [] };

      // Align by length (use shortest to avoid NaN)
      var minLen = Math.min.apply(null, validCodes.map(function(c) { return returnsMap[c].length; }));
      // Limit to last 252 trading days (1 year)
      if (minLen > 252) minLen = 252;
      var n = validCodes.length;
      var matrix = [];
      for (var i = 0; i < n; i++) {
        matrix[i] = [];
        for (var j = 0; j < n; j++) matrix[i][j] = 1.0;
      }

      // Calculate pairwise Pearson correlation
      for (var i = 0; i < n; i++) {
        for (var j = i + 1; j < n; j++) {
          var a = returnsMap[validCodes[i]];
          var b = returnsMap[validCodes[j]];
          var len = Math.min(a.length, b.length, minLen);
          if (len < 10) { matrix[i][j] = 0; matrix[j][i] = 0; continue; }
          // Use last len elements
          var ax = a.slice(-len);
          var bx = b.slice(-len);
          var sumA = 0, sumB = 0;
          for (var k = 0; k < len; k++) { sumA += ax[k]; sumB += bx[k]; }
          var mA = sumA / len, mB = sumB / len;
          var sumAB = 0, sumA2 = 0, sumB2 = 0;
          for (var k = 0; k < len; k++) {
            var dA = ax[k] - mA, dB = bx[k] - mB;
            sumAB += dA * dB;
            sumA2 += dA * dA;
            sumB2 += dB * dB;
          }
          var corr = (sumA2 > 1e-10 && sumB2 > 1e-10) ? sumAB / Math.sqrt(sumA2 * sumB2) : 0;
          if (isNaN(corr)) corr = 0;
          matrix[i][j] = Math.round(corr * 100) / 100;
          matrix[j][i] = matrix[i][j];
        }
      }
      return { labels: validCodes, matrix: matrix };
    }

    /**
     * Map correlation value to a red-green gradient color (for heatmap).
     * @param {number} v - correlation value [-1, 1]
     * @returns {string} CSS background-color
     */
    function corrColor(v) {
      if (v === 1.0) return 'var(--primary)';
      // 红色=正相关(集中风险), 白色=无相关, 蓝色=负相关(分散效果好)
      var t = (1 - v) / 2; // v=1 → t=0(红), v=0 → t=0.5(白), v=-1 → t=1(蓝)
      var r = Math.round(239 * (1 - t) + 200 * Math.abs(0.5 - t) * 0.3);
      var g = Math.round(68 * t + 200 * Math.abs(0.5 - t) * 0.3);
      var b = Math.round(200 * t + 200 * Math.abs(0.5 - t) * 0.3);
      if (r > 240) r = 240;
      if (g > 240) g = 240;
      if (b > 240) b = 240;
      return 'rgb(' + r + ',' + g + ',' + b + ')';
    }

    /**
     * Build risk dashboard HTML from results.
     * @param {Object[]} results - [{code, name, risk}]
     * @param {string[]} codes - fund codes with valid data
     * @param {Object} [fullNav] - full nav cache for correlation
     * @returns {string} HTML string
     */
    function buildRiskDashboardHTML(results, codes, fullNav) {
      var html = '';
      var sumSharpe = 0, maxDD = 0, sumVol = 0, sumSortino = 0, sumCalmar = 0;
      var validCount = 0;
      results.forEach(function(r) {
        if (r.risk) {
          sumSharpe += r.risk.sharpe;
          sumVol += r.risk.volatility;
          sumSortino += r.risk.sortino;
          sumCalmar += r.risk.calmar;
          if (r.risk.maxDrawdown < maxDD) maxDD = r.risk.maxDrawdown;
          validCount++;
        }
      });
      var avgSharpe = validCount > 0 ? sumSharpe / validCount : 0;
      var avgVol = validCount > 0 ? sumVol / validCount : 0;
      var avgSortino = validCount > 0 ? sumSortino / validCount : 0;
      var avgCalmar = validCount > 0 ? sumCalmar / validCount : 0;

      // Portfolio health score (0-100)
      var health = 50;
      if (avgSharpe > 1) health += 20;
      else if (avgSharpe > 0.5) health += 10;
      else if (avgSharpe < -0.5) health -= 15;
      if (maxDD > -0.10) health += 15;
      else if (maxDD > -0.20) health += 5;
      else if (maxDD < -0.30) health -= 10;
      var fundCount = results.length;
      if (fundCount >= 5) health += 10;
      else if (fundCount >= 3) health += 5;
      else if (fundCount <= 1) health -= 10;
      if (health > 100) health = 100;
      if (health < 0) health = 0;

      var healthEmoji = health >= 70 ? '🟢' : (health >= 40 ? '🟡' : '🔴');
      var healthText = health >= 70 ? '组合健康' : (health >= 40 ? '需要关注' : '风险较高');
      var healthBg = health >= 70 ? '#f0fdf4' : (health >= 40 ? '#fefce8' : '#fef2f2');

      // Sort by Sharpe descending
      results.sort(function(a, b) {
        var sa = a.risk ? a.risk.sharpe : -999;
        var sb = b.risk ? b.risk.sharpe : -999;
        return sb - sa;
      });

      // Summary cards
      html += '<div class="risk-summary-grid">';
      html += '<div class="risk-summary-item"><div class="label">平均夏普比率</div>';
      html += '<div class="value">' + avgSharpe.toFixed(2) + '</div></div>';
      html += '<div class="risk-summary-item"><div class="label">最大单只回撤</div>';
      html += '<div class="value" style="color:' + (maxDD < -0.20 ? 'var(--danger)' : 'var(--warn)') + '">' + (maxDD * 100).toFixed(2) + '%</div></div>';
      html += '<div class="risk-summary-item"><div class="label">平均年化波动率</div>';
      html += '<div class="value">' + (avgVol * 100).toFixed(2) + '%</div></div>';
      html += '<div class="risk-summary-item"><div class="label">平均索提诺比率</div>';
      html += '<div class="value">' + avgSortino.toFixed(2) + '</div></div>';
      html += '</div>';

      // Health bar
      html += '<div class="risk-health-bar" style="background:' + healthBg + '">';
      html += healthEmoji + ' 组合健康度 <strong>' + health + '/100</strong> · ' + healthText;
      html += '</div>';

      // Per-fund detail table
      html += '<div class="card-title" style="margin-top:4px">基金风险明细</div>';
      html += '<table class="risk-detail-table">';
      html += '<tr><th>基金</th><th>夏普</th><th>索提诺</th><th>最大回撤</th><th>波动率</th><th>Calmar</th></tr>';
      results.forEach(function(r) {
        if (!r.risk) {
          html += '<tr><td style="text-align:left">' + r.code + '</td>';
          html += '<td colspan="5" style="color:var(--text3);text-align:center">数据不足</td></tr>';
          return;
        }
        var risk = r.risk;
        var ddColor = risk.maxDrawdown < -0.15 ? 'var(--danger)' : (risk.maxDrawdown < -0.08 ? 'var(--warn)' : 'var(--text)');
        var sharpeColor = risk.sharpe < 0 ? 'var(--danger)' : (risk.sharpe > 1 ? 'var(--success)' : 'var(--text)');
        html += '<tr>';
        html += '<td style="text-align:left;font-weight:600" title="' + r.name + '">' + r.code + '</td>';
        html += '<td style="color:' + sharpeColor + '">' + risk.sharpe.toFixed(2) + '</td>';
        html += '<td>' + risk.sortino.toFixed(2) + '</td>';
        html += '<td style="color:' + ddColor + '">' + (risk.maxDrawdown * 100).toFixed(2) + '%</td>';
        html += '<td>' + (risk.volatility * 100).toFixed(2) + '%</td>';
        html += '<td>' + risk.calmar.toFixed(2) + '</td>';
        html += '</tr>';
      });
      html += '</table>';

      // Correlation heatmap (needs fullNav with ≥30 data points per fund)
      var corrResult = null;
      var navForCorr = fullNav || navCacheData;
      if (codes.length >= 2) {
        corrResult = calcCorrelationMatrix(navForCorr, codes);
      }
      if (corrResult && corrResult.labels.length >= 2) {
        html += '<div class="card-title" style="margin-top:18px">相关性矩阵</div>';
        html += '<div class="risk-heatmap-wrap"><table class="risk-heatmap">';
        html += '<tr><th></th>';
        corrResult.labels.forEach(function(label) {
          html += '<th>' + label + '</th>';
        });
        html += '</tr>';
        var matrix = corrResult.matrix;
        for (var i = 0; i < corrResult.labels.length; i++) {
          html += '<tr><th>' + corrResult.labels[i] + '</th>';
          for (var j = 0; j < corrResult.labels.length; j++) {
            var v = matrix[i][j];
            var bg = corrColor(v);
            var textColor = (v > 0.5 || v < -0.3) ? '#fff' : 'var(--text)';
            html += '<td style="background:' + bg + ';color:' + textColor + '">' + v.toFixed(2) + '</td>';
          }
          html += '</tr>';
        }
        html += '</table></div>';
        html += '<div class="risk-note">🟢 负相关 · ⬜ 零相关 · 🔴 正相关 · 低相关性有助于分散风险</div>';
      } else if (codes.length >= 2) {
        html += '<div class="card-title" style="margin-top:18px">相关性矩阵</div>';
        html += '<div id="risk-corr-status" class="risk-note">⏳ 正在加载完整净值数据以计算相关性矩阵...</div>';
      }

      // Methodology note
      html += '<div class="card-title" style="margin-top:18px">指标说明</div>';
      html += '<div class="risk-note">';
      html += '<strong>夏普比率</strong>：每单位风险的超额收益，越高越好（>1优秀）<br>';
      html += '<strong>索提诺比率</strong>：只考虑下行风险的收益/风险比，>2为优秀<br>';
      html += '<strong>最大回撤</strong>：历史最大净值回撤幅度，越小越好<br>';
      html += '<strong>年化波动率</strong>：收益的年化标准差，衡量不确定性<br>';
      html += '<strong>Calmar比率</strong>：年化收益/最大回撤，>1为较好<br><br>';
      html += '数据来源：<a href="https://github.com/HKUDS/Vibe-Trading" target="_blank" style="color:var(--primary)">Vibe-Trading</a> 回测框架移植 · 无风险利率假设2% · 年化252个交易日';
      html += '</div>';
      return html;
    }

    /**
     * Render the full risk dashboard.
     * Loads full NAV history asynchronously for accurate calculations.
     * Called when "风险" tab is opened.
     */
    function renderRiskDashboard() {
      var c = document.getElementById('risk-content');
      if (!portfolioData.holdings || portfolioData.holdings.length === 0) {
        c.innerHTML = '<div class="empty">📭 暂无持仓，无法计算风险指标</div>';
        return;
      }

      // Phase 1: Compute with embedded data (immediate)
      var results = [];
      var codes = [];
      portfolioData.holdings.forEach(function(h) {
        var navSeries = getNavSeries(h);
        var risk = calcFundRisk(navSeries);
        if (risk) {
          results.push({ code: h.code, name: h.name, risk: risk });
          codes.push(h.code);
        } else {
          results.push({ code: h.code, name: h.name, risk: null });
        }
      });

      c.innerHTML = buildRiskDashboardHTML(results, codes, null);

      // Phase 2: Load full NAV history for accurate re-calculation
      loadFullNavCache(function(fullNav) {
        if (!fullNav) {
          var statusEl = document.getElementById('risk-corr-status');
          if (statusEl) statusEl.innerHTML = '⚠️ 无法加载完整净值数据，相关性矩阵不可用';
          return;
        }
        // Re-calculate with full data
        var results2 = [];
        var codes2 = [];
        portfolioData.holdings.forEach(function(h) {
          var navSeries = getNavSeries(h, fullNav);
          var risk = calcFundRisk(navSeries);
          if (risk) {
            results2.push({ code: h.code, name: h.name, risk: risk });
            codes2.push(h.code);
          } else {
            results2.push({ code: h.code, name: h.name, risk: null });
          }
        });
        c.innerHTML = buildRiskDashboardHTML(results2, codes2, fullNav);
      });
    }

    // ═══════════════════════════════════════════════════════════════════
    //  Factor Engine — ported from Vibe-Trading factors/base.py + registry.py
    //  Time-series operators, factor registry, cross-sectional normalization
    // ═══════════════════════════════════════════════════════════════════

    var FactorEngine = (function() {

      // ── Time-Series Operators (from Vibe-Trading base.py) ──

      /**
       * Rolling mean over last n values of arr.
       * Equivalent to: ts_mean(df, n) in Vibe-Trading base.py
       * @param {number[]} arr - time series
       * @param {number} n - window size
       * @returns {number|null}
       */
      function tsMean(arr, n) {
        if (!arr || arr.length < n || n < 1) return null;
        var sum = 0;
        for (var i = arr.length - n; i < arr.length; i++) sum += arr[i];
        return sum / n;
      }

      /**
       * Rolling sample std (ddof=1) over last n values.
       * Equivalent to: ts_std(df, n) in Vibe-Trading base.py
       */
      function tsStd(arr, n) {
        if (!arr || arr.length < n || n < 2) return null;
        var mean = tsMean(arr, n);
        var sumSq = 0;
        for (var i = arr.length - n; i < arr.length; i++) {
          var d = arr[i] - mean;
          sumSq += d * d;
        }
        return Math.sqrt(sumSq / (n - 1));
      }

      /**
       * Rolling max over last n values.
       * Equivalent to: ts_max(df, n)
       */
      function tsMax(arr, n) {
        if (!arr || arr.length < n || n < 1) return null;
        var mx = -Infinity;
        for (var i = arr.length - n; i < arr.length; i++) {
          if (arr[i] > mx) mx = arr[i];
        }
        return mx;
      }

      /**
       * Rolling min over last n values.
       * Equivalent to: ts_min(df, n)
       */
      function tsMin(arr, n) {
        if (!arr || arr.length < n || n < 1) return null;
        var mn = Infinity;
        for (var i = arr.length - n; i < arr.length; i++) {
          if (arr[i] < mn) mn = arr[i];
        }
        return mn;
      }

      /**
       * First difference at lag d: arr[t] - arr[t-d].
       * Equivalent to: delta(df, d) in Vibe-Trading base.py
       */
      function deltaFn(arr, d) {
        if (!arr || arr.length <= d || d < 1) return null;
        return arr[arr.length - 1] - arr[arr.length - 1 - d];
      }

      /**
       * Rolling rank of last value within n-window (percentile in [0,1]).
       * Equivalent to: ts_rank(df, n) in Vibe-Trading base.py
       */
      function tsRank(arr, n) {
        if (!arr || arr.length < n || n < 2) return null;
        var win = arr.slice(arr.length - n);
        var last = win[win.length - 1];
        var less = 0, eq = 0;
        for (var i = 0; i < win.length - 1; i++) {
          if (win[i] < last) less++;
          else if (win[i] === last) eq++;
        }
        var total = win.length - 1;
        if (total === 0) return 0.5;
        return (less + 0.5 * (eq + 1)) / (total + 1);
      }

      /**
       * Linear decay-weighted moving average.
       * Equivalent to: decay_linear(df, n) in Vibe-Trading base.py
       */
      function decayLinear(arr, n) {
        if (!arr || arr.length < n || n < 1) return null;
        var weightSum = 0;
        var val = 0;
        for (var k = 0; k < n; k++) {
          var w = n - k; // weights: n, n-1, ..., 1
          weightSum += w;
          val += w * arr[arr.length - n + k];
        }
        return weightSum > 0 ? val / weightSum : null;
      }

      // ── Cross-sectional helpers (from Vibe-Trading rank/normalize) ──

      /**
       * Cross-sectional percentile rank: min-max normalize scores to [0, 100].
       * Equivalent to: rank(df, axis=1, pct=True) in Vibe-Trading base.py
       * @param {Array} items - [{id, score, ...}, ...]
       * @returns {Array} same items with .normalized added
       */
      function normalize(items) {
        var valid = items.filter(function(s) {
          return s.score !== null && s.score !== undefined && !isNaN(s.score);
        });
        if (valid.length === 0) {
          items.forEach(function(s) { s.normalized = 50; });
          return items;
        }
        var mn = Infinity, mx = -Infinity;
        valid.forEach(function(s) {
          if (s.score < mn) mn = s.score;
          if (s.score > mx) mx = s.score;
        });
        var range = mx - mn;
        items.forEach(function(s) {
          if (s.score === null || s.score === undefined || isNaN(s.score)) {
            s.normalized = 50;
          } else if (range < 1e-10) {
            s.normalized = 50;
          } else {
            s.normalized = Math.round(((s.score - mn) / range) * 100 * 100) / 100;
          }
        });
        return items;
      }

      /**
       * Weighted sum of factor scores, normalized by total absolute weight.
       * @param {Object} factorScores - {factorId: normalizedScore, ...}
       * @param {Object} weights - {factorId: weight, ...}
       * @returns {number} composite score in [0, 100]
       */
      function weightedSum(factorScores, weights) {
        var totalWeight = 0;
        var totalScore = 0;
        for (var id in weights) {
          if (weights.hasOwnProperty(id) && factorScores.hasOwnProperty(id)) {
            var s = factorScores[id];
            if (s !== null && s !== undefined && !isNaN(s)) {
              totalScore += s * weights[id];
              totalWeight += Math.abs(weights[id]);
            }
          }
        }
        if (totalWeight < 1e-10) return 50;
        var raw = totalScore / totalWeight;
        return Math.round(Math.max(0, Math.min(100, raw)) * 100) / 100;
      }

      // ── Factor Registry (simplified from Vibe-Trading registry.py) ──

      var _factors = {};
      var _order = [];

      /**
       * Register a factor. Equivalent to adding to Registry._alphas.
       * @param {string} id - unique factor id
       * @param {string} name - display name (Chinese)
       * @param {string} theme - category: momentum|volatility|trend|drawdown|quality|qdii_special
       * @param {function} computeFn - (navArr, fundMeta) => rawScore|null
       * @param {number} defaultWeight - weight for composite score (negative = lower is better)
       */
      function register(id, name, theme, computeFn, defaultWeight) {
        _factors[id] = {
          id: id, name: name, theme: theme,
          compute: computeFn, weight: defaultWeight || 1.0
        };
        _order.push(id);
      }

      function list(theme) {
        var result = [];
        for (var i = 0; i < _order.length; i++) {
          var f = _factors[_order[i]];
          if (!theme || f.theme === theme) result.push(f.id);
        }
        return result;
      }

      function get(id) { return _factors[id] || null; }

      function computeOne(id, navArr, fundMeta) {
        var factor = _factors[id];
        if (!factor) return null;
        try { return factor.compute(navArr, fundMeta); }
        catch(e) { return null; }
      }

      function computeAll(navArr, fundMeta) {
        var results = {};
        for (var i = 0; i < _order.length; i++) {
          results[_order[i]] = computeOne(_order[i], navArr, fundMeta);
        }
        return results;
      }

      function getDefaultWeights() {
        var w = {};
        for (var i = 0; i < _order.length; i++) {
          w[_order[i]] = _factors[_order[i]].weight;
        }
        return w;
      }

      // Public API
      return {
        tsMean: tsMean, tsStd: tsStd, tsMax: tsMax, tsMin: tsMin,
        deltaFn: deltaFn, tsRank: tsRank, decayLinear: decayLinear,
        normalize: normalize, weightedSum: weightedSum,
        register: register, list: list, get: get,
        computeOne: computeOne, computeAll: computeAll,
        getDefaultWeights: getDefaultWeights
      };
    })();

    // ═══════════════════════════════════════════════════════════════
    //  QDII Factor Definitions
    //  Ported from Vibe-Trading factors/zoo/qlib158 + QDII-specific
    // ═══════════════════════════════════════════════════════════════

    // ── Momentum Factors ──

    /**
     * MA Deviation: composite deviation from MA5/10/20.
     * Inspired by qlib158 RSI/MA cross factors.
     * Positive = price above MAs (uptrend), negative = below (downtrend).
     */
    FactorEngine.register('momentum_ma_dev', 'MA偏离度', 'momentum', function(navArr) {
      if (!navArr || navArr.length < 25) return null;
      var latest = navArr[navArr.length - 1];
      var ma5 = FactorEngine.tsMean(navArr, 5);
      var ma10 = FactorEngine.tsMean(navArr, 10);
      var ma20 = FactorEngine.tsMean(navArr, 20);
      if (!ma5 || !ma10 || !ma20 || ma5 === 0 || ma10 === 0 || ma20 === 0) return null;
      // Weighted: short-term MA deviation matters more
      var dev = (latest / ma5 - 1) * 0.5 + (latest / ma10 - 1) * 0.3 + (latest / ma20 - 1) * 0.2;
      return Math.round(dev * 10000) / 100; // percentage
    }, 1.5);

    /**
     * 20-day return (momentum_20d).
     * Classic price momentum factor from qlib158.
     */
    FactorEngine.register('momentum_20d', '20日收益', 'momentum', function(navArr) {
      if (!navArr || navArr.length < 21) return null;
      var ret = (navArr[navArr.length - 1] / navArr[navArr.length - 21] - 1) * 100;
      return Math.round(ret * 100) / 100;
    }, 1.0);

    /**
     * 60-day return (momentum_60d).
     * Medium-term momentum.
     */
    FactorEngine.register('momentum_60d', '60日收益', 'momentum', function(navArr) {
      if (!navArr || navArr.length < 61) return null;
      var ret = (navArr[navArr.length - 1] / navArr[navArr.length - 61] - 1) * 100;
      return Math.round(ret * 100) / 100;
    }, 0.8);

    /**
     * RSI-14: Relative Strength Index.
     * Classic oscillator from qlib158/alpha101.
     */
    FactorEngine.register('momentum_rsi', 'RSI(14)', 'momentum', function(navArr) {
      if (!navArr || navArr.length < 15) return null;
      var gains = 0, losses = 0;
      for (var i = navArr.length - 14; i < navArr.length; i++) {
        var chg = navArr[i] - navArr[i - 1];
        if (chg > 0) gains += chg;
        else losses -= chg; // make positive
      }
      if (gains + losses < 1e-10) return 50;
      var rs = gains / (losses > 1e-10 ? losses : 1e-10);
      var rsi = 100 - 100 / (1 + rs);
      return Math.round(rsi * 100) / 100;
    }, 0.5);

    // ── Volatility Factors ──

    /**
     * Annualized historical volatility (20-day).
     * From Vibe-Trading metrics.py annualized_volatility.
     * Raw value: annualized vol %. Lower = less risky.
     */
    FactorEngine.register('volatility_hist', '历史波动率', 'volatility', function(navArr) {
      if (!navArr || navArr.length < 25) return null;
      var returns = [];
      for (var i = navArr.length - 21; i < navArr.length; i++) {
        if (navArr[i - 1] > 0) returns.push(navArr[i] / navArr[i - 1] - 1);
      }
      if (returns.length < 10) return null;
      var std = FactorEngine.tsStd(returns, returns.length);
      if (std === null) return null;
      // Annualize: std * sqrt(252)
      var annVol = std * Math.sqrt(252) * 100;
      return Math.round(annVol * 100) / 100;
    }, -1.0); // negative weight: lower vol → higher score

    /**
     * Downside deviation (20-day).
     * From Vibe-Trading metrics.py sortino_ratio computation.
     * Only counts negative returns.
     */
    FactorEngine.register('volatility_down', '下行波动率', 'volatility', function(navArr) {
      if (!navArr || navArr.length < 25) return null;
      var negReturns = [];
      for (var i = navArr.length - 21; i < navArr.length; i++) {
        var r = navArr[i] / navArr[i - 1] - 1;
        if (r < 0) negReturns.push(r);
        else negReturns.push(0);
      }
      if (negReturns.length < 5) return null;
      var sumSq = 0;
      var mean = 0;
      for (var j = 0; j < negReturns.length; j++) mean += negReturns[j];
      mean /= negReturns.length;
      for (var j = 0; j < negReturns.length; j++) {
        var d = negReturns[j] - mean;
        sumSq += d * d;
      }
      var downStd = Math.sqrt(sumSq / (negReturns.length - 1));
      return Math.round(downStd * Math.sqrt(252) * 100 * 100) / 100;
    }, -0.8);

    // ── Trend Factors ──

    /**
     * MA Alignment: multi-MA bullish/bearish alignment.
     * Inspired by qlib158 trend strength factors.
     * Score: +3 (strong bull) to -3 (strong bear).
     */
    FactorEngine.register('trend_alignment', '均线排列', 'trend', function(navArr) {
      if (!navArr || navArr.length < 65) return null;
      var ma5 = FactorEngine.tsMean(navArr, 5);
      var ma10 = FactorEngine.tsMean(navArr, 10);
      var ma20 = FactorEngine.tsMean(navArr, 20);
      var ma60 = FactorEngine.tsMean(navArr, 60);
      if (!ma5 || !ma10 || !ma20 || !ma60) return null;
      // Count bullish pairs: MA5 > MA10 > MA20 > MA60
      var score = 0;
      if (ma5 > ma10) score++; else score--;
      if (ma10 > ma20) score++; else score--;
      if (ma20 > ma60) score++; else score--;
      // Also check price vs MA20
      var latest = navArr[navArr.length - 1];
      if (latest > ma20) score += 0.5; else score -= 0.5;
      return Math.round(score * 100) / 100; // range: [-3.5, +3.5]
    }, 1.5);

    /**
     * Price position in 60-day range.
     * (current - 60d_low) / (60d_high - 60d_low)
     * 1.0 = at 60d high, 0.0 = at 60d low.
     */
    FactorEngine.register('trend_range_pos', '区间位置', 'trend', function(navArr) {
      if (!navArr || navArr.length < 60) return null;
      var high = FactorEngine.tsMax(navArr, 60);
      var low = FactorEngine.tsMin(navArr, 60);
      var latest = navArr[navArr.length - 1];
      var range = high - low;
      if (range < 1e-10) return 50; // flat
      return Math.round(((latest - low) / range) * 100 * 100) / 100;
    }, 0.8);

    // ── Drawdown Factors ──

    /**
     * Current drawdown from all-time peak.
     * From Vibe-Trading metrics.py max_drawdown.
     * Raw: percentage (0 to -X%). Less negative = better.
     */
    FactorEngine.register('drawdown_depth', '回撤深度', 'drawdown', function(navArr) {
      if (!navArr || navArr.length < 10) return null;
      var peak = -Infinity;
      for (var i = 0; i < navArr.length; i++) {
        if (navArr[i] > peak) peak = navArr[i];
      }
      if (peak <= 0) return null;
      var currentDD = (navArr[navArr.length - 1] - peak) / peak * 100;
      return Math.round(currentDD * 100) / 100; // negative number
    }, 1.2); // higher (less negative) = better

    /**
     * Drawdown recovery speed.
     * Measures how quickly fund recovers: days since last trough vs peak proximity.
     * Score 0-100: 100 = fully recovered, 0 = deep in drawdown.
     */
    FactorEngine.register('drawdown_recovery', '回撤恢复', 'drawdown', function(navArr) {
      if (!navArr || navArr.length < 20) return null;
      // Find the trough in last 60 days
      var lookback = Math.min(60, navArr.length);
      var peak = -Infinity, trough = Infinity, troughIdx = 0;
      for (var i = navArr.length - lookback; i < navArr.length; i++) {
        if (navArr[i] > peak) peak = navArr[i];
      }
      // Find trough after the peak
      var peakIdx = 0;
      for (var i = 0; i < navArr.length; i++) {
        if (navArr[i] === peak) peakIdx = i;
      }
      trough = peak;
      for (var i = peakIdx; i < navArr.length; i++) {
        if (navArr[i] < trough) { trough = navArr[i]; troughIdx = i; }
      }
      if (peak <= 0 || peak === trough) return 100; // no drawdown
      // Recovery ratio: how much of the drawdown has been recovered
      var currentNAV = navArr[navArr.length - 1];
      var recoveryPct = (currentNAV - trough) / (peak - trough) * 100;
      return Math.round(Math.max(0, Math.min(100, recoveryPct)) * 100) / 100;
    }, 0.8);

    // ── Quality Factors ──

    /**
     * Sharpe ratio (full period).
     * From Vibe-Trading metrics.py sharpe_ratio.
     */
    FactorEngine.register('quality_sharpe', '夏普比率', 'quality', function(navArr) {
      if (!navArr || navArr.length < 30) return null;
      var returns = [];
      for (var i = 1; i < navArr.length; i++) {
        if (navArr[i - 1] > 0) returns.push(navArr[i] / navArr[i - 1] - 1);
      }
      if (returns.length < 20) return null;
      var sum = 0;
      for (var j = 0; j < returns.length; j++) sum += returns[j];
      var mean = sum / returns.length;
      var sumSq = 0;
      for (var j = 0; j < returns.length; j++) {
        var d = returns[j] - mean;
        sumSq += d * d;
      }
      var std = Math.sqrt(sumSq / (returns.length - 1));
      if (std < 1e-10) return 0;
      // Risk-free rate = 2% annual → daily ≈ 0.02/252
      var rfDaily = 0.02 / 252;
      var sharpe = (mean - rfDaily) / std * Math.sqrt(252);
      return Math.round(sharpe * 100) / 100;
    }, 2.0);

    /**
     * Decay-linear weighted return: recent returns weighted more.
     * From Vibe-Trading base.py decay_linear.
     */
    FactorEngine.register('quality_decay_ret', '近期加权收益', 'quality', function(navArr) {
      if (!navArr || navArr.length < 21) return null;
      var returns = [];
      for (var i = navArr.length - 20; i < navArr.length; i++) {
        if (navArr[i - 1] > 0) returns.push((navArr[i] / navArr[i - 1] - 1) * 100);
        else returns.push(0);
      }
      var decayed = FactorEngine.decayLinear(returns, 20);
      if (decayed === null) return null;
      return Math.round(decayed * 100) / 100;
    }, 0.6);

    // ── QDII-Specific Factors ──

    /**
     * Scarcity: daily purchase limit.
     * QDII-exclusive factor. Lower limit = more scarce = higher score.
     * Score: 100 (limit ≤ 10) to 0 (limit ≥ 10000 or unlimited).
     */
    FactorEngine.register('scarce_limit', '限购稀缺度', 'qdii_special', function(navArr, fundMeta) {
      if (!fundMeta) return null;
      var limit = fundMeta.dailyLimit;
      if (limit === undefined || limit === null) return 50;
      if (limit <= 0) return 10; // suspended / no limit info
      if (limit >= 100000) return 0; // effectively unlimited
      if (limit <= 10) return 100;
      if (limit <= 50) return 85;
      if (limit <= 100) return 70;
      if (limit <= 300) return 55;
      if (limit <= 500) return 40;
      if (limit <= 1000) return 30;
      if (limit <= 5000) return 15;
      return 5;
    }, 1.0);

    /**
     * Fee penalty: management fee + custody fee.
     * QDII-exclusive. Lower total fee = higher score.
     * Score based on total annual fee rate.
     */
    FactorEngine.register('fee_penalty', '费率评估', 'qdii_special', function(navArr, fundMeta) {
      if (!fundMeta) return null;
      var fee = (fundMeta.feeRate || 0) + (fundMeta.custodyFee || 0);
      // Total fee range: typically 0.75% to 2.0%
      // Lower fee → higher score
      if (fee <= 0) return 80; // no data, slightly positive
      if (fee <= 0.75) return 95;
      if (fee <= 1.0) return 80;
      if (fee <= 1.2) return 65;
      if (fee <= 1.5) return 45;
      if (fee <= 1.8) return 25;
      return 10;
    }, -0.8); // negative: lower fee → higher raw score, but we want high=good

    // ═══════════════════════════════════════════════════════════════
    //  Ranking State & Render
    // ═══════════════════════════════════════════════════════════════

    var _rankingState = {
      sortBy: 'composite',  // composite | momentum | volatility | quality
      results: null,        // cached results
      fullNav: null         // cached full nav data
    };

    /**
     * Get all factor ids by theme.
     */
    function getFactorsByTheme(theme) {
      return FactorEngine.list(theme);
    }

    /**
     * Score badge CSS class based on composite score.
     */
    function scoreBadgeClass(score) {
      if (score >= 70) return 'excellent';
      if (score >= 55) return 'good';
      if (score >= 40) return 'medium';
      return 'poor';
    }

    /**
     * Factor bar color based on normalized score (0-100).
     */
    function factorBarColor(score) {
      if (score >= 70) return 'var(--success)';
      if (score >= 50) return 'var(--primary)';
      if (score >= 30) return 'var(--warn)';
      return 'var(--danger)';
    }

    /**
     * Compute rankings for all active funds.
     * @param {Object} fullNav - full nav-cache.json data
     * @returns {Array} [{code, name, type, composite, factorScores, rawScores}, ...]
     */
    function computeRankings(fullNav) {
      var activeFunds = fundsData.funds.filter(function(f) {
        return f.status === 'active';
      });

      // Phase 1: Compute raw factor scores for each fund
      var fundResults = [];
      activeFunds.forEach(function(fund) {
        var navArr = null;
        var cached = fullNav ? fullNav[fund.code] : (navCacheData[fund.code] || null);
        if (cached && Array.isArray(cached) && cached.length >= 30) {
          var sorted = cached.slice().sort(function(a, b) {
            return a.date < b.date ? -1 : (a.date > b.date ? 1 : 0);
          });
          navArr = sorted.map(function(x) { return x.nav; });
        } else if (cached && !Array.isArray(cached) && cached.nav) {
          // Single entry — not enough for factor computation
          navArr = null;
        }

        if (!navArr || navArr.length < 30) {
          fundResults.push({
            code: fund.code, name: fund.name, type: fund.type,
            rawScores: {}, composite: null, insufficient: true
          });
          return;
        }

        var rawScores = FactorEngine.computeAll(navArr, fund);
        fundResults.push({
          code: fund.code, name: fund.name, type: fund.type,
          rawScores: rawScores, composite: null, insufficient: false
        });
      });

      // Phase 2: Cross-sectional normalization per factor
      var factorIds = FactorEngine.list();
      var normalizedScores = {}; // {factorId: [{idx, score}, ...]}

      factorIds.forEach(function(fid) {
        var items = [];
        fundResults.forEach(function(r, idx) {
          if (!r.insufficient && r.rawScores[fid] !== null && r.rawScores[fid] !== undefined) {
            items.push({ idx: idx, score: r.rawScores[fid] });
          }
        });
        FactorEngine.normalize(items);
        normalizedScores[fid] = items;
      });

      // Phase 3: Assign normalized scores back
      factorIds.forEach(function(fid) {
        normalizedScores[fid].forEach(function(item) {
          if (!fundResults[item.idx].factorScores) fundResults[item.idx].factorScores = {};
          fundResults[item.idx].factorScores[fid] = item.normalized;
        });
      });

      // Phase 4: Compute composite scores
      var weights = FactorEngine.getDefaultWeights();
      fundResults.forEach(function(r) {
        if (r.insufficient || !r.factorScores) {
          r.composite = null;
        } else {
          r.composite = FactorEngine.weightedSum(r.factorScores, weights);
        }
      });

      // Phase 5: Sort by composite (descending), nulls at bottom
      fundResults.sort(function(a, b) {
        if (a.composite === null && b.composite === null) return 0;
        if (a.composite === null) return 1;
        if (b.composite === null) return -1;
        return b.composite - a.composite;
      });

      return fundResults;
    }

    /**
     * Build the ranking HTML for display.
     * @param {Array} results - sorted fund results
     * @returns {string} HTML string
     */
    function buildRankingHTML(results) {
      var html = '';
      var validResults = results.filter(function(r) { return r.composite !== null; });
      var avgScore = 0, maxScore = 0, minScore = 100;
      validResults.forEach(function(r) {
        avgScore += r.composite;
        if (r.composite > maxScore) maxScore = r.composite;
        if (r.composite < minScore) minScore = r.composite;
      });
      avgScore = validResults.length > 0 ? Math.round(avgScore / validResults.length * 100) / 100 : 0;

      // Summary cards
      html += '<div class="ranking-summary">';
      html += '<div class="ranking-summary-item"><div class="label">评分基金数</div>';
      html += '<div class="value">' + validResults.length + '/' + results.length + '</div></div>';
      html += '<div class="ranking-summary-item"><div class="label">平均综合评分</div>';
      html += '<div class="value">' + avgScore.toFixed(1) + '</div></div>';
      html += '<div class="ranking-summary-item"><div class="label">最高/最低</div>';
      html += '<div class="value">' + (validResults.length > 0 ? maxScore.toFixed(1) + '/' + minScore.toFixed(1) : '--') + '</div></div>';
      html += '</div>';

      // Sorting controls
      html += '<div class="ranking-controls">';
      html += '<span style="font-size:12px;color:var(--text2);font-weight:500">排序：</span>';
      var sortOptions = [
        { id: 'composite', label: '综合评分' },
        { id: 'momentum', label: '动量' },
        { id: 'volatility', label: '波动率' },
        { id: 'trend', label: '趋势' },
        { id: 'drawdown', label: '回撤' },
        { id: 'quality', label: '质量' },
        { id: 'qdii_special', label: 'QDII特色' }
      ];
      sortOptions.forEach(function(opt) {
        var isActive = _rankingState.sortBy === opt.id;
        html += '<span class="sort-btn' + (isActive ? ' active' : '') + '" ';
        html += 'onclick="sortByTheme(\'' + opt.id + '\')">' + opt.label + '</span>';
      });
      html += '</div>';

      // Sort results by selected theme if not composite
      var displayResults = results.slice(); // copy
      if (_rankingState.sortBy !== 'composite') {
        var theme = _rankingState.sortBy;
        displayResults.sort(function(a, b) {
          var sa = getThemeScore(a, theme);
          var sb = getThemeScore(b, theme);
          if (sa === null && sb === null) return 0;
          if (sa === null) return 1;
          if (sb === null) return -1;
          return sb - sa;
        });
      }

      // Fund ranking rows
      displayResults.forEach(function(r, rankIdx) {
        var rankNum = rankIdx + 1;
        var rankClass = rankNum <= 3 ? 'top' + rankNum : 'normal';
        var score = r.composite;
        var badgeClass = score !== null ? scoreBadgeClass(score) : 'medium';

        html += '<div class="ranking-row" onclick="toggleFactorBars(' + rankIdx + ')">';
        html += '<div class="ranking-header">';
        html += '<div class="ranking-left">';
        html += '<span class="ranking-rank ' + rankClass + '">' + rankNum + '</span>';
        html += '<span class="ranking-name" title="' + r.name + '">' + r.name + '</span>';
        html += '<span class="ranking-code">' + r.code + '</span>';
        if (r.type) html += '<span class="ranking-type">' + r.type + '</span>';
        html += '</div>';

        if (score !== null) {
          html += '<div class="score-badge ' + badgeClass + '">';
          html += '<span>' + score.toFixed(1) + '</span>';
          html += '<span class="score-label">综合</span>';
          html += '</div>';
        } else {
          html += '<div class="score-badge medium"><span>--</span><span class="score-label">暂无</span></div>';
        }
        html += '</div>';

        // Factor detail bars (hidden by default)
        html += '<div class="factor-bars" id="factor-bars-' + rankIdx + '">';
        if (r.factorScores) {
          var factorIds = FactorEngine.list();
          factorIds.forEach(function(fid) {
            var factor = FactorEngine.get(fid);
            var val = r.factorScores[fid];
            if (val === undefined || val === null) val = 50;
            var barWidth = Math.max(2, Math.min(100, val));
            var barColor = factorBarColor(val);
            // Show raw score too
            var rawVal = r.rawScores[fid];
            var rawStr = (rawVal !== null && rawVal !== undefined) ? rawVal.toFixed(2) : '--';
            html += '<div class="factor-bar-row">';
            html += '<span class="factor-bar-label">' + factor.name + '</span>';
            html += '<div class="factor-bar-track"><div class="factor-bar-fill" style="width:' + barWidth + '%;background:' + barColor + '"></div></div>';
            html += '<span class="factor-bar-value" style="color:' + barColor + '">' + val.toFixed(0) + '</span>';
            html += '</div>';
          });
        } else {
          html += '<div style="color:var(--text3);font-size:12px;text-align:center;padding:8px">数据不足，无法计算因子</div>';
        }
        html += '</div>';

        html += '</div>'; // .ranking-row
      });

      // Factor weight legend
      html += '<div class="factor-weight-note">';
      html += '<strong>评分模型</strong>（移植自 <a href="https://github.com/HKUDS/Vibe-Trading" target="_blank" style="color:var(--primary)">Vibe-Trading</a> 因子框架）<br>';
      html += '11个因子 · 6大类：动量(MA偏离/20日/60日/RSI) · 波动率(历史/下行) · 趋势(均线排列/区间位置) · 回撤(深度/恢复) · 质量(夏普/加权收益) · QDII特色(限购/费率)<br>';
      html += '数据来源：基金净值序列 · 交叉截面归一化 · 权重加权合成 · 满分100';
      html += '</div>';

      return html;
    }

    /**
     * Get theme average score for a fund result.
     */
    function getThemeScore(result, theme) {
      if (!result.factorScores) return null;
      var factors = FactorEngine.list(theme);
      if (factors.length === 0) return null;
      var sum = 0, cnt = 0;
      factors.forEach(function(fid) {
        var s = result.factorScores[fid];
        if (s !== null && s !== undefined) { sum += s; cnt++; }
      });
      return cnt > 0 ? Math.round(sum / cnt * 100) / 100 : null;
    }

    /**
     * Toggle factor detail bars for a ranking row.
     * Called by onclick on ranking row.
     */
    function toggleFactorBars(idx) {
      var el = document.getElementById('factor-bars-' + idx);
      if (el) {
        el.style.display = el.style.display === 'none' ? 'block' : 'none';
      }
    }

