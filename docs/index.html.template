      var items = newsData.items;
      var sentiment = newsData.sentiment || { overall: 0, positive: 0, negative: 0, neutral: 0, byTheme: {} };

      var moodEmoji = sentiment.overall > 10 ? '🟢' : (sentiment.overall < -10 ? '🔴' : '⚪');
      var moodText = sentiment.overall > 10 ? '偏乐观' : (sentiment.overall < -10 ? '偏悲观' : '中性');

      var html2 = '<div style="display:flex;gap:10px;margin-bottom:10px">';
      html2 += '<div style="flex:1;text-align:center;padding:8px;background:var(--bg);border-radius:8px"><div style="font-size:11px;color:var(--text3)">市场情绪</div><div style="font-size:16px;font-weight:700">' + moodEmoji + ' ' + moodText + '</div></div>';
      html2 += '<div style="flex:1;text-align:center;padding:8px;background:var(--bg);border-radius:8px"><div style="font-size:11px;color:var(--text3)">新闻数</div><div style="font-size:16px;font-weight:700">' + items.length + '条</div></div>';
      html2 += '</div>';

      // 情绪分析 - 一句话总结
      var themes = sentiment.byTheme || {};
      var themeNames = { nasdaq: '纳指/科技', sp500: '美股大盘', hongkong: '港股/亚太', oil: '能源/商品' };
      var hasThemeData = Object.keys(themes).some(function(t) { return themes[t].pos > 0 || themes[t].neg > 0; });
      if (hasThemeData) {
        var bullishThemes = [];
        var bearishThemes = [];
        Object.keys(themes).forEach(function(t) {
          var th = themes[t];
          if (th.pos > th.neg) bullishThemes.push(themeNames[t] || t);
          else if (th.neg > th.pos) bearishThemes.push(themeNames[t] || t);
        });
        if (bullishThemes.length > 0 || bearishThemes.length > 0) {
