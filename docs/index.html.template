          }
          if (dailyBriefData.marketNews) {
            marketContext.marketNews = dailyBriefData.marketNews;
          }
        }
        
        // 模拟辩论过程（实际应用中应该调用后端 API）
        await simulateDebate(fundData, portfolioData, marketContext);
        
      } catch (err) {
        debateState.error = '辩论失败: ' + err.message;
        console.error('[Debate] Error:', err);
      } finally {
        debateState.isRunning = false;
        renderDebate();
      }
    }
    
    async function simulateDebate(fundData, portfolioData, marketContext) {
      await new Promise(function(resolve) { setTimeout(resolve, 800); });
      
      // 用真实数据计算 Bull/Bear 观点
      var holdings = portfolioData.holdings || [];
      var totalInvested = 0;
      holdings.forEach(function(h) {
        // 从 buys 数组计算总投入
        var inv = (h.buys || []).reduce(function(s, b) { return s + (b.amount || 0); }, 0);
        h._invested = inv;
        totalInvested += inv;
      });
      
      // 从评分数据中获取真实指标
      var rankedFunds = [];
      if (typeof rankedData !== 'undefined' && rankedData) {
        rankedFunds = rankedData;
      }
      
      // Bull 分析：基于真实评分和趋势
      var bullAnalysis = fundData.slice(0, 8).map(function(fund) {
        var ranked = rankedFunds.find(function(r) { return r.code === fund.code; });
        var score = ranked ? ranked.score : 5;
        var bullScore = Math.min(10, Math.max(1, Math.round(score / 10)));
        var reasons = [];
        if (ranked && ranked.indicators) {
          var ind = ranked.indicators;
          if (ind.sharpeRatio > 1) reasons.push('夏普比率 ' + ind.sharpeRatio + '，风险调整收益优秀');
          if (ind.annualizedReturn > 15) reasons.push('年化收益 ' + ind.annualizedReturn + '%，长期表现强劲');
          if (ind.maxDrawdown > -15) reasons.push('最大回撤仅 ' + ind.maxDrawdown + '%，风险可控');
        }
        var hold = holdings.find(function(h) { return h.code === fund.code; });
        if (hold && hold._invested > 0) reasons.push('已持仓 ' + hold._invested + '元，成本已建立');
        if (reasons.length === 0) reasons.push('综合评分 ' + (score || 'N/A') + '，基本面尚可');
        return { fundCode: fund.code, fundName: fund.name, bullScore: bullScore, reasons: reasons.slice(0, 3), catalyst: null };
      });
      debateState.bull观点 = { fundAnalysis: bullAnalysis, summary: '基于评分系统的看多分析' };
      
      // Bear 分析：基于真实风险指标
      var bearAnalysis = fundData.slice(0, 8).map(function(fund) {
        var ranked = rankedFunds.find(function(r) { return r.code === fund.code; });
        var riskScore = 5;
        var risks = [];
        if (ranked && ranked.indicators) {
          var ind = ranked.indicators;
          if (ind.maxDrawdown < -25) { riskScore = 8; risks.push('历史最大回撤 ' + ind.maxDrawdown + '%，深度下跌风险高'); }
          else if (ind.maxDrawdown < -15) { riskScore = 6; risks.push('最大回撤 ' + ind.maxDrawdown + '%，中等风险'); }
          if (ind.volatility > 30) risks.push('年化波动率 ' + ind.volatility + '%，价格波动大');
          if (ind.sharpeRatio < 0.5) risks.push('夏普比率仅 ' + ind.sharpeRatio + '，风险收益比差');
        }
        var hold = holdings.find(function(h) { return h.code === fund.code; });
        if (hold && hold._invested > 0 && totalInvested > 0) {
          var weight = hold._invested / totalInvested * 100;
          if (weight > 15) risks.push('持仓占比 ' + weight.toFixed(1) + '%，过度集中');
        }
        if (risks.length === 0) risks.push('QDII额度限制，流动性风险');
        return { fundCode: fund.code, fundName: fund.name, riskScore: riskScore, risks: risks.slice(0, 3), warningSignal: null };
      });
      debateState.bear观点 = { fundAnalysis: bearAnalysis, summary: '基于风险指标的看空分析' };
      
      // 风险评估：基于真实持仓集中度
      var typeWeights = {};
      holdings.forEach(function(h) {
        var fund = fundsData.funds.find(function(f) { return f.code === h.code; });
        var type = fund ? (fund.type || '未知') : '未知';
        typeWeights[type] = (typeWeights[type] || 0) + (h._invested || 0);
      });
      var maxType = Object.keys(typeWeights).sort(function(a, b) { return typeWeights[b] - typeWeights[a]; })[0];
      var maxWeight = totalInvested > 0 ? (typeWeights[maxType] || 0) / totalInvested * 100 : 0;
      var riskLevel = maxWeight > 60 ? '高' : (maxWeight > 40 ? '中' : '低');
      var mainRisks = [];
      if (maxWeight > 50) mainRisks.push(maxType + ' 占比 ' + maxWeight.toFixed(1) + '%，集中度过高');
      mainRisks.push('QDII 基金存在每日限购，流动性受限');
      if (holdings.length < 5) mainRisks.push('持仓基金数仅 ' + holdings.length + ' 只，分散度不足');
      debateState.riskAssessment = { overallRiskLevel: riskLevel, mainRisks: mainRisks, recommendations: [] };
      
      // 最终决策：综合 Bull/Bear 给出结构化建议
      var topBull = bullAnalysis.slice().sort(function(a, b) { return b.bullScore - a.bullScore; }).slice(0, 3);
      var topBear = bearAnalysis.slice().sort(function(a, b) { return b.riskScore - a.riskScore; }).slice(0, 2);
      
      // 共识点：Bull 和 Bear 都认同的
      var consensus = [];
      if (riskLevel === '低') consensus.push('组合整体风险可控');
      if (holdings.length >= 5) consensus.push('持仓数量合理，基本分散');
      consensus.push('QDII 基金存在限购约束');
      
      // 分歧点：Bull 和 Bear 有争议的
      var disputes = [];
      if (maxWeight > 40) disputes.push(maxType + ' 集中度：Bull 认为是优势（聚焦优质赛道），Bear 认为是风险（过度集中）');
      disputes.push('当前市场估值：Bull 看好长期增长，Bear 担忧短期回调');
      
      // 激进/保守/中立 三方评估
      var aggressiveView = '积极加仓，关注评分高且回撤合理的基金。注意分散持仓避免过度集中。';
      var conservativeView = '控制仓位，避免追高近期涨幅过大的基金。关注估值和趋势信号。';
      var neutralView = '维持现有配置，定投为主。根据评分和估值择机小幅调仓。';
      
      var decision = '【多智能体辩论结果】\n\n';
      decision += '━━━ 📈 看多阵营 ━━━\n';
      topBull.forEach(function(f) { decision += '• ' + f.fundName + '（' + f.bullScore + '/10）— ' + f.reasons[0] + '\n'; });
      decision += '\n━━━ 📉 看空阵营 ━━━\n';
      topBear.forEach(function(f) { decision += '• ' + f.fundName + '（风险 ' + f.riskScore + '/10）— ' + f.risks[0] + '\n'; });
      decision += '\n━━━ 🤝 共识点 ━━━\n';
      consensus.forEach(function(c) { decision += '✓ ' + c + '\n'; });
      decision += '\n━━━ ⚔️ 分歧点 ━━━\n';
      disputes.forEach(function(d) { decision += '⚡ ' + d + '\n'; });
      decision += '\n━━━ 🛡️ 三方风险评估 ━━━\n';
      decision += '🔴 激进派：' + aggressiveView + '\n';
      decision += '🔵 保守派：' + conservativeView + '\n';
      decision += '⚪ 中立派：' + neutralView + '\n';
      decision += '\n━━━ 💡 最终建议 ━━━\n';
      if (riskLevel === '高') {
        decision += '组合集中度过高，建议减少 ' + maxType + ' 配置，增加其他类型基金分散风险。';
      } else {
        decision += '组合结构合理，保持定投节奏。重点关注评分高、回撤小、估值合理的基金。';
      }
      
      debateState.finalDecision = { finalDecision: decision };
    }
    
