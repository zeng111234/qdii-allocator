# ===========================
# QDII 每日分配系统 - 配置模板
# ===========================
# 复制此文件为 .env，然后填入你的真实配置
# cp .env.example .env

# ---------- 邮件服务 (SMTP) ----------
# QQ邮箱示例配置:
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
# 163邮箱示例配置:
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_authorization_code
MAIL_TO=recipient@example.com

# ---------- LLM 配置 (可选) ----------
# DeepSeek 官方 API / 任何 OpenAI 兼容 API
# 官方 DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions, LLM_MODEL=deepseek-chat
# 如果不配置，AI功能会自动降级
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat

# ---------- Telegram 通知 (可选) ----------
# 在 Telegram 搜索 @BotFather 创建机器人获取 Token
# 获取步骤:
#   1. 打开 Telegram 搜索 @BotFather
#   2. 发送 /newbot
#   3. 按提示设置名称和用户名
#   4. 获取 Token 填入下方
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ---------- Web UI 安全 (可选) ----------
# 配置后 API 写操作(添加/删除)需要 Bearer Token 验证
# GET 请求(查看持仓/数据列表)不需要 Token
# 不配置则自动生成临时 Token（仅当前会话有效）
WEB_AUTH_TOKEN=

# ---------- Firebase 私有账本 ----------
# Web 配置可公开，但写权限必须由 Google Auth + firebase.database.rules.json 控制。
FIREBASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=your_firebase_app_id

# 下面两项仅供 GitHub Actions 服务端读取私有账本，绝不能注入网页或 localStorage。
FIREBASE_UID=your_google_auth_uid
FIREBASE_KEY=your_server_side_database_secret
