# ===========================
# QDII 每日分配系统 - 配置模板
# ===========================
# 复制此文件为 .env，然后填入你的真实配置
# cp .env.example .env

# ---------- 邮件服务 (SMTP) ----------
# QQ邮箱示例配置:
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
# 163邮箱示例配置:
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_authorization_code
MAIL_TO=recipient@example.com

# ---------- LLM 配置 (可选) ----------
# mimo-v2.5-pro / DeepSeek / 任何 OpenAI 兼容 API
# 如果不配置，AI功能会自动降级
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
LLM_MODEL=mimo-v2.5-pro

# ---------- Telegram 通知 (可选) ----------
# 在 Telegram 搜索 @BotFather 创建机器人获取 Token
# 获取步骤:
#   1. 打开 Telegram 搜索 @BotFather
#   2. 发送 /newbot
#   3. 按提示设置名称和用户名
#   4. 获取 Token 填入下方
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ---------- Web UI 安全 (可选) ----------
# 配置后 API 写操作(添加/删除)需要 Bearer Token 验证
# GET 请求(查看持仓/数据列表)不需要 Token
# 不配置则自动生成临时 Token（仅当前会话有效）
WEB_AUTH_TOKEN=
